---
/**
 * DocLayout — the shared shell for every long-form document.
 *
 * Gives each page, for free: a terminal-style path kicker, an eyebrow + title
 * + lede head, a sticky scroll-spy table of contents (desktop) with a mobile
 * disclosure fallback, a floating white "document sheet" on a textured field,
 * an optional plain-language notice, a prev/next pager (derived from DOC_ORDER
 * so it can't drift), a back-to-top button, and scroll reveals.
 *
 * Prose is authored in the page as <section class="doc-section" id="…"> blocks;
 * the `toc` prop lists those ids/labels. Styles live in the global doc.css so
 * they reach the slotted content (a scoped block here could not).
 *
 * Scroll-spy note: the active TOC entry is computed deterministically from each
 * section's live position on every scroll/resize tick (NOT via an
 * IntersectionObserver, whose "what's in the band" proxy misfires on clicks and
 * window resizes). A click sets the highlight + smooth-scrolls + holds a short
 * lock so the highlight can't flicker mid-animation; manual scrolling breaks
 * the lock instantly.
 */
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/Container.astro";
import "../styles/doc.css";

interface TocItem {
  id: string;
  label: string;
}
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  lede?: string;
  toc?: TocItem[];
  updated?: string;
  tag?: string;
  notice?: string;
}

const { title, description, eyebrow, lede, toc = [], updated, tag, notice } = Astro.props;

// Pager order + grouping — the single source for prev/next across all docs.
// Grouping only drives adjacency in the pager (the group name is never shown),
// so /why-local chains with About/Contact and the legal trio chains together.
const DOC_ORDER: { href: string; group: string; label: string }[] = [
  { href: "/why-local", group: "company", label: "Why local" },
  { href: "/about", group: "company", label: "About" },
  { href: "/contact", group: "company", label: "Contact" },
  { href: "/privacy", group: "legal", label: "Privacy" },
  { href: "/terms", group: "legal", label: "Terms" },
  { href: "/disclaimer", group: "legal", label: "Disclaimer" },
];
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const current = DOC_ORDER.find((d) => d.href === here);
let prev: (typeof DOC_ORDER)[number] | null = null;
let next: (typeof DOC_ORDER)[number] | null = null;
if (current) {
  const group = DOC_ORDER.filter((d) => d.group === current.group);
  const i = group.findIndex((d) => d.href === current.href);
  prev = i > 0 ? group[i - 1] : null;
  next = i < group.length - 1 ? group[i + 1] : null;
}

const docPath = "~/freejsontoolkit " + (Astro.url.pathname.replace(/\/+$/, "") || "/");
---

<BaseLayout title={title} description={description} activePath={Astro.url.pathname}>
  <main>
    <section class="doc-page">
      <Container size="default">
        <div class="doc-grid">
          {
            toc.length > 0 && (
              <aside class="doc-toc" aria-label="On this page">
                <p class="doc-toc-title caption-mono">On this page</p>
                <ul class="doc-toc-list">
                  {toc.map((t) => (
                    <li>
                      <a class="doc-toc-link" href={`#${t.id}`} data-toc={t.id}>
                        {t.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }

          <div class="doc-main">
            <header class="doc-head doc-reveal">
              <p class="doc-path caption-mono">{docPath}</p>
              <p class="doc-eyebrow caption-mono">{eyebrow}</p>
              <h1 class="doc-title display-xl">{title}</h1>
              {lede && <p class="doc-lede body-lg">{lede}</p>}
              {
                (updated || tag) && (
                  <div class="doc-meta">
                    {updated && (
                      <>
                        <span class="doc-meta-dot" aria-hidden="true" />
                        <span>Updated {updated}</span>
                      </>
                    )}
                    {tag && <span class="doc-meta-tag">{tag}</span>}
                  </div>
                )
              }
            </header>

            <article class="doc-sheet doc-reveal">
              {
                toc.length > 0 && (
                  <details class="doc-toc-mobile">
                    <summary class="caption-mono">On this page</summary>
                    <ul>
                      {toc.map((t) => (
                        <li>
                          <a href={`#${t.id}`} data-toc={t.id}>
                            {t.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                )
              }

              {
                notice && (
                  <div class="doc-notice" role="note">
                    <span class="doc-notice-mark" aria-hidden="true">
                      !
                    </span>
                    <span>{notice}</span>
                  </div>
                )
              }

              <div class="doc-prose">
                <slot />
              </div>
            </article>

            {
              (prev || next) && (
                <nav class="doc-pager" aria-label="Document navigation">
                  {prev ? (
                    <a class="doc-pager-link prev" href={prev.href}>
                      <span class="doc-pager-dir">
                        <span class="doc-pager-arrow" aria-hidden="true">
                          ←{" "}
                        </span>
                        Previous
                      </span>
                      <span class="doc-pager-title">{prev.label}</span>
                    </a>
                  ) : (
                    <span class="doc-pager-spacer" />
                  )}
                  {next ? (
                    <a class="doc-pager-link next" href={next.href}>
                      <span class="doc-pager-dir">
                        Next
                        <span class="doc-pager-arrow" aria-hidden="true">
                          {" "}
                          →
                        </span>
                      </span>
                      <span class="doc-pager-title">{next.label}</span>
                    </a>
                  ) : (
                    <span class="doc-pager-spacer" />
                  )}
                </nav>
              )
            }
          </div>
        </div>
      </Container>
    </section>
  </main>

  <button type="button" class="doc-top" id="doc-top" aria-label="Back to top">↑</button>

  <script>
    // ── Scroll-spy: deterministic, position-based, resize- and click-proof. ──
    // The active entry = the last section whose top has crossed a fixed line
    // near the top of the viewport (THRESHOLD). We read live positions on every
    // scroll/resize tick, so there is no observer band to drift on resize and no
    // async callback to race a click. Sections stack top-to-bottom, so their
    // tops are monotonic — once a section's top is past the line, every later
    // one is too, and we stop. A bottom-of-page override ensures a short final
    // section still lights up. Clicking a link sets the highlight immediately,
    // smooth-scrolls (scoped here; reduced-motion → instant), and holds a short
    // lock so the highlight can't flicker to a neighbour mid-animation; any
    // manual scroll (wheel / touch / arrow keys) breaks the lock at once.
    (function () {
      const tocLinks = Array.prototype.slice.call(document.querySelectorAll(".doc-toc-link"));
      const mobileLinks = Array.prototype.slice.call(
        document.querySelectorAll(".doc-toc-mobile a"),
      );
      const sections = Array.prototype.slice.call(document.querySelectorAll(".doc-section"));
      if (!sections.length) return;

      const THRESHOLD = 120; // px from top; > scroll-margin-top (92) so a clicked
      // section always qualifies at rest, while the next one (a real section's
      // height below) does not.
      let current = null;
      let locked = false;
      let lockTimer = null;
      const reduce =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function setActive(id) {
        if (id === current) return;
        current = id;
        tocLinks.forEach(function (l) {
          l.classList.toggle("is-active", l.getAttribute("data-toc") === id);
        });
      }

      function idOfLink(el) {
        return el.getAttribute("data-toc") || (el.getAttribute("href") || "").replace(/^#/, "");
      }

      function compute() {
        if (locked) return;
        let activeId = sections[0].id; // default = first (covers the very top)
        for (let i = 0; i < sections.length; i++) {
          if (sections[i].getBoundingClientRect().top - THRESHOLD <= 0) {
            activeId = sections[i].id;
          } else {
            break; // tops are monotonic; nothing later can qualify
          }
        }
        // At the very bottom, a short last section may never reach the line —
        // force it active so the rail never ends on the wrong item.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          activeId = sections[sections.length - 1].id;
        }
        setActive(activeId);
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          compute();
        });
      }

      function releaseLock() {
        locked = false;
        if (lockTimer) {
          clearTimeout(lockTimer);
          lockTimer = null;
        }
        compute();
      }

      function goTo(id) {
        const el = document.getElementById(id);
        if (!el) return;
        setActive(id); // optimistic — and, with the lock, authoritative until settle
        locked = true;
        if (lockTimer) clearTimeout(lockTimer);
        el.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
        lockTimer = setTimeout(releaseLock, 650); // covers the smooth scroll
      }

      function onClick(e) {
        const id = idOfLink(e.currentTarget);
        if (!id) return;
        e.preventDefault();
        goTo(id);
        // mobile: collapse the disclosure after jumping so it doesn't linger
        const det = e.currentTarget.closest("details");
        if (det) det.open = false;
      }
      tocLinks.forEach(function (l) {
        l.addEventListener("click", onClick);
      });
      mobileLinks.forEach(function (l) {
        l.addEventListener("click", onClick);
      });

      // Manual interaction breaks a programmatic lock immediately, so the user
      // is never stuck watching a held highlight while they scroll by hand.
      ["wheel", "touchstart"].forEach(function (ev) {
        window.addEventListener(
          ev,
          function () {
            if (locked) releaseLock();
          },
          { passive: true },
        );
      });
      window.addEventListener("keydown", function (e) {
        const k = e.key;
        if (
          locked &&
          (k === "ArrowUp" ||
            k === "ArrowDown" ||
            k === "PageUp" ||
            k === "PageDown" ||
            k === " " ||
            k === "Home" ||
            k === "End")
        ) {
          releaseLock();
        }
      });

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll); // recompute → resize can't desync
      requestAnimationFrame(compute); // first paint
      window.addEventListener("load", function () {
        requestAnimationFrame(compute); // recompute after fonts/images shift layout
      });
    })();

    // ── Scroll reveal for head / sheet / sections ──
    if ("IntersectionObserver" in window) {
      const revealables = Array.prototype.slice.call(
        document.querySelectorAll(".doc-reveal, .doc-section"),
      );
      revealables.forEach(function (el, i) {
        el.classList.add("doc-reveal");
        el.style.transitionDelay = Math.min(i, 8) * 60 + "ms";
      });
      const rev = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add("is-visible");
              rev.unobserve(en.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      revealables.forEach(function (el) {
        rev.observe(el);
      });
    }

    // ── Back to top ──
    const topBtn = document.getElementById("doc-top");
    if (topBtn) {
      const onScrollTop = function () {
        topBtn.classList.toggle("show", window.scrollY > 420);
      };
      window.addEventListener("scroll", onScrollTop, { passive: true });
      onScrollTop();
      topBtn.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
  </script>
</BaseLayout>
