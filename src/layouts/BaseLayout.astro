---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/tool-cards.css";
import { tools, categoryLabel } from "../lib/tools/registry";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
  noindex?: boolean;
}

const {
  title = "Free JSON Toolkit - Modern Developer Utilities",
  description = "A suite of clean, developer-first, JSON tools to transform, validate, and format data.",
  activePath = "/",
  noindex = false,
} = Astro.props;

// Determine Canonical URL
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://freejsontoolkit.com",
);

// Set up JSON-LD structured data
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const siteBaseUrl = Astro.site?.toString() || "https://freejsontoolkit.com";

const jsonLd = isHomePage
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Free JSON Toolkit",
      url: siteBaseUrl,
      description: description,
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteBaseUrl}?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: title,
      url: canonicalURL.toString(),
      description: description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "All",
      browserRequirements: "Requires HTML5, JavaScript",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    };

// ── shared registry payload so client-built cards (favorites row,
//    "jump back in" echo) render identically to server cards, on any page. ──
const registryPayload = tools.map((t) => ({
  id: t.id,
  name: t.name,
  tagline: t.tagline,
  category: t.category,
  catLabel: categoryLabel(t.category),
  status: t.status,
  href: t.href ?? null,
}));
const toolIds = tools.map((t) => t.id);
// escape "</" so the JSON can never prematurely close the script tag
const registryJson = JSON.stringify(registryPayload).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Icons and Manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Free JSON Toolkit" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#171717" />

    <!-- registry the client uses to build cards from ids -->
    <meta name="fjt:tool-ids" content={JSON.stringify(toolIds)} />
    <script type="application/json" id="fjt-registry" set:html={registryJson} />

    <!-- Search Indexing -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", siteBaseUrl)} />
    <meta property="og:site_name" content="Free JSON Toolkit" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/og-image.png", siteBaseUrl)}
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics (Production Only) -->
    {
      import.meta.env.PROD && (
        <>
          <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-PYSH78FPX0"
          ></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-PYSH78FPX0');
          </script>
        </>
      )
    }
  </head>
  <body>
    <div class="app-layout">
      <!-- Skip-to-content link for keyboard and screen reader users -->
      <a href="#main-content-target" class="skip-link">Skip to main content</a>
      <Header activePath={activePath} />
      <main class="main-content" id="main-content-target">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- single global toast for favorite actions -->
    <div class="fav-toast" id="fav-toast" role="status" aria-live="polite" hidden></div>

    <!-- ═══════════════════════════════════════════════════════════════════
         The toolkit's client nervous system. ONE script, every page.
         (1) records a "recent" on real tool pages, (2) fills [data-your-tools],
         (3) fills the homepage [data-jump-back] echo, (4) handles every fav
         star via delegation, (5) powers the catalog command-line search +
         the global "/" focus shortcut, (6) reveals cards on scroll.
         Pages just drop in placeholders; future tools inherit all of it.
         ═══════════════════════════════════════════════════════════════════ -->
    <script is:inline>
      (function () {
        var FAV = "fjt:favorites", REC = "fjt:recents";
        function parse(s) { try { return s ? JSON.parse(s) : []; } catch (e) { return []; } }
        function load(k) { try { return parse(localStorage.getItem(k)); } catch (e) { return []; } }
        function save(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
        function favs() { return load(FAV); }
        function recents() { return load(REC); }

        // registry map from the data island emitted above
        var REG = [], byId = {};
        var island = document.getElementById("fjt-registry");
        if (island) REG = parse(island.textContent);
        REG.forEach(function (t) { byId[t.id] = t; });

        var MONO = { convert: "CON", format: "FOR", validate: "VAL", compare: "CMP", generate: "GEN", utilities: "UTL", api: "API" };
        function esc(s) {
          return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }

        // 1) record a recent visit — only for known tool routes
        var pm = location.pathname.replace(/\/+$/, "").match(/^\/tools\/([^\/]+)$/);
        if (pm && byId[pm[1]]) {
          var rid = pm[1];
          var r = recents().filter(function (x) { return x !== rid; });
          r.unshift(rid);
          save(REC, r.slice(0, 8));
        }

        // 2) a live, favoritable card (same shell the server renders)
        function liveCard(t, starred) {
          var sLab = starred ? "Remove " : "Add ";
          var sTtl = starred ? "Remove from favorites" : "Add to favorites";
          return (
            '<article class="tool-card is-live" role="listitem">' +
              '<button type="button" class="fav-star" data-tool="' + esc(t.id) + '" aria-pressed="' + (starred ? "true" : "false") + '" aria-label="' + esc(sLab + t.name + (starred ? " from favorites" : " to favorites")) + '" title="' + esc(sTtl) + '">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L12 16.77l-5.2 2.73.99-5.78-4.21-4.1 5.82-.85L12 3.5z"/></svg>' +
              '</button>' +
              '<a class="tool-card-link" href="' + esc(t.href) + '">' +
                '<div class="card-top"><span class="mono-badge" aria-hidden="true">' + esc(MONO[t.category] || "·") + '</span><span class="cat-chip caption-mono" aria-hidden="true">' + esc(t.catLabel || t.category) + '</span></div>' +
                '<h3 class="display-sm card-name">' + esc(t.name) + '</h3>' +
                '<p class="body-sm card-tag">' + esc(t.tagline) + '</p>' +
                '<div class="card-foot"><span class="pill pill-live" aria-hidden="true"><span class="pill-dot"></span>Available</span><span class="card-cta body-sm-strong" aria-hidden="true">Open <span class="cta-arrow">→</span></span></div>' +
              '</a>' +
            '</article>'
          );
        }

        // 3) "Your tools" row: starred first, then recent, capped
        function buildRow() {
          var host = document.querySelector("[data-your-tools]");
          if (!host) return;
          var f = favs(), rc = recents();
          var order = f.slice();
          rc.forEach(function (id) { if (order.indexOf(id) === -1) order.push(id); });
          var ids = order.filter(function (id) { return byId[id]; }).slice(0, 8);

          var html = '<div class="your-tools-head"><h2 class="display-sm your-tools-title">Your tools</h2><span class="caption-mono your-tools-sub">starred + recent</span></div>';
          if (ids.length === 0) {
            html += '<div class="your-tools-empty"><span aria-hidden="true">★</span><span>Star a tool, or just open one — it’ll pin here for quick access next time.</span></div>';
          } else {
            html += '<div class="tool-grid" role="list">';
            ids.forEach(function (id) { html += liveCard(byId[id], f.indexOf(id) !== -1); });
            html += '</div>';
          }
          host.innerHTML = html;
        }

        // 4) homepage "jump back in" echo: recents only, hidden when empty
        function buildEcho() {
          var inner = document.querySelector("[data-jump-inner]");
          var sec = inner ? inner.closest("[data-jump-back]") : null;
          if (!inner || !sec) return;
          var rc = recents().filter(function (id) { return byId[id]; }).slice(0, 6);
          if (rc.length === 0) { sec.hidden = true; return; }
          var chips = rc.map(function (id) {
            var t = byId[id];
            return (
              '<a class="jump-chip" href="' + esc(t.href) + '">' +
                '<span class="mono-badge" aria-hidden="true">' + esc(MONO[t.category] || "·") + '</span>' +
                '<span class="jump-chip-name">' + esc(t.name) + '</span>' +
                '<span class="jump-chip-arrow" aria-hidden="true">↩</span>' +
              '</a>'
            );
          }).join("");
          inner.innerHTML =
            '<div class="jump-head"><span class="jump-title">Jump back in</span><span class="jump-hint caption">your recent tools</span></div>' +
            '<div class="jump-row">' + chips + '</div>';
          sec.hidden = false;
        }

        // 5) keep EVERY star in the DOM consistent with storage
        function syncStars() {
          var f = favs();
          document.querySelectorAll(".fav-star").forEach(function (star) {
            var id = star.getAttribute("data-tool");
            var on = !!(id && f.indexOf(id) !== -1);
            star.classList.toggle("is-fav", on);
            star.setAttribute("aria-pressed", on ? "true" : "false");
            var card = star.closest(".tool-card");
            var nm = card && card.querySelector(".card-name");
            var name = nm ? nm.textContent.trim() : "Tool";
            star.setAttribute("aria-label", (on ? "Remove " : "Add ") + name + (on ? " from favorites" : " to favorites"));
            star.title = on ? "Remove from favorites" : "Add to favorites";
          });
        }

        // 6) toast
        var toast = document.getElementById("fav-toast");
        var toastT = null;
        function flash(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.hidden = false;
          void toast.offsetWidth;
          toast.classList.add("show");
          if (toastT) clearTimeout(toastT);
          toastT = setTimeout(function () {
            toast.classList.remove("show");
            setTimeout(function () { if (toast) toast.hidden = true; }, 220);
          }, 1400);
        }

        // 7) delegated star toggle — works for server- and client-built cards
        document.addEventListener("click", function (e) {
          var star = e.target && e.target.closest ? e.target.closest(".fav-star") : null;
          if (!star) return;
          e.preventDefault();
          e.stopPropagation();
          var id = star.getAttribute("data-tool");
          if (!id || !byId[id]) return;
          var f = favs();
          var on = f.indexOf(id) === -1;
          if (on) f.push(id); else f = f.filter(function (x) { return x !== id; });
          save(FAV, f);
          buildRow();
          syncStars();
          flash(on ? ("★ " + byId[id].name + " saved to favorites") : (byId[id].name + " removed from favorites"));
        });

        // init personalization
        buildRow();
        buildEcho();
        syncStars();

        // 8) bite 3 — command-line catalog search (only where a box exists)
        var searchInput = document.querySelector("[data-tool-search]");
        if (searchInput) {
          var form = document.querySelector("[data-tool-search-form]");
          var clearBtn = document.querySelector("[data-search-clear]");
          var statusEl = document.querySelector("[data-search-status]");
          var emptyEl = document.querySelector("[data-search-empty]");
          var echoEl = emptyEl ? emptyEl.querySelector("[data-search-echo]") : null;
          var yourTools = document.querySelector("[data-your-tools]");
          var cards = Array.prototype.slice.call(document.querySelectorAll(".tool-card[data-search]"));
          var gridAvail = document.querySelector('[data-grid="available"]');
          var gridPipe = document.querySelector('[data-grid="pipeline"]');
          var pipeBlock = document.querySelector(".pipeline-block");
          var availTotal = REG.filter(function (t) { return t.status === "available"; }).length;
          var primed = false; // false on the very first run so the scroll-reveal stagger survives

          function toks(q) { return q.toLowerCase().trim().split(/\s+/).filter(Boolean); }

          function runSearch() {
            var q = searchInput.value;
            var ts = toks(q);
            var searching = ts.length > 0;
            var visAvail = 0, visPipe = 0;

            cards.forEach(function (card) {
              var hay = card.getAttribute("data-search") || "";
              var match = ts.every(function (tk) { return hay.indexOf(tk) !== -1; });
              card.classList.toggle("is-hidden", !match);
              if (match) {
                // once the user has searched, never leave a shown card stuck at
                // opacity 0 (reveal-safe); on first paint we skip this so the
                // IntersectionObserver stagger still plays.
                if (primed || searching) card.classList.add("is-visible");
                if ((card.getAttribute("data-status") || "") === "available") visAvail++; else visPipe++;
              }
            });

            if (gridAvail) gridAvail.classList.toggle("is-hidden", searching && visAvail === 0);
            if (gridPipe) gridPipe.classList.toggle("is-hidden", searching && visPipe === 0);
            if (pipeBlock) pipeBlock.classList.toggle("is-hidden", searching && visPipe === 0);
            if (yourTools) yourTools.hidden = searching; // recents are noise during a search

            var totalVis = visAvail + visPipe;
            if (emptyEl) emptyEl.hidden = !(searching && totalVis === 0);
            if (echoEl) echoEl.textContent = q;
            if (clearBtn) clearBtn.hidden = q.length === 0;

            if (statusEl) {
              statusEl.textContent = searching
                ? totalVis + " of " + cards.length + " match “" + q + "”"
                : "filter " + availTotal + " live tools · type, or press / to focus";
            }
            primed = true;
          }

          searchInput.addEventListener("input", runSearch);
          if (form) form.addEventListener("submit", function (e) { e.preventDefault(); });
          if (clearBtn) clearBtn.addEventListener("click", function () {
            searchInput.value = ""; runSearch(); searchInput.focus();
          });
          searchInput.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
              if (searchInput.value) { searchInput.value = ""; runSearch(); }
              else searchInput.blur();
              e.preventDefault();
            }
          });
          document.querySelectorAll("[data-search-focus]").forEach(function (el) {
            el.addEventListener("click", function () { searchInput.focus(); });
          });

          runSearch(); // paint the idle hint
        }

        // global "/" focuses the catalog search. No-op on pages without a box;
        // never hijacks typing in a field or in the search box itself.
        document.addEventListener("keydown", function (e) {
          if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
          var si = document.querySelector("[data-tool-search]");
          if (!si) return;
          var ae = document.activeElement;
          var tag = ae && ae.tagName ? ae.tagName : "";
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || (ae && ae.isContentEditable)) return;
          e.preventDefault();
          si.focus({ preventScroll: false });
          if (si.scrollIntoView) si.scrollIntoView({ block: "nearest" });
        });

        // 9) scroll reveal — progressive enhancement; no-JS stays visible
        if ("IntersectionObserver" in window) {
          var targets = Array.prototype.slice.call(
            document.querySelectorAll(".tool-card, .live-tool-card, .trust-card, .pipeline, .jump-chip")
          );
          targets.forEach(function (el, i) {
            el.classList.add("reveal");
            el.style.transitionDelay = Math.min(i, 10) * 50 + "ms";
          });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add("is-visible"); io.unobserve(en.target); }
            });
          }, { threshold: 0.1 });
          targets.forEach(function (el) { io.observe(el); });
        }
      })();
    </script>
  </body>
</html>

<style>
  .app-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Skip-to-content link: hidden by default, visible on focus */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--spacing-md);
    z-index: 10000;
    background: var(--color-accent);
    color: var(--color-on-primary);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--rounded-xs);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--spacing-xs);
  }
</style>