---
import CommandPalette from "../components/CommandPalette.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/tool-cards.css";
import { tools, categoryLabel } from "../lib/tools/registry";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  activePath?: string;
  noindex?: boolean;
}

const {
  title = "Free JSON Toolkit - Modern Developer Utilities",
  description = "A suite of clean, developer-first, JSON tools to transform, validate, and format data.",
  keywords = "",
  activePath = "/",
  noindex = false,
} = Astro.props;

// Determine Canonical URL
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://freejsontoolkit.com",
);

// Set up JSON-LD structured data
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const siteBaseUrl = Astro.site?.toString() || "https://freejsontoolkit.com";

const jsonLd = isHomePage
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Free JSON Toolkit",
      url: siteBaseUrl,
      description: description,
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteBaseUrl}?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: title,
      url: canonicalURL.toString(),
      description: description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "All",
      browserRequirements: "Requires HTML5, JavaScript",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    };

// ── shared registry payload so client-built cards (favorites row,
//    "jump back in" echo) render identically to server cards, on any page. ──
const registryPayload = tools.map((t) => ({
  id: t.id,
  name: t.name,
  tagline: t.tagline,
  category: t.category,
  catLabel: categoryLabel(t.category),
  status: t.status,
  href: t.href ?? null,
}));
const toolIds = tools.map((t) => t.id);
// escape "</" so the JSON can never prematurely close the script tag
const registryJson = JSON.stringify(registryPayload).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Icons and Manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Free JSON Toolkit" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#171717" />


    <meta name="fjt:tool-ids" content={JSON.stringify(toolIds)} />
    <script type="application/json" id="fjt-registry" set:html={registryJson}></script>
    
    <!-- Search Indexing -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", siteBaseUrl)} />
    <meta property="og:site_name" content="Free JSON Toolkit" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/og-image.png", siteBaseUrl)}
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics (Production Only) -->
    {
      import.meta.env.PROD && (
        <>
          <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-PYSH78FPX0"
          ></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-PYSH78FPX0');
          </script>
        </>
      )
    }
  </head>
  <body>
    <div class="app-layout">
      <!-- Skip-to-content link for keyboard and screen reader users -->
      <a href="#main-content-target" class="skip-link">Skip to main content</a>
      <Header activePath={activePath} />
      <main class="main-content" id="main-content-target">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- single global toast for favorite actions -->
         <CommandPalette />
    <div class="fav-toast" id="fav-toast" role="status" aria-live="polite" hidden></div>

    <!-- bite 4: discoverability launcher for the shortcuts sheet. Hidden by
         default (so no-JS users never see a dead button) and on tool pages
         (corners are occupied by editor status bars); the global script reveals
         it elsewhere. The "?" key works everywhere regardless. -->
    <button
      type="button"
      class="kbd-launcher"
      id="kbd-launcher"
      hidden
      aria-haspopup="dialog"
      aria-label="Open keyboard shortcuts"
    >
      <kbd class="kbd">?</kbd> shortcuts
    </button>

    <!-- bite 4: the shortcuts sheet. A real modal — opening it makes the rest
         of the page inert (focus can't escape, a11y tree ignores the backdrop),
         so the focus trap is free. Context rows get a "here" marker per page. -->
    <div class="kbd-overlay" id="kbd-overlay" hidden>
      <div class="kbd-sheet" role="dialog" aria-modal="true" aria-labelledby="kbd-title" id="kbd-sheet">
        <div class="kbd-head">
          <div class="kbd-head-left">
            <span class="kbd-eyebrow">Keyboard</span>
            <h2 class="kbd-title" id="kbd-title">Shortcuts</h2>
          </div>
          <button type="button" class="kbd-close" id="kbd-close" aria-label="Close shortcuts">
            close <kbd class="kbd">Esc</kbd>
          </button>
        </div>

        <div class="kbd-body">
          <div class="kbd-group">
            <span class="kbd-group-label">Navigate</span>
            <div class="kbd-rows">
              <div class="kbd-row">
                <span class="kbd-desc">Home</span>
                <span class="kbd-keys">
                  <kbd class="kbd">g</kbd><span class="kbd-then">then</span><kbd class="kbd">h</kbd>
                </span>
              </div>
              <div class="kbd-row">
                <span class="kbd-desc">Tools catalog</span>
                <span class="kbd-keys">
                  <kbd class="kbd">g</kbd><span class="kbd-then">then</span><kbd class="kbd">t</kbd>
                </span>
              </div>
            </div>
          </div>

          <div class="kbd-group">
            <span class="kbd-group-label">Search</span>
            <div class="kbd-rows">
              <div class="kbd-row" data-ctx="catalog">
                <span class="kbd-desc">Focus tool search</span>
                <span class="kbd-keys">
                  <kbd class="kbd">/</kbd>
                  <span class="kbd-here"><span class="kbd-here-dot"></span>here</span>
                </span>
              </div>
            </div>
          </div>

          <div class="kbd-group">
            <span class="kbd-group-label">In a tool</span>
            <div class="kbd-rows">
              <div class="kbd-row" data-ctx="tool">
                <span class="kbd-desc">Run (Convert / Format)</span>
                <span class="kbd-keys">
                  <kbd class="kbd">Ctrl / ⌘</kbd><span class="kbd-plus">+</span><kbd class="kbd">Enter</kbd>
                  <span class="kbd-here"><span class="kbd-here-dot"></span>here</span>
                </span>
              </div>
              <div class="kbd-row" data-ctx="tool">
                <span class="kbd-desc">Cancel conversion</span>
                <span class="kbd-keys">
                  <kbd class="kbd">Esc</kbd>
                  <span class="kbd-here"><span class="kbd-here-dot"></span>here</span>
                </span>
              </div>
            </div>
          </div>

          <div class="kbd-group">
            <span class="kbd-group-label">This panel</span>
            <div class="kbd-rows">
              <div class="kbd-row">
                <span class="kbd-desc">Toggle this panel</span>
                <span class="kbd-keys"><kbd class="kbd">?</kbd></span>
              </div>
            </div>
          </div>
        </div>

        <div class="kbd-foot">
          <span>chords: press <kbd class="kbd">g</kbd> then a letter</span>
          <span>runs 100% locally</span>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════
         The toolkit's client nervous system. ONE script, every page.
         (1) records a "recent" on real tool pages, (2) fills [data-your-tools],
         (3) fills the homepage [data-jump-back] echo, (4) handles every fav
         star via delegation, (5) powers the catalog command-line search —
         with an entrance animation on newly-matched cards, (6) the keyboard
         layer: ? sheet + g-chords + context markers + the global "/" focus,
         (7) reveals cards on scroll. Pages just drop in placeholders; future
         tools inherit all of it.
         ═══════════════════════════════════════════════════════════════════ -->
    <script is:inline>
      (function () {
        const FAV = "fjt:favorites", REC = "fjt:recents";
        function parse(s) { try { return s ? JSON.parse(s) : []; } catch (e) { return []; } }
        function load(k) { try { return parse(localStorage.getItem(k)); } catch (e) { return []; } }
        function save(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* localStorage unavailable */ } }
        function favs() { return load(FAV); }
        function recents() { return load(REC); }

        // registry map from the data island emitted above
        let REG = [];
        const byId = {};
        const island = document.getElementById("fjt-registry");
        if (island) REG = parse(island.textContent);
        REG.forEach(function (t) { byId[t.id] = t; });

        const MONO = { convert: "CON", format: "FOR", validate: "VAL", compare: "CMP", generate: "GEN", utilities: "UTL", api: "API" };
        function esc(s) {
          return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }

        // 1) record a recent visit — only for known tool routes
       const recPath = location.pathname.replace(/\/+$/, "");
        const curTool = REG.find(function (t) { return t.href === recPath; });
        if (curTool) {
          const rid = curTool.id;
          const r = recents().filter(function (x) { return x !== rid; });
          r.unshift(rid);
          save(REC, r.slice(0, 8));
        }

        // 2) a live, favoritable card (same shell the server renders)
        function liveCard(t, starred) {
          const sLab = starred ? "Remove " : "Add ";
          const sTtl = starred ? "Remove from favorites" : "Add to favorites";
          return (
            '<article class="tool-card is-live" role="listitem">' +
              '<button type="button" class="fav-star" data-tool="' + esc(t.id) + '" aria-pressed="' + (starred ? "true" : "false") + '" aria-label="' + esc(sLab + t.name + (starred ? " from favorites" : " to favorites")) + '" title="' + esc(sTtl) + '">' +
                '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L12 16.77l-5.2 2.73.99-5.78-4.21-4.1 5.82-.85L12 3.5z"/></svg>' +
              '</button>' +
              '<a class="tool-card-link" href="' + esc(t.href) + '">' +
                '<div class="card-top"><span class="mono-badge" aria-hidden="true">' + esc(MONO[t.category] || "·") + '</span><span class="cat-chip caption-mono" aria-hidden="true">' + esc(t.catLabel || t.category) + '</span></div>' +
                '<h3 class="display-sm card-name">' + esc(t.name) + '</h3>' +
                '<p class="body-sm card-tag">' + esc(t.tagline) + '</p>' +
                '<div class="card-foot"><span class="pill pill-live" aria-hidden="true"><span class="pill-dot"></span>Available</span><span class="card-cta body-sm-strong" aria-hidden="true">Open <span class="cta-arrow">→</span></span></div>' +
              '</a>' +
            '</article>'
          );
        }

        // 3) "Your tools" row: starred first, then recent, capped
        function buildRow() {
          const host = document.querySelector("[data-your-tools]");
          if (!host) return;
          const f = favs(), rc = recents();
          const order = f.slice();
          rc.forEach(function (id) { if (order.indexOf(id) === -1) order.push(id); });
          const ids = order.filter(function (id) { return byId[id]; }).slice(0, 8);

          let html = '<div class="your-tools-head"><h2 class="display-sm your-tools-title">Your tools</h2><span class="caption-mono your-tools-sub">starred + recent</span></div>';
          if (ids.length === 0) {
            html += '<div class="your-tools-empty"><span aria-hidden="true">★</span><span>Star a tool, or just open one — it’ll pin here for quick access next time.</span></div>';
          } else {
            html += '<div class="tool-grid" role="list">';
            ids.forEach(function (id) { html += liveCard(byId[id], f.indexOf(id) !== -1); });
            html += '</div>';
          }
          host.innerHTML = html;
        }

        // 4) homepage "jump back in" echo: recents only, hidden when empty
        function buildEcho() {
          const inner = document.querySelector("[data-jump-inner]");
          const sec = inner ? inner.closest("[data-jump-back]") : null;
          if (!inner || !sec) return;
          const rc = recents().filter(function (id) { return byId[id]; }).slice(0, 6);
          if (rc.length === 0) { sec.hidden = true; return; }
          const chips = rc.map(function (id) {
      const t = byId[id];
      return (
        '<a class="jump-chip" href="' + esc(t.href) + '">' +
          '<span class="mono-badge" aria-hidden="true">' + esc(MONO[t.category] || "·") + '</span>' +
          '<span class="jump-chip-name">' + esc(t.name) + '</span>' +
          '<span class="jump-chip-arrow" aria-hidden="true">↩</span>' +
        '</a>'
      );
    }).join("");
          inner.innerHTML =
            '<div class="jump-head"><span class="jump-title">Jump back in</span><span class="jump-hint caption">your recent tools</span></div>' +
            '<div class="jump-row">' + chips + '</div>';
          sec.hidden = false;
        }

        // 5) keep EVERY star in the DOM consistent with storage
        function syncStars() {
          const f = favs();
          document.querySelectorAll(".fav-star").forEach(function (star) {
            const id = star.getAttribute("data-tool");
            const on = !!(id && f.indexOf(id) !== -1);
            star.classList.toggle("is-fav", on);
            star.setAttribute("aria-pressed", on ? "true" : "false");
            const card = star.closest(".tool-card");
            const nm = card && card.querySelector(".card-name");
            const name = nm ? nm.textContent.trim() : "Tool";
            star.setAttribute("aria-label", (on ? "Remove " : "Add ") + name + (on ? " from favorites" : " to favorites"));
            star.title = on ? "Remove from favorites" : "Add to favorites";
          });
        }

        // 6) toast
        const toast = document.getElementById("fav-toast");
        let toastT = null;
        function flash(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.hidden = false;
          void toast.offsetWidth;
          toast.classList.add("show");
          if (toastT) clearTimeout(toastT);
          toastT = setTimeout(function () {
            toast.classList.remove("show");
            setTimeout(function () { if (toast) toast.hidden = true; }, 220);
          }, 1400);
        }

        // 7) delegated star toggle — works for server- and client-built cards
        document.addEventListener("click", function (e) {
          const star = e.target && e.target.closest ? e.target.closest(".fav-star") : null;
          if (!star) return;
          e.preventDefault();
          e.stopPropagation();
          const id = star.getAttribute("data-tool");
          if (!id || !byId[id]) return;
          let f = favs();
          const on = f.indexOf(id) === -1;
          if (on) f.push(id); else f = f.filter(function (x) { return x !== id; });
          save(FAV, f);
          buildRow();
          syncStars();
          flash(on ? ("★ " + byId[id].name + " saved to favorites") : (byId[id].name + " removed from favorites"));
        });

        // init personalization
        buildRow();
        buildEcho();
        syncStars();

        // 8) bite 3 — command-line catalog search (only where a box exists)
        const searchInput = document.querySelector("[data-tool-search]");
        if (searchInput) {
          const form = document.querySelector("[data-tool-search-form]");
          const clearBtn = document.querySelector("[data-search-clear]");
          const statusEl = document.querySelector("[data-search-status]");
          const emptyEl = document.querySelector("[data-search-empty]");
          const echoEl = emptyEl ? emptyEl.querySelector("[data-search-echo]") : null;
          const yourTools = document.querySelector("[data-your-tools]");
          const cards = Array.prototype.slice.call(document.querySelectorAll(".tool-card[data-search]"));
          const gridAvail = document.querySelector('[data-grid="available"]');
          const gridPipe = document.querySelector('[data-grid="pipeline"]');
          const pipeBlock = document.querySelector(".pipeline-block");
          const availTotal = REG.filter(function (t) { return t.status === "available"; }).length;
          let primed = false;      // false on the very first run so reveal stagger survives
          let prevVisible = null;  // identity set of cards visible after the previous run

          function toks(q) { return q.toLowerCase().trim().split(/\s+/).filter(Boolean); }
          // stable per-card identity (the haystack contains the id, so it's unique)
          function cid(card) { return card.getAttribute("data-search") || ""; }

          function runSearch() {
            const q = searchInput.value;
            const ts = toks(q);
            const searching = ts.length > 0;
            let visAvail = 0, visPipe = 0;
            const nowVisible = new Set();

            cards.forEach(function (card) {
              const hay = card.getAttribute("data-search") || "";
              const match = ts.every(function (tk) { return hay.indexOf(tk) !== -1; });
              card.classList.toggle("is-hidden", !match);
              if (match) {
                if (primed || searching) card.classList.add("is-visible");
                if ((card.getAttribute("data-status") || "") === "available") visAvail++; else visPipe++;
                nowVisible.add(cid(card));
              }
            });

            // Entrance motion: animate ONLY the cards that newly appeared since
            // the last run. Survivors are untouched (no strobe on fast typing),
            // and the first paint is skipped (no fight with the reveal stagger).
            if (primed && prevVisible) {
              cards.forEach(function (card) {
                const id = cid(card);
                if (nowVisible.has(id) && !prevVisible.has(id)) {
                  card.classList.remove("just-shown");
                  void card.offsetWidth; // restart the keyframe cleanly
                  card.classList.add("just-shown");
                  card.addEventListener("animationend", function h() {
                    card.classList.remove("just-shown");
                    card.removeEventListener("animationend", h);
                  });
                }
              });
            }
            prevVisible = nowVisible;

            if (gridAvail) gridAvail.classList.toggle("is-hidden", searching && visAvail === 0);
            if (gridPipe) gridPipe.classList.toggle("is-hidden", searching && visPipe === 0);
            if (pipeBlock) pipeBlock.classList.toggle("is-hidden", searching && visPipe === 0);
            if (yourTools) yourTools.hidden = searching; // recents are noise during a search

            const totalVis = visAvail + visPipe;
            if (emptyEl) emptyEl.hidden = !(searching && totalVis === 0);
            if (echoEl) echoEl.textContent = q;
            if (clearBtn) clearBtn.hidden = q.length === 0;

            if (statusEl) {
              statusEl.textContent = searching
                ? totalVis + " of " + cards.length + " match “" + q + "”"
                : "filter " + availTotal + " live tools · type, or press / to focus";
            }
            primed = true;
          }

          searchInput.addEventListener("input", runSearch);
          if (form) form.addEventListener("submit", function (e) { e.preventDefault(); });
          if (clearBtn) clearBtn.addEventListener("click", function () {
            searchInput.value = ""; runSearch(); searchInput.focus();
          });
          searchInput.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
              if (searchInput.value) { searchInput.value = ""; runSearch(); }
              else searchInput.blur();
              e.preventDefault();
            }
          });
          document.querySelectorAll("[data-search-focus]").forEach(function (el) {
            el.addEventListener("click", function () { searchInput.focus(); });
          });

          runSearch(); // paint the idle hint + seed prevVisible (no animation)
        }

        // 9) bite 4 — keyboard layer: ? sheet, g-chords, context markers, and
        //    the global "/" focus (consolidated here so they can't collide).
        const overlay = document.getElementById("kbd-overlay");
        const sheetEl = document.getElementById("kbd-sheet");
        const launcher = document.getElementById("kbd-launcher");
        const closeBtn = document.getElementById("kbd-close");
        const app = document.querySelector(".app-layout");
        let kbOpen = false;
        let kbLastFocus = null;
        let gPending = false;
        let gTimer = null;

        const pathNow = location.pathname.replace(/\/+$/, "");
        const isCatalog = pathNow === "/tools";
        const isToolPage = /^\/tools\/[^/]+$/.test(location.pathname);

        // context markers ("here") — only the shortcuts that fire on this page
        document.querySelectorAll(".kbd-row[data-ctx]").forEach(function (row) {
          const ctx = row.getAttribute("data-ctx");
          if ((ctx === "catalog" && isCatalog) || (ctx === "tool" && isToolPage)) {
            row.classList.add("is-here");
          }
        });

        // reveal the launcher everywhere except inside a tool (corners are busy)
        if (launcher) launcher.hidden = isToolPage;

        function openKb() {
          if (!overlay || !sheetEl) return;
          kbLastFocus = document.activeElement;
          kbOpen = true;
          overlay.hidden = false;
          if (app) app.inert = true;          // background leaves tab order + a11y tree
          if (launcher) launcher.hidden = true;
          requestAnimationFrame(function () { overlay.classList.add("is-open"); });
          (closeBtn || sheetEl).focus();
        }
        function closeKb() {
          if (!overlay) return;
          kbOpen = false;
          overlay.classList.remove("is-open");
          if (app) app.inert = false;
          if (kbLastFocus && kbLastFocus.focus) kbLastFocus.focus();
          setTimeout(function () {
            if (!kbOpen) {
              overlay.hidden = true;
              if (launcher) launcher.hidden = isToolPage;
            }
          }, 200);
        }
        function toggleKb() { if (kbOpen) { closeKb(); } else { openKb(); } }

        if (closeBtn) closeBtn.addEventListener("click", closeKb);
        if (launcher) launcher.addEventListener("click", openKb);
        if (overlay) overlay.addEventListener("mousedown", function (e) {
          if (e.target === overlay) closeKb(); // click the backdrop, not the sheet
        });

        // one global key handler for ?, /, g-chords, and Esc-close
        document.addEventListener("keydown", function (e) {
          if (e.repeat) return;

          // Esc closes the sheet if open; otherwise fall through to page
          // handlers (e.g. a converter's own Esc-to-cancel)
          if (e.key === "Escape") {
            if (kbOpen) { e.preventDefault(); closeKb(); }
            return;
          }

          // ? toggles the sheet — unless you're typing it into a field
          if (e.key === "?") {
            const aeQ = document.activeElement;
            const tQ = aeQ && aeQ.tagName ? aeQ.tagName : "";
            const typingQ = tQ === "INPUT" || tQ === "TEXTAREA" || tQ === "SELECT" || (aeQ && aeQ.isContentEditable);
            if (typingQ) return;
            e.preventDefault();
            toggleKb();
            return;
          }

          // from here on: clean keystroke, not typing, sheet closed
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          const ae = document.activeElement;
          const tag = ae && ae.tagName ? ae.tagName : "";
          if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || (ae && ae.isContentEditable)) return;
          if (kbOpen) return;

          // / focuses the catalog search (only present on /tools)
          if (e.key === "/") {
            const si = document.querySelector("[data-tool-search]");
            if (si) {
              e.preventDefault();
              si.focus({ preventScroll: false });
              if (si.scrollIntoView) si.scrollIntoView({ block: "nearest" });
            }
            return;
          }

          // g-chords: g then h / g then t, within a short window
          if (e.key === "g") {
            gPending = true;
            if (gTimer) clearTimeout(gTimer);
            gTimer = setTimeout(function () { gPending = false; }, 900);
            return;
          }
          if (gPending) {
            gPending = false;
            if (gTimer) clearTimeout(gTimer);
            if (e.key === "h") { e.preventDefault(); location.assign("/"); }
            else if (e.key === "t") { e.preventDefault(); location.assign("/tools"); }
          }
        });

        // 10) scroll reveal — progressive enhancement; no-JS stays visible
        if ("IntersectionObserver" in window) {
          const targets = Array.prototype.slice.call(
      document.querySelectorAll(".tool-card, .live-tool-card, .trust-card, .pipeline, .jump-chip")
    );
          targets.forEach(function (el, i) {
            el.classList.add("reveal");
            el.style.transitionDelay = Math.min(i, 10) * 50 + "ms";
          });
          const io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) { en.target.classList.add("is-visible"); io.unobserve(en.target); }
            });
          }, { threshold: 0.1 });
          targets.forEach(function (el) { io.observe(el); });
        }
      })();
    </script>
  </body>
</html>

