---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
  noindex?: boolean;
}

const {
  title = "Free JSON Toolkit - Modern Developer Utilities",
  description = "A suite of clean, developer-first, JSON tools to transform, validate, and format data.",
  activePath = "/",
  noindex = false,
} = Astro.props;

// Determine Canonical URL
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://freejsontoolkit.com",
);

// Set up JSON-LD structured data
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const siteBaseUrl = Astro.site?.toString() || "https://freejsontoolkit.com";

const jsonLd = isHomePage
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Free JSON Toolkit",
      url: siteBaseUrl,
      description: description,
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteBaseUrl}?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: title,
      url: canonicalURL.toString(),
      description: description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "All",
      browserRequirements: "Requires HTML5, JavaScript",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Icons and Manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Free JSON Toolkit" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#171717" />

    <!-- Search Indexing -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", siteBaseUrl)} />
    <meta property="og:site_name" content="Free JSON Toolkit" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/og-image.png", siteBaseUrl)}
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="app-layout">
      <Header activePath={activePath} />
      <main class="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .app-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
