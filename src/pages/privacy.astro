---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Card from "../components/Card.astro";
---

<BaseLayout
  title="Privacy Policy - Free JSON Toolkit"
  description="Read our privacy policy. Learn how Free JSON Toolkit processes all JSON files and conversion data locally inside your browser sandbox."
  activePath="/privacy"
>
  <main>
    {/* Page Header */}
    <section class="page-header" aria-labelledby="privacy-title">
      <Container size="narrow" class="header-container">
        <span class="caption-mono section-eyebrow">LEGAL POLICY</span>
        <h1 id="privacy-title" class="display-xl page-title">
          Privacy Policy
        </h1>
        <p class="caption-mono last-updated">
          Last updated: July 2026
        </p>
      </Container>
    </section>

    {/* Content Sections */}
    <section class="content-section" aria-label="Privacy Policy Details">
      <Container size="narrow">
        <div class="policy-wrapper">
          
          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">1. Local Processing</h2>
            <p class="body-md policy-text">
              One of our core principles is that your data belongs to you. Free JSON Toolkit operates as a client-side utility suite:
            </p>
            <ul class="body-md policy-list">
              <li><strong>In-Browser Execution:</strong> All JSON formatting, conversion, and validation are performed locally in your browser sandbox using JavaScript.</li>
              <li><strong>No Data Uploads:</strong> Your data inputs, files, and outputs are never uploaded to Free JSON Toolkit servers or transmitted across the network.</li>
              <li><strong>Ephemeral State:</strong> Once you close the browser tab or refresh the page, all processed data and state are completely cleared from your system's memory.</li>
            </ul>
          </Card>

          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">2. Analytics and Measurement</h2>
            <p class="body-md policy-text">
              We aim to minimize unnecessary tracking while keeping the toolkit fast and privacy-focused. 
              We may utilize basic, privacy-respecting analytics services to monitor page popularity, count user visits, and detect broken links. 
              These analytics do not log your files, input text, or output data.
            </p>
          </Card>

          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">3. Cookies</h2>
            <p class="body-md policy-text">
              Free JSON Toolkit does not set tracking cookies to build user profiles or monitor you across the web. 
              However, third-party providers (such as hosting infrastructure or future ad networks) may use standard functional cookies or local storage to keep the service functional and secure.
            </p>
          </Card>

          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">4. Third-Party Links</h2>
            <p class="body-md policy-text">
              Our website contains links to external platforms like GitHub and documentation sites. 
              Once you click these links and leave Free JSON Toolkit, our privacy terms no longer apply. 
              We encourage you to review the privacy statements of those external platforms.
            </p>
          </Card>

          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">5. Contact Information</h2>
            <p class="body-md policy-text">
              If you have any questions or feedback about our privacy practices, you can submit an issue on our public GitHub repository or check back when contact details are published.
            </p>
          </Card>

        </div>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--spacing-5xl);
    padding-bottom: var(--spacing-3xl);
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    text-align: center;
  }

  .header-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }

  .page-title {
    margin-top: 0;
    margin-bottom: var(--spacing-xxs);
    color: var(--color-ink);
  }

  .last-updated {
    color: var(--color-mute);
    margin: 0;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    background-color: var(--color-canvas-soft);
  }

  .policy-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .policy-card {
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-xl) !important;
  }

  .policy-heading {
    color: var(--color-ink);
    margin: 0;
  }

  .policy-text {
    color: var(--color-body);
    line-height: 1.7;
    margin: 0;
  }

  .policy-list {
    margin: 0;
    padding-left: var(--spacing-xl);
    color: var(--color-body);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  @media (max-width: 600px) {
    .page-header {
      padding-top: var(--spacing-3xl);
      padding-bottom: var(--spacing-2xl);
    }

    .content-section {
      padding: var(--spacing-2xl) 0;
    }

    .policy-card {
      padding: var(--spacing-lg) !important;
    }
  }
</style>
