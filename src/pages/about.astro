---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="About Us - Free JSON Toolkit"
  description="Learn about Free JSON Toolkit, our mission to build fast, free, privacy-first developer utilities that run 100% locally in your browser."
  activePath="/about"
>
  <main>
    {/* Page Header */}
    <section class="page-header" aria-labelledby="about-title">
      <Container size="narrow" class="header-container">
        <span class="caption-mono section-eyebrow">ABOUT THE PROJECT</span>
        <h1 id="about-title" class="display-xl page-title">Free JSON Toolkit</h1>
        <p class="body-lg page-subtitle">
          Fast, free, and privacy-first developer utilities that process your data entirely in your
          browser.
        </p>
      </Container>
    </section>

    {/* Philosophy / Overview */}
    <section class="content-section" aria-labelledby="mission-title">
      <Container size="narrow">
        <div class="content-block">
          <h2 id="mission-title" class="display-md section-heading">Our Mission</h2>
          <p class="body-md text-content">
            Developers frequently need to format, validate, and convert data like JSON to CSV.
            However, many web-based tools require uploading this sensitive data to external servers,
            creating privacy risks and latency.
          </p>
          <p class="body-md text-content">
            Free JSON Toolkit is built to solve this problem. Our mission is to build fast, free,
            privacy-first developer utilities that process data locally. By executing all processing
            inside your browser sandbox, your datasets never leave your computer, ensuring absolute
            privacy and security.
          </p>
        </div>
      </Container>
    </section>

    {/* Why Free JSON Toolkit */}
    <section class="features-section" aria-labelledby="why-title">
      <Container size="narrow">
        <div class="section-header-align-left">
          <h2 id="why-title" class="display-md section-heading">Why Free JSON Toolkit?</h2>
          <p class="body-md section-intro">
            We aim to minimize unnecessary tracking while keeping the toolkit fast and
            privacy-focused. Here is what makes our tools different:
          </p>
        </div>

        <div class="grid-layout" role="list">
          <Card variant="flat" class="feature-card" role="listitem">
            <h3 class="display-sm feature-title">Free Forever</h3>
            <p class="body-sm feature-desc">
              No hidden fees, no limits, and no subscriptions. All tools are open and free to use
              for personal or commercial projects.
            </p>
          </Card>

          <Card variant="flat" class="feature-card" role="listitem">
            <h3 class="display-sm feature-title">Browser-Based</h3>
            <p class="body-sm feature-desc">
              All tools run locally inside your browser using JavaScript. No software to install and
              no external compilation required.
            </p>
          </Card>

          <Card variant="flat" class="feature-card" role="listitem">
            <h3 class="display-sm feature-title">Privacy-First</h3>
            <p class="body-sm feature-desc">
              Since execution happens entirely inside your local browser sandbox, your JSON data is
              never uploaded to any servers.
            </p>
          </Card>

          <Card variant="flat" class="feature-card" role="listitem">
            <h3 class="display-sm feature-title">No Account Required</h3>
            <p class="body-sm feature-desc">
              Skip the sign-up flow. Start converting and formatting data instantly without creating
              a profile.
            </p>
          </Card>

          <Card variant="flat" class="feature-card" role="listitem">
            <h3 class="display-sm feature-title">Fast</h3>
            <p class="body-sm feature-desc">
              No network uploads or server queues. Files and strings are processed instantly in
              memory.
            </p>
          </Card>
        </div>
      </Container>
    </section>

    {/* What's Next */}
    <section class="content-section border-top" aria-labelledby="next-title">
      <Container size="narrow">
        <div class="content-block">
          <h2 id="next-title" class="display-md section-heading">What's Next</h2>
          <p class="body-md text-content">
            We are actively expanding the toolkit to support more conversion and formatting
            workflows. Planned upcoming tools include a bidirectional CSV to JSON converter, a JSON
            validator to pinpoint syntax errors, and a custom JSON formatter.
          </p>
          <div class="cta-actions">
            <Button variant="primary" size="md" shape="square" href="/tools/json-to-csv">
              Try JSON → CSV Converter
            </Button>
            <Button variant="secondary" size="md" shape="square" href="/contact">
              Suggest a Tool
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--spacing-5xl);
    padding-bottom: var(--spacing-3xl);
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    text-align: center;
  }

  .header-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }

  .page-title {
    margin-top: 0;
    margin-bottom: var(--spacing-xxs);
    color: var(--color-ink);
  }

  .page-subtitle {
    color: var(--color-body);
    max-width: 600px;
    margin: 0;
    line-height: 1.6;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    background-color: var(--color-canvas);
  }

  .border-top {
    border-top: 1px solid var(--color-hairline);
  }

  .content-block {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .section-heading {
    color: var(--color-ink);
    margin-top: 0;
    margin-bottom: var(--spacing-xxs);
  }

  .text-content {
    color: var(--color-body);
    line-height: 1.7;
    margin: 0;
  }

  .features-section {
    padding: var(--spacing-4xl) 0;
    background-color: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  .section-header-align-left {
    margin-bottom: var(--spacing-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .section-intro {
    color: var(--color-body);
    margin: 0;
    max-width: 650px;
    line-height: 1.6;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
  }

  .feature-title {
    margin: 0;
    color: var(--color-ink);
  }

  .feature-desc {
    margin: 0;
    color: var(--color-body);
    line-height: 1.5;
  }

  .cta-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .grid-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .page-header {
      padding-top: var(--spacing-3xl);
      padding-bottom: var(--spacing-2xl);
    }

    .content-section,
    .features-section {
      padding: var(--spacing-2xl) 0;
    }

    .cta-actions {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .cta-actions > :global(a),
    .cta-actions > :global(button) {
      width: 100%;
    }
  }
</style>
