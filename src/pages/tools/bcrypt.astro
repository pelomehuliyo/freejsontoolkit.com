---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import HowItWorks from "../../components/tools/HowItWorks.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
import { COST_FACTORS } from "../../lib/tools/bcrypt/constants";
---

<ToolShell
  title="bcrypt Password Hasher — Free, Local, Secure"
  description="Generate secure bcrypt hashes for passwords with a configurable cost factor. 100% local, no upload. Salted, adaptive, worker-backed."
  activePath="/tools/bcrypt"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "bcrypt" }]}
    title="bcrypt Password Hasher"
    subtitle="Generate a salted, adaptive bcrypt hash for any password — locally in your browser."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <CodeEditor
          id="bcrypt-input"
          label="Password input"
          placeholder={"Enter a password to hash\n…or type any secret to generate a bcrypt hash"}
        >
          <div class="editor-info-bar">
            <span class="info-status" id="bcrypt-input-status">Status: Empty</span>
            <span class="info-meta" id="bcrypt-input-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <label class="settings-label caption-mono" for="bcrypt-cost">cost factor</label>
          <div class="select-wrapper">
            <select id="bcrypt-cost" class="select-control">
              {COST_FACTORS.map((c) => <option value={c.value}>{c.label}</option>)}
            </select>
          </div>
          <p class="settings-hint caption">
            Higher is slower to compute and harder to brute-force. 10 is the common default.
          </p>
        </div>

        <div class="settings-divider"></div>

        <Button id="bcrypt-run" variant="primary" size="lg" shape="square" class="action-btn">
          Generate
        </Button>
        <div class="bcrypt-readout" id="bcrypt-readout">
          <div class="bcrypt-row">
            <span class="bcrypt-label caption-mono">algorithm</span>
            <span class="bcrypt-val">bcrypt</span>
          </div>
          <div class="bcrypt-row">
            <span class="bcrypt-label caption-mono">salt</span>
            <span class="bcrypt-val">random, embedded</span>
          </div>
          <div class="bcrypt-row">
            <span class="bcrypt-label caption-mono">hash length</span>
            <span class="bcrypt-val">60 chars</span>
          </div>
        </div>
        <ErrorBanner id="bcrypt-error" />

        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="bcrypt-status-dot"></span></span
          >
          <span class="sr-only" id="bcrypt-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="bcrypt-output"
          label="bcrypt hash"
          placeholder="The hash appears here…"
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="bcrypt-output-status">Output: Empty</span>
            <span class="info-meta" id="bcrypt-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <HowItWorks
    heading="Generate a bcrypt hash in three steps"
    steps={[
      {
        title: "Enter a password",
        desc: "Type or paste the secret you want to hash — a password, a recovery code, an API secret.",
      },
      {
        title: "Pick the cost factor",
        desc: "Choose how expensive the hash should be. Higher cost means slower, safer hashing — 10 is the recommended default.",
      },
      {
        title: "Generate & store",
        desc: "Click Generate, then copy the hash. Every run draws a fresh random salt, so the same password never hashes twice alike.",
      },
    ]}
  />

  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />

  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-lg section-title">Quick answers</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my password uploaded?</summary>
          <p class="body-md faq-answer">
            No. Hashing runs entirely in your browser, in a background worker. Nothing you enter
            leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Why does the same password give a different hash?</summary>
          <p class="body-md faq-answer">
            bcrypt embeds a random salt in every hash, so identical passwords produce different
            hashes. That's intentional — it stops attackers from precomputing tables or spotting
            duplicate passwords in a database.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What does the cost factor do?</summary>
          <p class="body-md faq-answer">
            The cost factor controls how many rounds of key stretching bcrypt runs — 2^cost. Higher
            values take longer to compute but make brute-forcing far more expensive. 10 is the
            common default; use 11–12 for new systems. See the{" "}
            <a href="/compare/sha-256-vs-bcrypt">SHA-256 vs bcrypt comparison</a>.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Is bcrypt right for checking a file checksum?</summary>
          <p class="body-md faq-answer">
            No. bcrypt is for password storage. For checksums, fingerprints, and content
            verification use a fast hash like{" "}
            <a href="/tools/sha-256">SHA-256</a> or{" "}
            <a href="/tools/sha-512">SHA-512</a> instead.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { bcryptStore } from "../../lib/tools/bcrypt/store";
  import { setInput, setRounds, clearAll, convert, loadSample } from "../../lib/tools/bcrypt/actions";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const inTextarea = document.getElementById("bcrypt-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById(
    "bcrypt-output-textarea",
  ) as HTMLTextAreaElement | null;
  const inStatus = document.getElementById("bcrypt-input-status") as HTMLElement | null;
  const inCount = document.getElementById("bcrypt-input-count") as HTMLElement | null;
  const outStatus = document.getElementById("bcrypt-output-status") as HTMLElement | null;
  const outCount = document.getElementById("bcrypt-output-count") as HTMLElement | null;
  const runBtn = document.getElementById("bcrypt-run") as HTMLButtonElement | null;
  const costSel = document.getElementById("bcrypt-cost") as HTMLSelectElement | null;
  const errorBanner = document.getElementById("bcrypt-error") as HTMLElement | null;
  const statusDot = document.getElementById("bcrypt-status-dot") as HTMLElement | null;

  initAnnounce("bcrypt-announce");

  const debouncedInput = debounce((value: string) => {
    setInput(bcryptStore, value);
  }, 300);

  bcryptStore.subscribe((state) => {
    const focused = inTextarea && document.activeElement === inTextarea;
    if (inTextarea && inTextarea.value !== state.input && !focused) {
      inTextarea.value = state.input;
      inTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Cost reflection
    if (costSel && costSel.value !== String(state.rounds)) costSel.value = String(state.rounds);

    // Button state
    if (runBtn) {
      if (state.isRunning) {
        runBtn.disabled = true;
        runBtn.textContent = "Generating…";
      } else {
        runBtn.disabled = false;
        runBtn.textContent = "Generate";
      }
    }

    // Input status
    if (inStatus) {
      if (state.input.trim() === "") {
        inStatus.textContent = "Status: Empty";
        inStatus.style.color = "";
      } else if (state.error) {
        inStatus.textContent = "Status: Error";
        inStatus.style.color = "var(--color-error)";
      } else {
        inStatus.textContent = "Status: Ready";
        inStatus.style.color = "var(--color-success)";
      }
    }
    if (inCount) inCount.textContent = state.input.length.toLocaleString() + " chars";

    // Output area
    const hasResult = !!state.result;
    const outText = hasResult ? (state.result as string) : "";

    if (outTextarea && outTextarea.value !== outText) {
      outTextarea.value = outText;
      outTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    if (outStatus) {
      if (!hasResult) {
        outStatus.textContent = "Output: Empty";
        outStatus.style.color = "";
      } else {
        outStatus.textContent = "Output: bcrypt";
        outStatus.style.color = "var(--color-success)";
      }
    }
    if (outCount) outCount.textContent = outText.length.toLocaleString() + " chars";

    // Status dot
    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(
        state.isRunning ? "active" : hasResult ? "active" : state.error ? "error" : "idle",
      );
    }

    // Error banner
    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
  });

  if (inTextarea) inTextarea.addEventListener("input", () => debouncedInput(inTextarea.value));

  if (costSel) costSel.addEventListener("change", () => setRounds(bcryptStore, Number(costSel.value)));

  if (runBtn) runBtn.addEventListener("click", () => convert(bcryptStore));

  const inputActions = document.getElementById("input-actions");
  if (inputActions)
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(bcryptStore);
        announce("Sample loaded");
      }
      if (action === "clear") {
        clearAll(bcryptStore);
        announce("Cleared");
      }
    });

  const outputActions = document.getElementById("output-actions");
  if (outputActions)
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      const out = bcryptStore.get().result ?? "";

      if (action === "copy") {
        const ok = out ? await copyToClipboard(out) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("Hash copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        if (out) {
          downloadFile(out, "bcrypt-hash.txt", "text/plain;charset=utf-8;");
          announce("Download started");
        }
      }
    });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      convert(bcryptStore);
    }
  });
</script>

<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }
  .settings-card {
    padding: var(--spacing-lg);
  }
  .settings-title {
    margin: 0;
  }
  .settings-divider {
    height: 1px;
    background-color: var(--color-hairline);
    margin: var(--spacing-xs) 0;
  }
  .settings-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }
  .settings-label {
    color: var(--color-mute);
    font-size: 11px;
    font-weight: 600;
  }
  .settings-hint {
    color: var(--color-mute);
    font-size: 12px;
    line-height: 1.5;
  }
  .select-wrapper {
    width: 100%;
  }
  .select-control {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .bcrypt-readout {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bcrypt-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
  }
  .bcrypt-label {
    color: var(--color-mute);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex: none;
  }
  .bcrypt-val {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
  }

  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }

  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }
  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 320px;
      flex: 0 0 320px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
</style>