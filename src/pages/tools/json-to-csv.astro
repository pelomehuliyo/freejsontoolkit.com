      flex: 1 1 auto !important;
      min-height: 0 !important;
    }
    /* the card fills the wrapper — the rule that scoping was blocking */
    .ws-fill > .workspace-card {
      flex: 1 1 auto !important;
      height: auto !important;
      min-height: 0 !important;
    }
    /* push ONLY the CSV editor down so its top matches the JSON editor's
