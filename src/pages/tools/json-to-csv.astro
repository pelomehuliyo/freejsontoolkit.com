<style is:global>
  /* â”€â”€ Equal-height editor cards (desktop only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
     This block is intentionally GLOBAL (is:global), not scoped. The card we
     need to stretch is rendered by the <Card> component, so it never carries
     this page's scope tag — which is exactly why the scoped `.ws-fill > *` /
     `.ws-fill .workspace-card` rules could never make it grow (they couldn't
     "see" it). A global rule sees every element, so the card finally fills its
     wrapper, the CSV card becomes the same height as the JSON card, and
     `margin-top:auto` then has real free space to push the CSV editor down so
     its top lines up with the JSON editor. !important is a deliberate shield
     against the page's own `.workspace-card { height:100% }` (the percentage
     trap) — layout only, no visual side effects. */
  @media (min-width: 960px) {
    .workspace-grid.grid-3-col {
      align-items: stretch !important;
    }
    .workspace-col.input-col,
    .workspace-col.output-col {
