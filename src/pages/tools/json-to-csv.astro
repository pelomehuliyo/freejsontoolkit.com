---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
---

<ToolShell
  title="JSON to CSV Converter - Free JSON Toolkit"
  description="Convert nested JSON arrays into clean, structured CSV tables offline. 100% local browser-based JSON to CSV converter with support for flattening objects."
  activePath="/tools/json-to-csv"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "JSON to CSV" }]}
    title="JSON to CSV Converter"
    subtitle="Flatten and convert nested JSON arrays into clean CSV tables offline."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT JSON</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone id="json-input" accept=".json" label="Upload JSON file" />
        <CodeEditor
          id="json-input"
          label="JSON input"
          placeholder='Paste JSON array here
Example:
[
  { "id": 1, "name": "John Doe", "email": "john@example.com" },
  { "id": 2, "name": "Jane Smith", "email": "jane@example.com" }
]'
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="json-validation-status">JSON Status: Empty</span>
            <span class="info-meta" id="json-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <label class="settings-label caption-mono" for="delimiter-select">Delimiter</label>
          <div class="select-wrapper">
            <select id="delimiter-select" class="settings-select">
              <option value=",">Comma ( , )</option>
              <option value=";">Semicolon ( ; )</option>
              <option value="\t">Tab ( \t )</option>
            </select>
          </div>
        </div>

        <div class="settings-group checkbox-group">
          <label class="checkbox-container body-sm">
            <input type="checkbox" id="flatten-checkbox" checked />
            <span class="checkbox-checkmark"></span>
            Flatten nested objects
          </label>
          <p class="caption settings-help">
            Flattens properties like &#123;"user": &#123;"name": "John"&#125;&#125; to user.name
          </p>
        </div>

        <div class="settings-group checkbox-group">
          <label class="checkbox-container body-sm">
            <input type="checkbox" id="headers-checkbox" checked />
            <span class="checkbox-checkmark"></span>
            Include header row
          </label>
        </div>

        <div class="settings-divider"></div>

        <Button id="convert-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Convert JSON
        </Button>

        <ErrorBanner id="conversion-error" />

        <div class="status-banner caption">
          <span class="status-dot"></span> Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT CSV</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="csv-output"
          label="CSV output"
          placeholder="CSV output will appear here..."
          readonly
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="csv-status">CSV Status: Ready</span>
            <span class="info-meta" id="csv-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>
</ToolShell>

<script>
  import { jsonToCsvStore } from "../../lib/tools/json-to-csv/store";
  import {
    handleInput,
    convertJsonToCsv,
    cancelConversion,
    loadSample,
    clearAll,
    copyCsv,
    downloadCsv,
    setDelimiter,
    setFlatten,
    setIncludeHeaders,
  } from "../../lib/tools/json-to-csv/actions";
  import type { Delimiter } from "../../lib/tools/json-to-csv/types";

  // ── DOM refs ──
  const jsonTextarea = document.getElementById("json-input-textarea") as HTMLTextAreaElement | null;
  const jsonGutter = document.getElementById("json-input-gutter") as HTMLElement | null;
  const csvTextarea = document.getElementById("csv-output-textarea") as HTMLTextAreaElement | null;
  const csvGutter = document.getElementById("csv-output-gutter") as HTMLElement | null;
  const jsonStatus = document.getElementById("json-validation-status") as HTMLElement | null;
  const jsonCharCount = document.getElementById("json-char-count") as HTMLElement | null;
  const csvStatus = document.getElementById("csv-status") as HTMLElement | null;
  const csvCharCount = document.getElementById("csv-char-count") as HTMLElement | null;
  const delimiterSelect = document.getElementById("delimiter-select") as HTMLSelectElement | null;
  const flattenCheckbox = document.getElementById("flatten-checkbox") as HTMLInputElement | null;
  const headersCheckbox = document.getElementById("headers-checkbox") as HTMLInputElement | null;
  const convertBtn = document.getElementById("convert-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("conversion-error") as HTMLElement | null;

  // ── Copy button feedback ──
  let copyBtnEl: HTMLButtonElement | null = null;
  let origCopyText = "";

  // ── Input status display helpers ──
  function updateInputStatus(status: string, charCount: number) {
    if (!jsonStatus || !jsonCharCount) return;
    switch (status) {
      case "empty":
        jsonStatus.textContent = "JSON Status: Empty";
        jsonStatus.style.color = "";
        break;
      case "ready":
        jsonStatus.textContent = "JSON Status: Ready to convert";
        jsonStatus.style.color = "var(--color-success)";
        break;
      case "large-file-loaded":
        jsonStatus.textContent = "JSON Status: Large file loaded. Press Convert.";
        jsonStatus.style.color = "var(--color-accent)";
        break;
      case "invalid":
        jsonStatus.textContent = "JSON Status: Invalid";
        jsonStatus.style.color = "var(--color-error)";
        break;
      default:
        jsonStatus.textContent = "JSON Status: " + status;
        jsonStatus.style.color = "";
    }
    jsonCharCount.textContent = charCount.toLocaleString() + " chars";
  }

  function stageLabel(stage: string): string {
    switch (stage) {
      case "parsing":
        return "Parsing JSON…";
      case "flattening":
        return "Flattening objects…";
      case "formatting":
        return "Formatting CSV…";
      case "complete":
        return "Conversion complete";
      default:
        return "Converting…";
    }
  }

  function updateOutputStatus(
    status: string,
    charCount: number,
    progress?: { stage: string; percentage?: number } | null,
  ) {
    if (!csvStatus || !csvCharCount) return;
    switch (status) {
      case "empty":
      case "ready":
      case "generated":
        csvStatus.textContent = "CSV Status: Ready";
        break;
      case "generating":
        if (progress) {
          const label = stageLabel(progress.stage);
          csvStatus.textContent =
            progress.percentage != null ? `${label} (${progress.percentage}%)` : label;
        } else {
          csvStatus.textContent = "Converting JSON…";
        }
        break;
    }
    const suffix = charCount > 0 ? (charCount > 500000 ? " (Large Output)" : "") : "";
    csvCharCount.textContent = charCount.toLocaleString() + " chars" + suffix;
  }

  function updateConvertBtn(isConverting: boolean, isCancelling: boolean) {
    if (!convertBtn) return;
    if (isCancelling) {
      convertBtn.textContent = "Cancelling…";
      convertBtn.disabled = true;
    } else if (isConverting) {
      convertBtn.textContent = "Cancel";
      convertBtn.disabled = false;
    } else {
      convertBtn.textContent = "Convert JSON";
      convertBtn.disabled = false;
    }
  }

  function updateCopyDownload(disabled: boolean) {
    const copyBtn = document.querySelector(
      "#output-actions [data-action='copy']",
    ) as HTMLButtonElement | null;
    const downloadBtn = document.querySelector(
      "#output-actions [data-action='download']",
    ) as HTMLButtonElement | null;
    if (copyBtn) copyBtn.disabled = disabled;
    if (downloadBtn) downloadBtn.disabled = disabled;
  }

  function triggerGutter(el: HTMLTextAreaElement | null) {
    if (el && typeof (el as any).__updateGutter === "function") {
      (el as any).__updateGutter();
    }
  }

  // ── Store subscription ──
  const unsub = jsonToCsvStore.subscribe((state) => {
    // Update input textarea
    if (jsonTextarea && jsonTextarea.value !== state.jsonInput) {
      jsonTextarea.value = state.jsonInput;
      triggerGutter(jsonTextarea);
    }

    // Update output textarea
    if (csvTextarea && csvTextarea.value !== state.csvOutput) {
      csvTextarea.value = state.csvOutput;
      triggerGutter(csvTextarea);
    }

    // Update status displays
    updateInputStatus(state.inputStatus, state.jsonInput.length);
    updateOutputStatus(state.outputStatus, state.csvOutput.length, state.conversionProgress);

    // Update button states
    updateConvertBtn(state.isConverting, state.isCancelling);
    const hasOutput = !!state.csvOutput || !!state.largeCsvContent;
    updateCopyDownload(!hasOutput || state.isConverting);

    // Error display
    if (errorBanner) {
      if (state.error) {
        (errorBanner as any).show?.(state.error);
      } else {
        (errorBanner as any).hide?.();
      }
    }
  });

  // ── DragDropZone: file upload ──
  const dropZone = document.getElementById("json-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(jsonToCsvStore, detail.text);
      }
    });
  }

  // ── Input editor: manual input ──
  if (jsonTextarea) {
    jsonTextarea.addEventListener("input", () => {
      handleInput(jsonToCsvStore, jsonTextarea.value);
    });

    jsonTextarea.addEventListener("paste", (e: ClipboardEvent) => {
      const pasteText = e.clipboardData?.getData("text") || "";
      if (pasteText.length > 500000) {
        e.preventDefault();
        handleInput(jsonToCsvStore, pasteText);
      }
    });
  }

  // ── Convert / Cancel button ──
  if (convertBtn) {
    convertBtn.addEventListener("click", () => {
      const state = jsonToCsvStore.get();
      if (state.isConverting) {
        cancelConversion(jsonToCsvStore);
      } else {
        convertJsonToCsv(jsonToCsvStore);
      }
    });
  }

  // ── Settings changes ──
  if (delimiterSelect) {
    delimiterSelect.addEventListener("change", () => {
      setDelimiter(jsonToCsvStore, delimiterSelect.value as Delimiter);
    });
  }

  if (flattenCheckbox) {
    flattenCheckbox.addEventListener("change", () => {
      setFlatten(jsonToCsvStore, flattenCheckbox.checked);
    });
  }

  if (headersCheckbox) {
    headersCheckbox.addEventListener("change", () => {
      setIncludeHeaders(jsonToCsvStore, headersCheckbox.checked);
    });
  }

  // ── ToolActions ──
  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") loadSample(jsonToCsvStore);
      if (action === "clear") clearAll(jsonToCsvStore);
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "copy") {
        const ok = await copyCsv(jsonToCsvStore);
        if (ok) {
          const copyBtn = outputActions.querySelector("[data-action='copy']");
          if (copyBtn) {
            const orig = copyBtn.textContent || "Copy";
            copyBtn.textContent = "Copied!";
            setTimeout(() => {
              copyBtn.textContent = orig;
            }, 1500);
          }
        }
      }
      if (action === "download") downloadCsv(jsonToCsvStore);
    });
  }
</script>

<style>
  .tool-section {
    padding: var(--spacing-3xl) 0;
  }

  .tool-header {
    margin-bottom: var(--spacing-md);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
    margin-bottom: var(--spacing-xs);
  }

  .breadcrumb-link {
    font-size: 12px;
    color: var(--color-mute);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--color-ink);
  }

  .breadcrumb-separator {
    font-size: 11px;
    color: var(--color-hairline-strong);
  }

  .breadcrumb-current {
    font-size: 12px;
    color: var(--color-ink);
    font-weight: 500;
  }

  .tool-title {
    margin-bottom: var(--spacing-xxs);
  }

  .tool-subtitle {
    color: var(--color-body);
    margin: 0;
  }

  /* Privacy Notice */
  .privacy-notice {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    margin-bottom: var(--spacing-xl);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .privacy-notice p {
    color: var(--color-body);
    margin: 0;
  }

  .privacy-icon {
    font-size: 14px;
  }

  /* Workspace Layout */
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }

  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    margin-top: -8px;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }

  .info-status {
    font-weight: 500;
  }

  /* Settings Side Card */
  .settings-card {
    padding: var(--spacing-lg);
  }

  .settings-title {
    margin: 0;
  }

  .settings-divider {
    height: 1px;
    background-color: var(--color-hairline);
    margin: var(--spacing-xs) 0;
  }

  .settings-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }

  .settings-label {
    color: var(--color-mute);
    font-size: 11px;
    font-weight: 600;
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .settings-select {
    width: 100%;
    height: 38px;
    padding: 0 var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    appearance: none;
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .settings-select:focus {
    border-color: var(--color-hairline-strong);
  }

  .select-wrapper::after {
    content: "▼";
    font-size: 9px;
    color: var(--color-body);
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* Checkboxes */
  .checkbox-group {
    margin-bottom: var(--spacing-sm);
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 24px;
    cursor: pointer;
    user-select: none;
    color: var(--color-ink);
  }

  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  .checkbox-checkmark {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 0;
    height: 16px;
    width: 16px;
    border: 1px solid var(--color-hairline-strong);
    border-radius: 4px;
    background-color: var(--color-canvas);
    transition:
      background-color 0.1s ease,
      border-color 0.1s ease;
  }

  .checkbox-container:hover input ~ .checkbox-checkmark {
    border-color: var(--color-ink);
  }

  .checkbox-container input:checked ~ .checkbox-checkmark {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .checkbox-checkmark::after {
    content: "";
    position: absolute;
    display: none;
  }

  .checkbox-container input:checked ~ .checkbox-checkmark::after {
    display: block;
  }

  .checkbox-container .checkbox-checkmark::after {
    left: 5px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .settings-help {
    color: var(--color-mute);
    margin: 4px 0 0 24px;
    line-height: 1.4;
  }

  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }

  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: #29bc9b;
  }

  @media (min-width: 960px) {
    .workspace-card .editor-outer {
      flex: none;
      height: 650px;
      min-height: 650px;
    }

    .workspace-card .editor-wrapper {
      height: 100%;
    }
  }

  @media (max-width: 959px) {
    .workspace-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
      height: auto;
      align-items: start;
      min-width: 0;
      overflow-x: hidden;
    }

    .workspace-card {
      height: auto;
      min-width: 0;
    }

    .workspace-col {
      min-width: 0;
    }

    .privacy-notice {
      display: flex;
    }

    .tool-section {
      overflow-x: hidden;
      min-width: 0;
    }

    .workspace-card .editor-outer {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }

    .workspace-card .editor-outer {
      overflow: hidden;
    }

    .workspace-card .editor-wrapper {
      flex: 1 1 auto;
      min-height: 0;
    }

    .workspace-card .editor-info-bar {
      margin-top: 0;
      flex: 0 0 auto;
      min-height: 0;
    }

    .workspace-card .editor-textarea {
      height: 100%;
      overflow: auto;
    }

    .workspace-card .editor-gutter {
      min-width: 0;
    }
  }
</style>
