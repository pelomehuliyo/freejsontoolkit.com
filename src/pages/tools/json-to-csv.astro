---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import HowItWorks from "../../components/tools/HowItWorks.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { DELIMITER_OPTIONS } from "../../lib/tools/json-to-csv/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
import "../../styles/tool-options.css";
---

<ToolShell
  title="JSON to CSV Converter — Convert JSON to CSV Online (Free, Local)"
  description="Free online JSON to CSV converter. Flatten nested JSON arrays into clean CSV tables — 100% local, no upload, no server. Supports custom delimiters, flattening, and header rows."
  activePath="/tools/json-to-csv"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "JSON to CSV" }]}
    title="JSON to CSV Converter"
    subtitle="Flatten nested JSON arrays into clean CSV tables."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT JSON</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone id="json-input" accept=".json" label="Upload JSON file" />
        <CodeEditor
          id="json-input"
          label="JSON input"
          placeholder='Paste JSON array here
Example:
[
  { "id": 1, "name": "John Doe", "email": "john@example.com" },
  { "id": 2, "name": "Jane Smith", "email": "jane@example.com" }
]'
        >
          <div class="editor-info-bar">
            <span class="info-status" id="json-validation-status">Status: Empty</span>
            <span class="info-meta" id="json-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <span class="settings-label">Delimiter</span>
          <div class="seg" id="delimiter-select" role="group" aria-label="Delimiter">
            {DELIMITER_OPTIONS.map((opt) => (
              <button type="button" class="seg-btn" data-value={opt.value}>
                {opt.label}
              </button>
            ))}
          </div>
        </div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="flatten-checkbox" checked={true} />
            <span class="box"></span>
            Flatten nested objects
          </label>
          <p class="settings-help">
            Flattens properties like &#123;"user": &#123;"name": "John"&#125;&#125; to user.name
          </p>
        </div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="headers-checkbox" checked={true} />
            <span class="box"></span>
            Include header row
          </label>
        </div>

        <div class="settings-divider"></div>

        <div class="convert-actions">
          <Button id="convert-btn" variant="primary" size="lg" shape="square" class="action-btn">
            Convert
          </Button>
          <Button
            id="cancel-btn"
            variant="secondary"
            size="lg"
            shape="square"
            class="cancel-btn"
            type="button"
            hidden
          >
            Cancel
          </Button>
        </div>

        <!-- Progress Section (visible only during conversion) -->
        <div id="progress-section" class="progress-section hidden">
          <div class="progress-stage-labels" id="stage-labels" role="status" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            <span id="progress-text" class="caption">Starting conversion…</span>
          </div>
          <div
            class="progress-bar-track"
            role="progressbar"
            aria-valuenow="0"
            aria-valuemin="0"
            aria-valuemax="100"
            id="progress-bar"
            aria-label="Conversion progress"
          >
            <div class="progress-bar-fill indeterminate" id="progress-fill"></div>
          </div>
          <div class="stage-stepper" id="stage-stepper" aria-hidden="true">
            <span class="stage-step" data-stage="parsing">
              <span class="stage-dot"></span>Parse
            </span>
            <span class="stage-connector" data-connector="parsing-flattening"></span>
            <span class="stage-step" data-stage="flattening">
              <span class="stage-dot"></span>Flatten
            </span>
            <span class="stage-connector" data-connector="flattening-formatting"></span>
            <span class="stage-step" data-stage="formatting">
              <span class="stage-dot"></span>Format
            </span>
          </div>
        </div>

        <ErrorBanner id="conversion-error" />

        <div class="status-banner caption">
          <span class="status-indicator">
            <span class="dot idle" id="status-dot"></span>
          </span>
          <span class="sr-only" id="status-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT CSV</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <div class="output-notice hidden" id="csv-notice" role="status" aria-live="polite"></div>
        <CodeEditor
          id="csv-output"
          label="CSV output"
          placeholder="CSV output will appear here..."
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="csv-status">Output: Empty</span>
            <span class="info-meta" id="csv-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <HowItWorks
    heading="Three steps to convert JSON to CSV"
    steps={[
      {
        title: "Paste or upload",
        desc: "Paste your JSON array or upload a .json file. We support files up to 15M characters.",
      },
      {
        title: "Configure options",
        desc: "Choose delimiter (comma, semicolon, tab), toggle flattening for nested objects, and decide whether to include headers.",
      },
      {
        title: "Convert & export",
        desc: "Click Convert to transform your JSON into clean CSV. Copy to clipboard or download as a .csv file — all offline.",
      },
    ]}
  />

  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />

  <!-- FAQ Section -->
  <section class="faq-section" aria-labelledby="faq-title-2">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title-2" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my JSON data uploaded to a server?</summary>
          <p class="body-md faq-answer">
            No. Everything runs locally in your browser. Your JSON is never sent to any server — the
            conversion happens 100% client-side using a Web Worker for large files.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What is the maximum file size?</summary>
          <p class="body-md faq-answer">
            The tool accepts JSON inputs up to 15 million characters. For files above 500K
            characters, a preview is shown and the full content is used only when you click Convert.
            Files above 5M characters trigger a confirmation dialog before processing.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">How does object flattening work?</summary>
          <p class="body-md faq-answer">
            When flattening is enabled, nested objects are expanded using dot notation. For example, <code
              >&#123;"user": &#123;"name": "John"&#125;&#125;</code
            > becomes a column named <code>user.name</code> with value <code>John</code>. This
            ensures deeply nested JSON is represented as flat CSV columns.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Which delimiters are supported?</summary>
          <p class="body-md faq-answer">
            You can choose between comma (,), semicolon (;), and tab (\\t) delimiters. The default
            is comma, which works with most spreadsheet applications like Excel and Google Sheets.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Can I cancel a running conversion?</summary>
          <p class="body-md faq-answer">
            Yes. During conversion, a Cancel button appears beside Convert. Click it to stop the
            conversion. For large files using a Web Worker, cancellation also terminates the worker
            thread to free memory.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Does the tool work offline?</summary>
          <p class="body-md faq-answer">
            After the initial page load, the tool works offline — there is no server-side dependency
            for the conversion logic. All processing is built into the JavaScript bundle.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { jsonToCsvStore } from "../../lib/tools/json-to-csv/store";
  import {
    handleInput,
    convertJsonToCsv,
    cancelConversion,
    loadSample,
    clearAll,
    getCsvContent,
    setDelimiter,
    setFlatten,
    setIncludeHeaders,
  } from "../../lib/tools/json-to-csv/actions";
  import type { Delimiter } from "../../lib/tools/json-to-csv/types";
  import { STAGE_LABELS, STAGE_ORDER } from "../../lib/tools/json-to-csv/constants";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  // â”€â”€ DOM refs â”€â”€
  const jsonTextarea = document.getElementById("json-input-textarea") as HTMLTextAreaElement | null;
  const csvTextarea = document.getElementById("csv-output-textarea") as HTMLTextAreaElement | null;
  const jsonStatus = document.getElementById("json-validation-status") as HTMLElement | null;
  const jsonCharCount = document.getElementById("json-char-count") as HTMLElement | null;
  const csvStatus = document.getElementById("csv-status") as HTMLElement | null;
  const csvCharCount = document.getElementById("csv-char-count") as HTMLElement | null;
  const csvNotice = document.getElementById("csv-notice") as HTMLElement | null;
  const delimiterSeg = document.getElementById("delimiter-select") as HTMLElement | null;
  const delimiterBtns = delimiterSeg
    ? (Array.from(delimiterSeg.querySelectorAll("[data-value]")) as HTMLButtonElement[])
    : [];
  const flattenCheckbox = document.getElementById("flatten-checkbox") as HTMLInputElement | null;
  const headersCheckbox = document.getElementById("headers-checkbox") as HTMLInputElement | null;
  const convertBtn = document.getElementById("convert-btn") as HTMLButtonElement | null;
  const cancelBtn = document.getElementById("cancel-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("conversion-error") as HTMLElement | null;
  const progressSection = document.getElementById("progress-section") as HTMLElement | null;
  const progressText = document.getElementById("progress-text") as HTMLElement | null;
  const progressFill = document.getElementById("progress-fill") as HTMLElement | null;
  const progressBar = document.getElementById("progress-bar") as HTMLElement | null;
  const stageStepper = document.getElementById("stage-stepper") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;
  const statusAnnounce = document.getElementById("status-announce") as HTMLElement | null;

  // â”€â”€ Initialise shared utilities â”€â”€
  initAnnounce("status-announce");

  // â”€â”€ Throttle helpers for progress updates â”€â”€
  let rafId = 0;
  let announceTimer: number | null = null;

  function throttleDomUpdate(fn: () => void): void {
    if (rafId) return;
    rafId = requestAnimationFrame(() => {
      rafId = 0;
      fn();
    });
  }

  /** Sync aria-hidden with a hidden class toggle on an element */
  function syncAriaHidden(el: HTMLElement | null, hidden: boolean): void {
    if (!el) return;
    if (hidden) {
      el.classList.add("hidden");
      el.setAttribute("aria-hidden", "true");
    } else {
      el.classList.remove("hidden");
      el.removeAttribute("aria-hidden");
    }
  }

  /**
   * Throttled screen reader announcement for progress stage changes.
   * Only announces when the stage changes, not every percentage update.
   */
  let lastAnnouncedStage: string | null = null;
  let lastAnnouncedPreview: string | null = null;
  function announceProgressStage(stage: string | null, percentage?: number | null): void {
    if (!statusAnnounce) return;
    if (!stage) return;
    if (stage === lastAnnouncedStage && percentage == null) return;
    lastAnnouncedStage = stage;

    if (announceTimer) clearTimeout(announceTimer);
    announceTimer = window.setTimeout(() => {
      const label = STAGE_LABELS[stage] || stage;
      const pct = percentage != null ? ` (${percentage}%)` : "";
      statusAnnounce.textContent = `Conversion: ${label}${pct}`;
      announceTimer = null;
    }, 300);
  }

  // â”€â”€ Input status display helpers â”€â”€
  function updateInputStatus(status: string, charCount: number) {
    throttleDomUpdate(() => {
      if (!jsonStatus || !jsonCharCount) return;
      switch (status) {
        case "empty":
          jsonStatus.textContent = "Status: Empty";
          jsonStatus.style.color = "";
          break;
        case "ready":
          jsonStatus.textContent = "Status: Ready";
          jsonStatus.style.color = "var(--color-success)";
          break;
        case "large-file-loaded":
          jsonStatus.textContent = "Status: Large file ready";
          jsonStatus.style.color = "var(--color-accent)";
          break;
        case "invalid":
          jsonStatus.textContent = "Status: Invalid";
          jsonStatus.style.color = "var(--color-error)";
          break;
        default:
          jsonStatus.textContent = "Status: " + status;
          jsonStatus.style.color = "";
      }
      jsonCharCount.textContent = charCount.toLocaleString() + " chars";
    });
  }

  function updateStageStepper(currentStage: string | null): void {
    if (!stageStepper) return;
    const steps = stageStepper.querySelectorAll(".stage-step");
    const connectors = stageStepper.querySelectorAll(".stage-connector");

    let activeFound = false;
    const order = STAGE_ORDER;

    steps.forEach((step) => {
      const stage = step.getAttribute("data-stage");
      step.classList.remove("active", "done");

      if (!activeFound && stage === currentStage) {
        step.classList.add("active");
        activeFound = true;
      } else if (!activeFound) {
        step.classList.add("done");
      }
    });

    connectors.forEach((conn) => {
      conn.classList.remove("done");
      const isDone = true;
      for (const s of order) {
        if (s === currentStage) break;
        if (s === conn.getAttribute("data-connector")?.split("-")[0]) {
          break;
        }
      }
      // Mark connectors for stages before current as done
      const connParts = conn.getAttribute("data-connector")?.split("-") || [];
      const beforeStage = connParts[0];
      if (beforeStage && order.indexOf(beforeStage as any) < order.indexOf(currentStage as any)) {
        conn.classList.add("done");
      }
    });
  }

  function updateProgressUI(
    isConverting: boolean,
    isCancelling: boolean,
    progress?: { stage: string; percentage?: number } | null,
  ): void {
    throttleDomUpdate(() => {
      if (!progressSection || !progressText || !progressFill || !progressBar) return;

      if (isCancelling) {
        syncAriaHidden(progressSection, false);
        progressText.textContent = "Cancelling…";
        progressFill.className = "progress-bar-fill";
        progressFill.style.width = "0%";
        progressBar.setAttribute("aria-valuenow", "0");
        return;
      }

      if (isConverting) {
        syncAriaHidden(progressSection, false);

        if (progress) {
          const label = STAGE_LABELS[progress.stage] || "Converting…";
          const pct =
            progress.percentage != null ? Math.min(100, Math.max(0, progress.percentage)) : null;
          progressText.innerHTML = `<span class="spinner" aria-hidden="true"></span> ${label}${pct != null ? ` (${pct}%)` : "…"}`;

          if (pct != null) {
            progressFill.className = "progress-bar-fill";
            progressFill.style.width = pct + "%";
            progressBar.setAttribute("aria-valuenow", String(pct));
          } else {
            progressFill.className = "progress-bar-fill indeterminate";
            progressFill.style.width = "";
            progressBar.setAttribute("aria-valuenow", "0");
          }

          updateStageStepper(progress.stage);
          announceProgressStage(progress.stage, pct);
        } else {
          progressText.innerHTML = '<span class="spinner" aria-hidden="true"></span> Converting…';
          progressFill.className = "progress-bar-fill indeterminate";
          progressFill.style.width = "";
          progressBar.setAttribute("aria-valuenow", "0");
        }
      } else {
        syncAriaHidden(progressSection, true);
        progressFill.className = "progress-bar-fill";
        progressFill.style.width = "0%";
        progressBar.setAttribute("aria-valuenow", "0");
        updateStageStepper(null);
        lastAnnouncedStage = null;
      }
    });
  }

  function updateOutputStatus(
    status: string,
    charCount: number,
    progress?: { stage: string; percentage?: number } | null,
    previewNote?: string | null,
  ) {
    throttleDomUpdate(() => {
      if (!csvStatus || !csvCharCount) return;
      switch (status) {
        case "empty":
          csvStatus.textContent = "Output: Empty";
          break;
        case "ready":
        case "generated":
          csvStatus.textContent = previewNote
            ? `Output: Preview — ${previewNote}`
            : "Output: Ready";
          break;
        case "generating":
          if (progress) {
            const label = STAGE_LABELS[progress.stage] || "Converting";
            csvStatus.textContent =
              progress.percentage != null
                ? `Output: ${label} (${progress.percentage}%)`
                : `Output: ${label}…`;
          } else {
            csvStatus.textContent = "Output: Converting…";
          }
          break;
      }
      if (previewNote) {
        csvCharCount.textContent = charCount.toLocaleString() + " chars preview";
      } else {
        const suffix = charCount > 0 ? (charCount > 500000 ? " (Large Output)" : "") : "";
        csvCharCount.textContent = charCount.toLocaleString() + " chars" + suffix;
      }
    });
  }

  function updateConvertBtn(isConverting: boolean, isCancelling: boolean) {
    if (convertBtn) {
      if (isConverting || isCancelling) {
        convertBtn.textContent = "Converting…";
        convertBtn.disabled = true;
      } else {
        convertBtn.textContent = "Convert";
        convertBtn.disabled = false;
      }
    }
    if (cancelBtn) {
      const showCancel = isConverting && !isCancelling;
      cancelBtn.hidden = !showCancel;
      cancelBtn.setAttribute("aria-hidden", showCancel ? "false" : "true");
      cancelBtn.disabled = isCancelling;
    }
  }

  function updateCopyDownload(disabled: boolean) {
    const copyBtn = document.querySelector(
      "#output-actions [data-action='copy']",
    ) as HTMLButtonElement | null;
    const downloadBtn = document.querySelector(
      "#output-actions [data-action='download']",
    ) as HTMLButtonElement | null;
    if (copyBtn) copyBtn.disabled = disabled;
    if (downloadBtn) downloadBtn.disabled = disabled;
  }

  function updateStatusDot(inputState: string, isConverting: boolean): void {
    throttleDomUpdate(() => {
      if (!statusDot) return;
      statusDot.classList.remove("idle", "active", "error");
      if (isConverting) {
        statusDot.classList.add("active");
      } else if (inputState === "invalid") {
        statusDot.classList.add("error");
      } else {
        statusDot.classList.add("idle");
      }
    });
  }

  // â”€â”€ Focus management â”€â”€
  function focusErrorBanner(): void {
    if (errorBanner && !errorBanner.classList.contains("hidden")) {
      (errorBanner as any).focus?.();
      const closeBtn = errorBanner.querySelector(".error-close") as HTMLButtonElement | null;
      closeBtn?.focus();
    }
  }

  function focusConvertBtn(): void {
    convertBtn?.focus();
  }

  // â”€â”€ Keyboard shortcuts â”€â”€
  function handleKeyboardShortcuts(e: KeyboardEvent): void {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      const state = jsonToCsvStore.get();
      if (!state.isConverting && !state.isCancelling) {
        convertJsonToCsv(jsonToCsvStore);
      }
    }
  }

  // â”€â”€ Cancel-tracking flag for focus management â”€â”€
  let wasCancelling = false;

  // â”€â”€ Store subscription â”€â”€
  const unsub = jsonToCsvStore.subscribe((state) => {
    // Update input textarea — skip writeback while user is actively typing
    // to prevent cursor position reset and focus loss
    const inputFocused = jsonTextarea && document.activeElement === jsonTextarea;
    if (jsonTextarea && jsonTextarea.value !== state.jsonInput && !inputFocused) {
      jsonTextarea.value = state.jsonInput;
      jsonTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Update output textarea (only when value actually changed — preserves cursor/selection)
    if (csvTextarea && csvTextarea.value !== state.csvOutput) {
      csvTextarea.value = state.csvOutput;
      csvTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Update status displays
    updateInputStatus(state.inputStatus, state.jsonInput.length);
    updateOutputStatus(
      state.outputStatus,
      state.csvOutput.length,
      state.conversionProgress,
      state.isPreview ? state.outputNotice : null,
    );
    updateProgressUI(state.isConverting, state.isCancelling, state.conversionProgress);
    updateStatusDot(state.inputStatus, state.isConverting);

    if (delimiterBtns.length) {
      delimiterBtns.forEach((b) => {
        b.classList.toggle("is-active", b.dataset.value === state.delimiter);
      });
    }

    // Update button states
    updateConvertBtn(state.isConverting, state.isCancelling);
    const hasOutput = !!state.csvOutput || !!state.largeCsvContent;
    updateCopyDownload(!hasOutput || state.isConverting);

    // Focus management & screen reader announcements
    if (state.outputStatus === "generating") {
      lastAnnouncedPreview = null;
    }
    if (state.outputStatus === "generated" && !state.isConverting) {
      if (state.isPreview && state.outputNotice && state.outputNotice !== lastAnnouncedPreview) {
        lastAnnouncedPreview = state.outputNotice;
        announce("Conversion complete. " + state.outputNotice + ".");
      } else {
        announce("Conversion complete. CSV output is ready.");
      }
    }

    if (state.error) {
      announce("Error: " + state.error);
      focusErrorBanner();
    }

    if (state.isConverting && !state.isCancelling) {
      announce("Conversion in progress");
    }

    if (state.isCancelling) {
      wasCancelling = true;
      announce("Cancelling conversion");
    }

    // Return focus to convert button only after an explicit cancel completes
    if (wasCancelling && !state.isConverting && !state.isCancelling) {
      wasCancelling = false;
      focusConvertBtn();
    }

    // Output notice banner: hidden in preview mode (the scale note now lives in
    // the status line); kept for non-preview notices such as the empty-array case.
    // An option changed after a large CSV preview marks the outcome stale.
    if (csvNotice) {
      if (state.staleOptions) {
        csvNotice.textContent = "Options changed — convert again.";
        syncAriaHidden(csvNotice, false);
        csvNotice.className = "output-notice visible warn-notice";
      } else if (state.outputNotice && !state.isPreview) {
        csvNotice.textContent = state.outputNotice;
        syncAriaHidden(csvNotice, false);
        csvNotice.className = "output-notice visible info-notice";
      } else {
        syncAriaHidden(csvNotice, true);
      }
    }

    // Set aria-busy on the workspace section (not just controls)
    const workspace = document.querySelector("#workspace-heading") as HTMLElement | null;
    if (workspace && workspace.parentElement) {
      workspace.parentElement.setAttribute("aria-busy", String(state.isConverting));
    }

    // Error display
    if (errorBanner) {
      if (state.error) {
        (errorBanner as any).show?.(state.error);
      } else {
        (errorBanner as any).hide?.();
      }
    }
  });

  // â”€â”€ DragDropZone: file upload â”€â”€
  const dropZone = document.getElementById("json-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(jsonToCsvStore, detail.text);
        announce("File loaded: " + (detail.name || "file"));
      }
    });
  }

  // â”€â”€ Input editor: manual input (debounced for performance) â”€â”€
  const debouncedInput = debounce((value: string) => {
    handleInput(jsonToCsvStore, value);
  }, 150);

  if (jsonTextarea) {
    jsonTextarea.addEventListener("input", () => {
      debouncedInput(jsonTextarea.value);
    });

    jsonTextarea.addEventListener("paste", (e: ClipboardEvent) => {
      const pasteText = e.clipboardData?.getData("text") || "";
      if (pasteText.length > 500000) {
        e.preventDefault();
        handleInput(jsonToCsvStore, pasteText);
        announce("Large paste detected (" + pasteText.length.toLocaleString() + " chars)");
      }
    });
  }

  // â”€â”€ Convert / Cancel buttons â”€â”€
  if (convertBtn) {
    convertBtn.addEventListener("click", () => {
      const state = jsonToCsvStore.get();
      if (!state.isConverting && !state.isCancelling) {
        convertJsonToCsv(jsonToCsvStore);
      }
    });
  }
  if (cancelBtn) {
    cancelBtn.addEventListener("click", () => {
      const state = jsonToCsvStore.get();
      if (state.isConverting && !state.isCancelling) {
        cancelConversion(jsonToCsvStore);
      }
    });
  }

  // â”€â”€ Settings changes â”€â”€
  if (delimiterBtns.length) {
    delimiterBtns.forEach((b) => {
      b.addEventListener("click", () => {
        setDelimiter(jsonToCsvStore, b.dataset.value as Delimiter);
      });
    });
  }

  if (flattenCheckbox) {
    flattenCheckbox.addEventListener("change", () => {
      setFlatten(jsonToCsvStore, flattenCheckbox.checked);
    });
  }

  if (headersCheckbox) {
    headersCheckbox.addEventListener("change", () => {
      setIncludeHeaders(jsonToCsvStore, headersCheckbox.checked);
    });
  }

  // â”€â”€ ToolActions â”€â”€
  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(jsonToCsvStore);
        announce("Sample JSON loaded");
      }
      if (action === "clear") {
        clearAll(jsonToCsvStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "copy") {
        const csv = getCsvContent(jsonToCsvStore);
        const ok = csv ? await copyToClipboard(csv) : false;
        const copyBtn = outputActions.querySelector("[data-action='copy']");
        if (ok) {
          if (copyBtn) {
            const orig = copyBtn.textContent || "Copy";
            copyBtn.textContent = "Copied!";
            announce("CSV copied to clipboard");
            setTimeout(() => {
              copyBtn.textContent = orig;
            }, 1500);
          }
        } else {
          announce("Failed to copy CSV");
        }
      }
      if (action === "download") {
        const csv = getCsvContent(jsonToCsvStore);
        if (csv) {
          downloadFile(csv, "json-to-csv-data.csv", "text/csv;charset=utf-8;");
          announce("CSV download started");
        }
      }
    });
  }

  // â”€â”€ Keyboard shortcuts (global) â”€â”€
  document.addEventListener("keydown", handleKeyboardShortcuts);
</script>

