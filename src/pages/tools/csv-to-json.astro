---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import HowItWorks from "../../components/tools/HowItWorks.astro";
import LearnLinks from "../../components/tools/LearnLinks.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import {
  DELIMITER_OPTIONS,
  INDENT_OPTIONS,
  LARGE_FILE_THRESHOLD_BYTES,
} from "../../lib/tools/csv-to-json/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
import "../../styles/tool-options.css";
---

<ToolShell
  title="CSV to JSON Converter — Convert CSV to JSON Online (Free, Local)"
  description="Free online CSV to JSON converter. Turn CSV tables into structured JSON arrays with auto delimiter detection and header inference — 100% local, no upload, no server."
  activePath="/tools/csv-to-json"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "CSV to JSON" }]}
    title="CSV → JSON Converter"
    subtitle="Turn CSV tables into structured JSON arrays."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT CSV</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone
          id="csv-input"
          accept=".csv,.txt"
          label="Upload CSV file"
          largeThresholdBytes={LARGE_FILE_THRESHOLD_BYTES}
        />
        <CodeEditor
          id="csv-input"
          label="CSV input"
          placeholder="Paste CSV here to convert it
Example:
id,name,email
1,Ada,ada@example.com"
        >
          <div class="editor-info-bar">
            <span class="info-status" id="csv-validation-status">Status: Empty</span>
            <span class="info-meta" id="csv-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <span class="settings-label">Delimiter</span>
          <div class="seg" id="delimiter-select" role="group" aria-label="Delimiter">
            {
              DELIMITER_OPTIONS.map((opt) => (
                <button type="button" class="seg-btn" data-value={opt.value}>
                  {opt.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="settings-group">
          <span class="settings-label">Output indentation</span>
          <div class="seg" id="indent-select" role="group" aria-label="Output indentation">
            {
              INDENT_OPTIONS.map((opt) => (
                <button type="button" class="seg-btn" data-value={opt.value}>
                  {opt.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="has-header-checkbox" checked />
            <span class="box"></span>
            First row is a header
          </label>
          <p class="settings-help">Use the first row as object keys.</p>
        </div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="skip-empty-checkbox" checked />
            <span class="box"></span>
            Skip empty lines
          </label>
        </div>

        <div class="settings-divider"></div>

        <Button id="convert-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Convert to JSON
        </Button>

        <ErrorBanner id="convert-error" />

        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="status-dot"></span></span>
          <span class="status-phase" id="convert-phase" aria-hidden="true"></span>
          <span class="sr-only" id="convert-status-announce" aria-live="polite"></span>
          <span id="convert-status-text">Local sandbox active</span>
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT JSON</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="json-output"
          label="JSON output"
          placeholder="JSON output will appear here..."
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="json-output-status">Output: Empty</span>
            <span class="info-meta" id="json-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <HowItWorks
    heading="Convert CSV to JSON in three steps"
    steps={[
      {
        title: "Paste or upload",
        desc: "Drop in CSV: comma, semicolon, tab, or pipe delimited. We auto-detect.",
      },
      { title: "Set options", desc: "Choose delimiter, header handling, and output indentation." },
      {
        title: "Convert & export",
        desc: "Click Convert, then copy or download the JSON array. All offline.",
      },
    ]}
  />

  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />
  <LearnLinks toolId="csv-to-json" />

  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">How does the large-file mode work?</summary>
          <p class="body-md faq-answer">
            If you drop a file larger than 15 MB, the tool switches to a background worker. It reads
            the file off the main thread, converts it in one pass, and gives you a capped preview in
            the editor. The full result is always available as a download. Nothing is uploaded.
            <a href="/large-files" style="color: var(--color-accent); font-weight: 500;"
              >Read the honest limits in our large-file guide →</a
            >
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Is my CSV uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Conversion happens entirely in your browser. Your data never leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Can it handle large CSV files?</summary>
          <p class="body-md faq-answer">
            Yes. Files above about 15 MB switch to a dedicated large-file mode: the file is read and
            converted in a background worker, you see a capped preview in the editor, and the full
            JSON is a one-click download. Nothing is uploaded. The only ceiling is your device's
            memory. <a href="/large-files">See how large-file mode works →</a>
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Which delimiters are supported?</summary>
          <p class="body-md faq-answer">
            Comma, semicolon, tab, and pipe, plus auto-detection that figures it out for you.
            Quoted fields containing delimiters and newlines are handled correctly (RFC 4180).
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">How are headers handled?</summary>
          <p class="body-md faq-answer">
            With "First row is a header" on (default), the first row becomes the object keys. Turn
            it off to get synthetic keys (column1, column2, …) and keep every row as data.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { csvToJsonStore } from "../../lib/tools/csv-to-json/store";
  import {
    handleInput,
    convert,
    convertLargeFile,
    clearAll,
    clearLargeFile,
    loadSample,
    getJsonContent,
    setDelimiter,
    setHasHeader,
    setSkipEmptyLines,
    setIndent,
  } from "../../lib/tools/csv-to-json/actions";
  import { delimiterLabel, LARGE_FILE_PHASES } from "../../lib/tools/csv-to-json/constants";
  import type { CsvDelimiterOption, IndentOption } from "../../lib/tools/csv-to-json/types";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const csvTextarea = document.getElementById("csv-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById("json-output-textarea") as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("csv-validation-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("csv-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("json-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("json-output-count") as HTMLElement | null;
  const delimiterSeg = document.getElementById("delimiter-select") as HTMLElement | null;
  const delimiterBtns = delimiterSeg
    ? (Array.from(delimiterSeg.querySelectorAll("[data-value]")) as HTMLButtonElement[])
    : [];
  const indentSeg = document.getElementById("indent-select") as HTMLElement | null;
  const indentBtns = indentSeg
    ? (Array.from(indentSeg.querySelectorAll("[data-value]")) as HTMLButtonElement[])
    : [];
  const hasHeaderCheckbox = document.getElementById(
    "has-header-checkbox",
  ) as HTMLInputElement | null;
  const skipEmptyCheckbox = document.getElementById(
    "skip-empty-checkbox",
  ) as HTMLInputElement | null;
  const convertBtn = document.getElementById("convert-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("convert-error") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;
  const phaseEl = document.getElementById("convert-phase") as HTMLElement | null;
  const statusText = document.getElementById("convert-status-text") as HTMLElement | null;

  initAnnounce("convert-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(csvToJsonStore, value);
  }, 150);

  // The last content we pushed into the output editor. Large-file mode shows a
  // capped preview; normal mode shows the authoritative JSON. Both must drive
  // Copy/Download, so they share this "active output" ref.
  let lastOut = "";

  const phaseByKey: Record<string, string> = {};
  LARGE_FILE_PHASES.forEach((p) => {
    phaseByKey[p.key] = p.label;
  });

  csvToJsonStore.subscribe((state) => {
    const inputFocused = csvTextarea && document.activeElement === csvTextarea;
    if (csvTextarea && csvTextarea.value !== state.csvInput && !inputFocused) {
      csvTextarea.value = state.csvInput;
      csvTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Large-file mode output: show the capped preview (whole records) in the editor.
    const large = state.largeFile;
    if (large) {
      const out = large.preview || "";
      if (out !== lastOut) {
        lastOut = out;
        if (outTextarea && outTextarea.value !== out) {
          outTextarea.value = out;
          outTextarea.dispatchEvent(new Event("editor-refresh"));
        }
      }
    } else if (outTextarea && outTextarea.value !== state.jsonOutput) {
      lastOut = state.jsonOutput;
      outTextarea.value = state.jsonOutput;
      outTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    if (inputStatus) {
      inputStatus.textContent = state.inputStatus === "ready" ? "Status: Ready" : "Status: Empty";
      inputStatus.style.color = state.inputStatus === "ready" ? "var(--color-success)" : "";
    }
    if (inputCharCount)
      inputCharCount.textContent = state.csvInput.length.toLocaleString() + " chars";

    if (outputStatus) {
      outputStatus.textContent =
        large != null
          ? "Output: Preview — first " +
            large.rows.toLocaleString() +
            " of " +
            large.totalRows.toLocaleString() +
            " records · Download for the full file"
          : state.outputStatus === "converted"
            ? `Output: ${state.recordCount.toLocaleString()} record${
                state.recordCount === 1 ? "" : "s"
              }`
            : "Output: Empty";
    }
    if (outputCharCount) {
      if (large) {
        outputCharCount.textContent = large.preview.length.toLocaleString() + " chars preview";
      } else if (state.outputStatus === "converted") {
        const delim = state.delimiterUsed ? " · " + delimiterLabel(state.delimiterUsed) : "";
        outputCharCount.textContent = state.jsonOutput.length.toLocaleString() + " chars" + delim;
      } else {
        outputCharCount.textContent = "0 chars";
      }
    }

    if (delimiterBtns.length) {
      delimiterBtns.forEach((b) => {
        b.classList.toggle("is-active", b.dataset.value === state.delimiter);
      });
    }
    if (indentBtns.length) {
      indentBtns.forEach((b) => {
        b.classList.toggle("is-active", b.dataset.value === state.indent);
      });
    }

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(state.isConverting ? "active" : state.error ? "error" : "idle");
    }
    if (phaseEl && statusText) {
      if (large && large.phase !== "done") {
        phaseEl.textContent = phaseByKey[large.phase] ?? large.phase + "…";
        phaseEl.style.color = "var(--color-accent)";
        statusText.textContent = "";
      } else if (large && large.phase === "done") {
        if (state.staleOptions) {
          phaseEl.textContent = "Options changed — convert again.";
          phaseEl.style.color = "var(--color-warning)";
        } else {
          phaseEl.textContent = "";
          phaseEl.style.color = "var(--color-success)";
        }
        statusText.textContent = "";
      } else {
        phaseEl.textContent = "";
        phaseEl.style.color = "";
        statusText.textContent = "Local sandbox active";
      }
    }

    if (convertBtn) {
      if (state.isConverting) {
        convertBtn.textContent = "Converting…";
        convertBtn.disabled = true;
      } else {
        convertBtn.textContent = "Convert to JSON";
        convertBtn.disabled = false;
      }
    }

    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
  });

  if (csvTextarea) {
    csvTextarea.addEventListener("input", () => debouncedInput(csvTextarea.value));
  }
  if (convertBtn) convertBtn.addEventListener("click", () => convert(csvToJsonStore));
  if (delimiterBtns.length) {
    delimiterBtns.forEach((b) =>
      b.addEventListener("click", () =>
        setDelimiter(csvToJsonStore, b.dataset.value as CsvDelimiterOption),
      ),
    );
  }
  if (indentBtns.length) {
    indentBtns.forEach((b) =>
      b.addEventListener("click", () => setIndent(csvToJsonStore, b.dataset.value as IndentOption)),
    );
  }
  if (hasHeaderCheckbox)
    hasHeaderCheckbox.addEventListener("change", () =>
      setHasHeader(csvToJsonStore, hasHeaderCheckbox.checked),
    );
  if (skipEmptyCheckbox)
    skipEmptyCheckbox.addEventListener("change", () =>
      setSkipEmptyLines(csvToJsonStore, skipEmptyCheckbox.checked),
    );

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(csvToJsonStore);
        announce("Sample CSV loaded");
      }
      if (action === "clear") {
        clearAll(csvToJsonStore);
        clearLargeFile(csvToJsonStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "copy") {
        const large = csvToJsonStore.get().largeFile;
        if (large) {
          announce("Copy copies only the preview — use Download for the full file");
          return;
        }
        const out = getJsonContent(csvToJsonStore);
        const ok = out ? await copyToClipboard(out) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("JSON copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        // Large-file mode: download the full Blob, not just the preview.
        const large = csvToJsonStore.get().largeFile;
        if (large && large.blob) {
          const blobUrl = URL.createObjectURL(large.blob);
          const a = document.createElement("a");
          a.href = blobUrl;
          a.download = "converted.json";
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
          announce("Download started (full file)");
          return;
        }
        const out = getJsonContent(csvToJsonStore);
        if (out) {
          downloadFile(out, "csv-to-json-converted.json", "application/json;charset=utf-8;");
          announce("Download started");
        }
      }
    });
  }

  const dropZone = document.getElementById("csv-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        clearLargeFile(csvToJsonStore);
        handleInput(csvToJsonStore, detail.text);
        announce("File loaded: " + (detail.name || "file") + " — click Convert to JSON");
      }
    });

    // Large-file mode: the worker owns the read + one-pass convert, and the
    // result is a Blob download with a capped in-editor preview.
    dropZone.addEventListener("file-large", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      const file: File | undefined = detail?.file;
      if (!file) return;
      convertLargeFile(csvToJsonStore, file, file.name, file.size);
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      convert(csvToJsonStore);
    }
  });
</script>

<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }

  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }

  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }

  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }

  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
</style>

<!-- LAYOUT ONLY — make the output card the same height as the input card so the
     two editors line up top & bottom (the input card is taller because it carries
     the drag-and-drop zone). Identical block to the one proven on json-to-csv.
     Global on purpose: the card is rendered by <Card>, outside this page's scope. -->
<style is:global>
  @media (min-width: 960px) {
    .workspace-grid.grid-3-col {
      align-items: stretch !important;
    }
    .workspace-col.input-col,
    .workspace-col.output-col {
      display: flex !important;
      flex-direction: column !important;
    }
    .ws-fill {
      display: flex !important;
      flex-direction: column !important;
      flex: 1 1 auto !important;
      min-height: 0 !important;
    }
    .ws-fill > .workspace-card {
      flex: 1 1 auto !important;
      height: auto !important;
      min-height: 0 !important;
    }
    .ws-output .workspace-card .editor-outer {
      margin-top: auto !important;
    }
  }
</style>
