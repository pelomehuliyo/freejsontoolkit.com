---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import HowItWorks from "../../components/tools/HowItWorks.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { INDENT_OPTIONS } from "../../lib/tools/json-formatter/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
import "../../styles/tool-options.css";
---

<ToolShell
  title="JSON Formatter — Beautify & Pretty-Print JSON Online (Free, Local)"
  description="Free online JSON formatter. Beautify, pretty-print, and sort JSON keys with 2-space, 4-space, or tab indentation — 100% local, no upload, no server."
  activePath="/tools/json-formatter"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "JSON Formatter" }]}
    title="JSON Formatter"
    subtitle="Beautify and pretty-print JSON with consistent indentation."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT JSON</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone id="json-input" accept=".json" label="Upload JSON file" />
        <CodeEditor
          id="json-input"
          label="JSON input"
          placeholder='Paste JSON here to format it
Example:
{"id":1,"name":"Ada","roles":["admin"]}'
        >
          <div class="editor-info-bar">
            <span class="info-status" id="json-validation-status">Status: Empty</span>
            <span class="info-meta" id="json-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <span class="settings-label">Indentation</span>
          <div class="seg" id="indent-seg" role="group" aria-label="Indentation">
            {INDENT_OPTIONS.map((opt) => (
              <button type="button" class="seg-btn" data-indent={opt.value}>
                {opt.label}
              </button>
            ))}
          </div>
        </div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="sort-keys-checkbox" />
            <span class="box"></span>
            Sort object keys
          </label>
          <p class="settings-help">
            Produces deterministic output; array order is preserved.
          </p>
        </div>

        <div class="settings-divider"></div>

        <Button id="format-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Format
        </Button>

        <ErrorBanner id="format-error" />

        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle"></span></span>
          <span class="sr-only" id="format-status-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">FORMATTED OUTPUT</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="formatted-output"
          label="Formatted JSON output"
          placeholder="Formatted JSON will appear here..."
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="format-output-status">Output: Empty</span>
            <span class="info-meta" id="format-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <HowItWorks
    heading="Format JSON in three steps"
    steps={[
      {
        title: "Paste or upload",
        desc: "Drop in raw, minified, or messy JSON — up to 15M characters.",
      },
      {
        title: "Pick indentation",
        desc: "Choose 2 spaces, 4 spaces, or tabs, and optionally sort keys A→Z.",
      },
      {
        title: "Format & export",
        desc: "Click Format, then copy or download the beautified result — all offline.",
      },
    ]}
  />
  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />

  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my JSON uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Formatting happens entirely in your browser. Your data never leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What does "sort keys" do?</summary>
          <p class="body-md faq-answer">
            It reorders every object's properties alphabetically for deterministic output — handy
            for diffing. Array element order is always preserved.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Can it validate JSON too?</summary>
          <p class="body-md faq-answer">
            Yes — if the input isn't valid JSON, the status bar shows the parse error with its
            position. A dedicated JSON Validator with richer diagnostics ships in v1.2.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { jsonFormatterStore } from "../../lib/tools/json-formatter/store";
  import {
    handleInput,
    format,
    loadSample,
    clearAll,
    getFormattedContent,
    setIndent,
    setSortKeys,
  } from "../../lib/tools/json-formatter/actions";
  import type { IndentOption } from "../../lib/tools/json-formatter/types";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const jsonTextarea = document.getElementById("json-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById(
    "formatted-output-textarea",
  ) as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("json-validation-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("json-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("format-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("format-output-count") as HTMLElement | null;
  const indentSeg = document.getElementById("indent-seg") as HTMLElement | null;
  const indentBtns = indentSeg
    ? (Array.from(indentSeg.querySelectorAll("[data-indent]")) as HTMLButtonElement[])
    : [];
  const sortCheckbox = document.getElementById("sort-keys-checkbox") as HTMLInputElement | null;
  const formatBtn = document.getElementById("format-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("format-error") as HTMLElement | null;

  initAnnounce("format-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(jsonFormatterStore, value);
  }, 150);

  jsonFormatterStore.subscribe((state) => {
    const inputFocused = jsonTextarea && document.activeElement === jsonTextarea;
    if (jsonTextarea && jsonTextarea.value !== state.jsonInput && !inputFocused) {
      jsonTextarea.value = state.jsonInput;
      jsonTextarea.dispatchEvent(new Event("editor-refresh"));
    }
    if (outTextarea && outTextarea.value !== state.formattedOutput) {
      outTextarea.value = state.formattedOutput;
      outTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    if (inputStatus) {
      switch (state.inputStatus) {
        case "empty":
          inputStatus.textContent = "Status: Empty";
          inputStatus.style.color = "";
          break;
        case "ready":
          inputStatus.textContent = "Status: Ready";
          inputStatus.style.color = "var(--color-success)";
          break;
        case "invalid":
          inputStatus.textContent = "Status: Invalid";
          inputStatus.style.color = "var(--color-error)";
          break;
      }
    }
    if (inputCharCount)
      inputCharCount.textContent = state.jsonInput.length.toLocaleString() + " chars";
    if (outputStatus)
      outputStatus.textContent =
        state.outputStatus === "formatted" ? "Output: JSON" : "Output: Empty";
    if (outputCharCount)
      outputCharCount.textContent = state.formattedOutput.length.toLocaleString() + " chars";

    if (indentBtns.length) {
      indentBtns.forEach((b) => {
        b.classList.toggle("is-active", b.dataset.indent === state.indent);
      });
    }

    if (formatBtn) {
      if (state.isFormatting) {
        formatBtn.textContent = "Formatting…";
        formatBtn.disabled = true;
      } else {
        formatBtn.textContent = "Format";
        formatBtn.disabled = false;
      }
    }

    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
  });

  if (jsonTextarea) {
    jsonTextarea.addEventListener("input", () => debouncedInput(jsonTextarea.value));
  }
  if (formatBtn) formatBtn.addEventListener("click", () => format(jsonFormatterStore));
  if (indentBtns.length) {
    indentBtns.forEach((b) =>
      b.addEventListener("click", () =>
        setIndent(jsonFormatterStore, b.dataset.indent as IndentOption),
      ),
    );
  }
  if (sortCheckbox)
    sortCheckbox.addEventListener("change", () =>
      setSortKeys(jsonFormatterStore, sortCheckbox.checked),
    );

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(jsonFormatterStore);
        announce("Sample JSON loaded");
      }
      if (action === "clear") {
        clearAll(jsonFormatterStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "copy") {
        const out = getFormattedContent(jsonFormatterStore);
        const ok = out ? await copyToClipboard(out) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("Formatted JSON copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        const out = getFormattedContent(jsonFormatterStore);
        if (out) {
          downloadFile(out, "json-formatter-formatted.json", "application/json;charset=utf-8;");
          announce("Download started");
        }
      }
    });
  }

  const dropZone = document.getElementById("json-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(jsonFormatterStore, detail.text);
        announce("File loaded: " + (detail.name || "file") + " — click Format JSON");
      }
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      format(jsonFormatterStore);
    }
  });
</script>

<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }

  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }

  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }

  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }

  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
</style>

<!-- LAYOUT ONLY — equal-height editor cards (see csv-to-json for the explanation). -->
<style is:global>
  @media (min-width: 960px) {
    .workspace-grid.grid-3-col {
      align-items: stretch !important;
    }
    .workspace-col.input-col,
    .workspace-col.output-col {
      display: flex !important;
      flex-direction: column !important;
    }
    .ws-fill {
      display: flex !important;
      flex-direction: column !important;
      flex: 1 1 auto !important;
      min-height: 0 !important;
    }
    .ws-fill > .workspace-card {
      flex: 1 1 auto !important;
      height: auto !important;
      min-height: 0 !important;
    }
    .ws-output .workspace-card .editor-outer {
      margin-top: auto !important;
    }
  }
</style>
