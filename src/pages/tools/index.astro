---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import {
  availableTools,
  comingSoon,
  categoryLabel,
  counts,
  type ToolCategory,
  type ToolManifest,
} from "../../lib/tools/registry";

// 3-letter technical monogram per category — typographic, not iconographic.
const monogram: Record<ToolCategory, string> = {
  convert: "CON",
  format: "FOR",
  validate: "VAL",
  compare: "CMP",
  generate: "GEN",
  utilities: "UTL",
  api: "API",
};

// Lowercased, token-friendly haystack: name + tagline + category + id + the SEO
// keywords. Searching the keywords is the point — "prettify" finds the Formatter,
// "yaml" surfaces the planned YAML tools, "csv json" (any order) finds the converter.
function searchText(t: ToolManifest): string {
  return [t.name, t.tagline, categoryLabel(t.category), t.id, ...(t.keywords ?? [])]
    .join(" ")
    .toLowerCase()
    .replace(/[→]/g, " ");
}

// "In the pipeline" preview: soonest upcoming tools by roadmap version.
function versionRank(v?: string): number {
  if (!v) return 999;
  const m = v.match(/(\d+)\.(\d+)/);
  return m ? Number(m[1]) * 100 + Number(m[2]) : 999;
}
const pipeline = [...comingSoon].sort((a, b) => versionRank(a.addedIn) - versionRank(b.addedIn));
---

<BaseLayout
  title="Developer Tools | Free JSON Toolkit"
  description="Fast, privacy-first developer utilities for JSON, CSV, XML & YAML. Every tool runs 100% in your browser — no uploads, no accounts, no waiting."
  activePath="/tools"
>
  <main>
    {/* ── Manifest hero ── */}
    <section class="catalog-hero" aria-labelledby="tools-hero-title">
      <Container size="default">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="manifest-line caption-mono">~/freejsontoolkit&nbsp;$&nbsp;tools --list</p>
            <h1 id="tools-hero-title" class="display-xl hero-title">Developer Tools</h1>
            <p class="body-lg hero-lede">
              Fast, privacy-first utilities for JSON, CSV, XML &amp; YAML. Everything runs in your
              browser — no uploads, no accounts, no waiting.
            </p>
            <ul class="hero-stats" aria-label="Toolkit status">
              <li>
                <span class="stat-num">{counts.available}</span>
                <span class="stat-label caption-mono">live now</span>
              </li>
              <li>
                <span class="stat-num">{counts.comingSoon}</span>
                <span class="stat-label caption-mono">in the pipeline</span>
              </li>
              <li>
                <span class="stat-num">0</span>
                <span class="stat-label caption-mono">bytes uploaded</span>
              </li>
            </ul>
          </div>

          <div class="hero-terminal" aria-hidden="true">
            <div class="terminal-bar">
              <span class="t-dot"></span><span class="t-dot"></span><span class="t-dot"></span>
              <span class="t-title caption-mono">local · offline · no telemetry</span>
            </div>
            <pre
              class="terminal-body caption-mono"><span class="t-prompt">$</span> <span class="t-cmd">toolkit --local</span>
<span class="t-ok">✓ {counts.available} tools ready</span>
<span class="t-ok">✓ 0 bytes uploaded</span>
<span class="t-ok">✓ processed in your browser</span>
<span class="t-prompt">$</span> <span class="t-caret">▍</span></pre>
          </div>
        </div>
      </Container>
    </section>

    {/* ── Catalog ── */}
    <section class="catalog-section" aria-labelledby="catalog-title">
      <Container size="default">
        {
          /* bite 3 — command-line search. Filters the catalog live by name,
            tagline, category, and SEO keywords; "/" focuses it from anywhere. */
        }
        <form class="tool-search" role="search" data-tool-search-form aria-label="Filter tools">
          <span class="search-prompt" data-search-focus aria-hidden="true">$</span>
          <input
            class="search-input"
            type="search"
            data-tool-search
            placeholder="find a tool — name, keyword, or category"
            aria-label="Filter tools by name, keyword, or category"
            autocomplete="off"
            spellcheck="false"
          />
          <button
            type="button"
            class="search-clear"
            data-search-clear
            aria-label="Clear search"
            hidden
          >
            &times;
          </button>
          <kbd class="kbd search-kbd" data-search-focus aria-hidden="true">/</kbd>
        </form>
        <p class="search-status caption-mono" data-search-status aria-live="polite"></p>

        {/* bite 2: personalized row — hidden automatically while searching */}
        <div class="your-tools" data-your-tools></div>

        <div class="section-head">
          <span class="caption-mono section-eyebrow">AVAILABLE NOW</span>
          <h2 id="catalog-title" class="display-lg section-title">Pick a tool and start</h2>
          <p class="body-sm section-sub">
            Every tool shares one engine, one editor, one design language — and runs 100% locally.
            Star the ones you reach for; they'll remember you.
          </p>
        </div>

        <div class="tool-grid" role="list" data-grid="available">
          {
            availableTools.map((t) => (
              <article
                class="tool-card is-live"
                role="listitem"
                data-status="available"
                data-search={searchText(t)}
              >
                <button
                  type="button"
                  class="fav-star"
                  data-tool={t.id}
                  aria-pressed="false"
                  aria-label={`Add ${t.name} to favorites`}
                  title="Add to favorites"
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path d="M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.78L12 16.77l-5.2 2.73.99-5.78-4.21-4.1 5.82-.85L12 3.5z" />
                  </svg>
                </button>

                <a class="tool-card-link" href={t.href}>
                  <div class="card-top">
                    <span class="mono-badge" aria-hidden="true">
                      {monogram[t.category]}
                    </span>
                    <span class="cat-chip caption-mono" aria-hidden="true">
                      {categoryLabel(t.category)}
                    </span>
                  </div>

                  <h3 class="display-sm card-name">{t.name}</h3>
                  <p class="body-sm card-tag">{t.tagline}</p>

                  <div class="card-foot">
                    <span class="pill pill-live" aria-hidden="true">
                      <span class="pill-dot" />
                      Available
                    </span>
                    <span class="card-cta body-sm-strong" aria-hidden="true">
                      Open <span class="cta-arrow">→</span>
                    </span>
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        {
          pipeline.length > 0 && (
            <div class="pipeline-block">
              <div class="pipeline-head">
                <h3 id="pipeline-title" class="display-sm pipeline-title">
                  In the pipeline
                </h3>
                <p class="caption pipeline-note">
                  Shipped in the open — the roadmap follows demand.
                </p>
              </div>
              <div
                class="tool-grid tool-grid-pipeline"
                role="list"
                aria-labelledby="pipeline-title"
                data-grid="pipeline"
              >
                {pipeline.map((t) => (
                  <article
                    class="tool-card is-pipeline"
                    role="listitem"
                    data-status={t.status}
                    data-search={searchText(t)}
                  >
                    <div class="tool-card-link">
                      <div class="card-top">
                        <span class="mono-badge" aria-hidden="true">
                          {monogram[t.category]}
                        </span>
                        <span class="cat-chip caption-mono" aria-hidden="true">
                          {categoryLabel(t.category)}
                        </span>
                      </div>

                      <h3 class="display-sm card-name">{t.name}</h3>
                      <p class="body-sm card-tag">{t.tagline}</p>

                      <div class="card-foot">
                        <span class="pill pill-soon" aria-hidden="true">
                          {t.addedIn ? `Coming · ${t.addedIn}` : "Planned"}
                        </span>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )
        }

        {/* bite 3 — no-match empty state (mono voice, honest, with an out) */}
        <div class="search-empty" data-search-empty hidden>
          <p class="caption-mono search-empty-cmd">
            $ toolkit find "<span data-search-echo></span>"
          </p>
          <p class="body-sm search-empty-msg">No tools match — yet. The roadmap follows demand.</p>
          <a
            class="body-sm-strong search-empty-link"
            href="https://github.com/pelomehuliyo/freejsontoolkit.com/issues"
          >
            Request it on GitHub →
          </a>
        </div>
      </Container>
    </section>
  </main>

  <style>
    /* ── Hero  */
    .catalog-hero {
      padding: var(--spacing-4xl) 0 var(--spacing-3xl);
      background-color: var(--color-canvas);
      border-bottom: 1px solid var(--color-hairline);
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--spacing-xl);
      align-items: center;
    }
    .manifest-line {
      color: var(--color-mute);
      margin: 0 0 var(--spacing-xs);
      letter-spacing: 0.02em;
    }
    .hero-title {
      margin: 0 0 var(--spacing-sm);
      letter-spacing: -0.03em;
    }
    .hero-lede {
      color: var(--color-body);
      margin: 0 0 var(--spacing-md);
      max-width: 52ch;
      line-height: 1.5;
    }
    .hero-stats {
      list-style: none;
      display: flex;
      gap: var(--spacing-lg);
      padding: 0;
      margin: 0;
    }
    .hero-stats li {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .stat-num {
      font-family: var(--font-mono);
      font-size: 30px;
      font-weight: 600;
      color: var(--color-ink);
      line-height: 1;
    }
    .stat-label {
      color: var(--color-mute);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Decorative terminal — ambient brand voice, not a tool link */
    .hero-terminal {
      border: 1px solid var(--color-hairline);
      border-radius: var(--rounded-md);
      overflow: hidden;
      background-color: var(--color-primary);
      box-shadow: 0 18px 40px rgba(17, 17, 17, 0.12);
    }
    .terminal-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 9px 12px;
      background-color: rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .t-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background-color: rgba(255, 255, 255, 0.18);
    }
    .t-title {
      margin-left: auto;
      color: rgba(255, 255, 255, 0.5);
      font-size: 10px;
      letter-spacing: 0.05em;
    }
    .terminal-body {
      margin: 0;
      padding: 14px 16px;
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.75;
      color: rgba(255, 255, 255, 0.85);
      white-space: pre;
      overflow-x: auto;
    }
    .t-prompt {
      color: var(--color-accent);
    }
    .t-cmd {
      color: rgba(255, 255, 255, 0.7);
    }
    .t-ok {
      color: var(--color-accent);
    }
    .t-caret {
      color: var(--color-accent);
      animation: blink 1.1s step-end infinite;
    }
    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    /* ── Catalog chrome (card + search visuals live in tool-cards.css) ── */
    .catalog-section {
      padding: var(--spacing-4xl) 0;
      background-color: var(--color-canvas-soft);
      background-image: radial-gradient(var(--color-hairline) 1px, transparent 1px);
      background-size: 22px 22px;
    }
    .section-head {
      max-width: 720px;
      margin: 0 auto var(--spacing-xl);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--spacing-xs);
    }
    .section-eyebrow {
      color: var(--color-mute);
      letter-spacing: 0.12em;
    }
    .section-title {
      margin: 0;
      color: var(--color-ink);
    }
    .section-sub {
      margin: 0;
      color: var(--color-body);
    }

    /* Pipeline heading */
    .pipeline-block {
      margin-top: var(--spacing-3xl);
      padding-top: var(--spacing-xl);
      border-top: 1px solid var(--color-hairline);
    }
    .pipeline-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-md);
    }
    .pipeline-title {
      color: var(--color-ink);
      margin: 0;
    }
    .pipeline-note {
      color: var(--color-mute);
      margin: 0;
    }

    /* ── Responsive ─ */
    @media (max-width: 959px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
      }
    }
    @media (max-width: 640px) {
      .hero-stats {
        gap: var(--spacing-md);
      }
      .pipeline-head {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
      }
    }
  </style>
</BaseLayout>
