---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import HowItWorks from "../../components/tools/HowItWorks.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { INDENT_OPTIONS } from "../../lib/tools/json-validator/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
import "../../styles/tool-options.css";
---

<ToolShell
  title="JSON Validator — Check JSON Syntax Online (Free, Local)"
  description="Free online JSON validator. Pinpoint syntax errors to the exact line and column, flag duplicate keys, and inspect structure — 100% local, no upload, no server."
  activePath="/tools/json-validator"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "JSON Validator" }]}
    title="JSON Validator"
    subtitle="Pinpoint syntax errors to the exact line and column."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT JSON</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone id="json-input" accept=".json" label="Upload JSON file" />
        <CodeEditor
          id="json-input"
          label="JSON input"
          placeholder='Paste JSON to validate it
Example:
{"id":1,"name":"Ada"}'
        >
          <div class="editor-info-bar">
            <span class="info-status" id="json-validation-status">Status: Empty</span>
            <span class="info-meta" id="json-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="flag-dupes-checkbox" checked />
            <span class="box"></span>
            Flag duplicate keys
          </label>
          <p class="settings-help">
            JSON allows repeated keys; most code keeps the last. We warn you.
          </p>
        </div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="include-normalized-checkbox" />
            <span class="box"></span>
            Include normalized JSON
          </label>
          <p class="settings-help">
            Append a pretty-printed copy to the report when valid.
          </p>
        </div>

        <div class="settings-group">
          <span class="settings-label">Normalized indent</span>
          <div class="seg" id="indent-select" role="group" aria-label="Normalized indent">
            {INDENT_OPTIONS.map((opt) => (
              <button type="button" class="seg-btn" data-value={opt.value}>
                {opt.label}
              </button>
            ))}
          </div>
        </div>

        <div class="settings-divider"></div>

        <Button id="validate-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Validate
        </Button>

        <ErrorBanner id="validate-error" />

        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="status-dot"></span></span>
          <span class="sr-only" id="validate-status-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">DIAGNOSTICS</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="validation-output"
          label="Validation diagnostics"
          placeholder="Diagnostics will appear here..."
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="validation-output-status">Output: Empty</span>
            <span class="info-meta" id="validation-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <HowItWorks
    heading="Validate JSON in three steps"
    steps={[
      {
        title: "Paste or upload",
        desc: "Drop in any JSON — validity is checked as you type, up to 15M characters.",
      },
      {
        title: "Read the diagnosis",
        desc: "Errors point to the exact line and column, with the offending lines and a caret.",
      },
      {
        title: "Inspect structure",
        desc: "When valid, see a structure tally, duplicate-key warnings, and an optional normalized copy.",
      },
    ]}
  />
  <ToolDocs />

  <CompareLinks />
  <RelatedTools />
  <ToolNudge />

  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my JSON uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Validation runs entirely in your browser (in a background worker for large files).
            Your data never leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Why are duplicate keys only a warning?</summary>
          <p class="body-md faq-answer">
            The JSON specification permits repeated keys, and <code>JSON.parse</code> silently keeps the
            last value — which is usually a bug. We flag them so you can decide, rather than rejecting
            valid input.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">How exact are the line and column numbers?</summary>
          <p class="body-md faq-answer">
            Exact, and identical in every browser. The validator walks the JSON grammar itself
            rather than reading an error string, so the coordinates never depend on the engine's
            message format.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { jsonValidatorStore } from "../../lib/tools/json-validator/store";
  import {
    handleInput,
    validate,
    loadSample,
    clearAll,
    setFlagDuplicateKeys,
    setIncludeNormalized,
    setIndent,
  } from "../../lib/tools/json-validator/actions";
  import { buildReport } from "../../lib/tools/json-validator/engine";
  import type { IndentOption } from "../../lib/tools/json-validator/types";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const jsonTextarea = document.getElementById("json-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById(
    "validation-output-textarea",
  ) as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("json-validation-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("json-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("validation-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("validation-output-count") as HTMLElement | null;
  const flagDupes = document.getElementById("flag-dupes-checkbox") as HTMLInputElement | null;
  const includeNormalized = document.getElementById(
    "include-normalized-checkbox",
  ) as HTMLInputElement | null;
  const indentSeg = document.getElementById("indent-select") as HTMLElement | null;
  const indentBtns = indentSeg
    ? (Array.from(indentSeg.querySelectorAll("[data-value]")) as HTMLButtonElement[])
    : [];
  const validateBtn = document.getElementById("validate-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("validate-error") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;

  initAnnounce("validate-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(jsonValidatorStore, value);
  }, 150);

  let lastScrolledPos = -1;
  let lastReport = "";

  jsonValidatorStore.subscribe((state) => {
    const inputFocused = jsonTextarea && document.activeElement === jsonTextarea;
    if (jsonTextarea && jsonTextarea.value !== state.jsonInput && !inputFocused) {
      jsonTextarea.value = state.jsonInput;
      jsonTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Build the diagnostics report only from an authoritative result (an
    // explicit Validate run). Live as-you-type validation updates the input
    // status bar but never fills the output editor.
    const report =
      state.result && state.result.authoritative
        ? buildReport(state.result, state.jsonInput)
        : "";
    if (report !== lastReport) {
      lastReport = report;
      if (outTextarea && outTextarea.value !== report) {
        outTextarea.value = report;
        outTextarea.dispatchEvent(new Event("editor-refresh"));
      }
    }

    if (inputStatus) {
      if (state.inputStatus === "empty") {
        inputStatus.textContent = "Status: Empty";
        inputStatus.style.color = "";
      } else if (state.inputStatus === "too-large") {
        inputStatus.textContent = "Status: Too large";
        inputStatus.style.color = "var(--color-error)";
      } else if (state.result && !state.result.valid && state.result.error) {
        const e = state.result.error;
        inputStatus.textContent = `Status: Invalid — line ${e.line}, col ${e.column}`;
        inputStatus.style.color = "var(--color-error)";
      } else if (state.result && state.result.valid) {
        inputStatus.textContent = "Status: Ready";
        inputStatus.style.color = "var(--color-success)";
      } else {
        inputStatus.textContent = "Status: Ready";
        inputStatus.style.color = "";
      }
    }
    if (inputCharCount)
      inputCharCount.textContent = state.jsonInput.length.toLocaleString() + " chars";

    if (outputStatus) {
      outputStatus.textContent =
        state.outputStatus === "valid"
          ? "Output: Valid"
          : state.outputStatus === "invalid"
            ? "Output: Invalid"
            : "Output: Empty";
      outputStatus.style.color =
        state.outputStatus === "valid"
          ? "var(--color-success)"
          : state.outputStatus === "invalid"
            ? "var(--color-error)"
            : "";
    }
    if (outputCharCount) outputCharCount.textContent = report.length.toLocaleString() + " chars";

    if (indentBtns.length) {
      indentBtns.forEach((b) => b.classList.toggle("is-active", b.dataset.value === state.indent));
    }

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(
        state.isValidating ? "active" : state.outputStatus === "invalid" ? "error" : "idle",
      );
    }

    if (validateBtn) {
      validateBtn.textContent = state.isValidating ? "Validating…" : "Validate";
      validateBtn.disabled = state.isValidating;
    }

    // Scroll the input to the error line ONLY on an authoritative invalid result,
    // so as-you-type diagnostics never yank the caret while typing.
    if (
      jsonTextarea &&
      state.result &&
      state.result.authoritative &&
      !state.result.valid &&
      state.result.error &&
      state.result.error.position !== lastScrolledPos
    ) {
      lastScrolledPos = state.result.error.position;
      const lh = parseFloat(getComputedStyle(jsonTextarea).lineHeight) || 19.5;
      jsonTextarea.scrollTop = Math.max(0, (state.result.error.line - 3) * lh);
    }

    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
    if (state.result && state.result.authoritative && state.result.valid) announce("JSON is valid");
    if (state.result && state.result.authoritative && !state.result.valid)
      announce("JSON is invalid");
  });

  if (jsonTextarea) {
    jsonTextarea.addEventListener("input", () => debouncedInput(jsonTextarea.value));
  }
  if (validateBtn) validateBtn.addEventListener("click", () => validate(jsonValidatorStore));
  if (flagDupes)
    flagDupes.addEventListener("change", () =>
      setFlagDuplicateKeys(jsonValidatorStore, flagDupes.checked),
    );
  if (includeNormalized)
    includeNormalized.addEventListener("change", () =>
      setIncludeNormalized(jsonValidatorStore, includeNormalized.checked),
    );
  if (indentBtns.length) {
    indentBtns.forEach((b) =>
      b.addEventListener("click", () =>
        setIndent(jsonValidatorStore, b.dataset.value as IndentOption),
      ),
    );
  }

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(jsonValidatorStore);
        announce("Sample JSON loaded");
      }
      if (action === "clear") {
        clearAll(jsonValidatorStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      const report = lastReport;
      if (action === "copy") {
        const ok = report ? await copyToClipboard(report) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("Diagnostics copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        if (report) {
          downloadFile(report, "json-validator-validation-report.txt", "text/plain;charset=utf-8;");
          announce("Download started");
        }
      }
    });
  }

  const dropZone = document.getElementById("json-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(jsonValidatorStore, detail.text);
        announce("File loaded: " + (detail.name || "file") + " — click Validate");
      }
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      validate(jsonValidatorStore);
    }
  });
</script>

<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }

  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }

  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }

  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }
  .faq-answer code {
    font-family: var(--font-mono);
    font-size: 12px;
    background-color: var(--color-canvas-soft-2);
    padding: 1px 4px;
    border-radius: var(--rounded-xs);
  }

  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
</style>
