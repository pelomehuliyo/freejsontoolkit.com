---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { NEWLINE_STRATEGIES } from "../../lib/tools/csv-to-tsv/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
---

<ToolShell
  title="CSV to TSV Converter — Convert CSV to Tab-Separated Values Online (Free, Local)"
  description="Free online CSV to TSV converter. Paste or drop a CSV table and get clean tab-separated values — quoted fields handled, newlines flagged honestly — 100% local, no upload."
  activePath="/tools/csv-to-tsv"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "CSV → TSV" }]}
    title="CSV → TSV"
    subtitle="Turn comma tables into tab-separated values — commas in fields handled for you."
  />
  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT CSV</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone id="csv-input" accept=".csv" label="Upload CSV file" />
        <CodeEditor
          id="csv-input"
          label="CSV input"
          placeholder={`Paste CSV to convert it
name,role,level
Ada,Engineer,7`}
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="csv-status">CSV Status: Empty</span>
            <span class="info-meta" id="csv-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>
        <div class="settings-group">
          <label class="settings-label caption-mono" for="newline-select">Embedded newlines</label>
          <div class="select-wrapper">
            <select id="newline-select" class="settings-select">
              {NEWLINE_STRATEGIES.map((opt) => <option value={opt.value}>{opt.label}</option>)}
            </select>
          </div>
          <p class="caption settings-help">
            TSV can't keep a newline inside one cell. Refuse is the honest default.
          </p>
        </div>
        <div class="settings-divider"></div>
        <Button id="convert-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Convert to TSV
        </Button>
        <ErrorBanner id="convert-error" />
        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="status-dot"></span></span>
          <span class="sr-only" id="convert-status-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>
    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT TSV</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="tsv-output"
          label="TSV output"
          placeholder="Tab-separated output will appear here..."
          readonly
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="tsv-output-status">Output: Empty</span>
            <span class="info-meta" id="tsv-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>
  <section class="tool-content-section" aria-labelledby="how-title">
    <Container size="narrow">
      <div class="content-section-header">
        <span class="caption-mono section-eyebrow">HOW IT WORKS</span>
        <h2 id="how-title" class="display-md section-title">Convert CSV in three steps</h2>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number" aria-hidden="true">1</span>
          <h3 class="body-sm-strong step-title">Paste or drop</h3>
          <p class="caption step-desc">
            Any CSV table — the shared RFC 4180 parser handles quoted fields and commas inside them.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">2</span>
          <h3 class="body-sm-strong step-title">Convert</h3>
          <p class="caption step-desc">
            Press Convert (or Ctrl/⌘ + Enter). Big tables run in a background worker.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">3</span>
          <h3 class="body-sm-strong step-title">Take the TSV</h3>
          <p class="caption step-desc">
            Copy or download the tab-separated result — ready for a spreadsheet or a pipeline.
          </p>
        </div>
      </div>
    </Container>
  </section>
  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />
  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my CSV uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Parsing and conversion run entirely in your browser (in a background worker for
            large tables). Your data never leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What happens to commas inside quoted fields?</summary>
          <p class="body-md faq-answer">
            They're preserved. The parser reads quoted fields correctly, and since TSV uses tabs,
            the comma becomes ordinary text — the surrounding quotes are dropped.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Why does a field with a newline fail the conversion?</summary
          >
          <p class="body-md faq-answer">
            TSV has no way to keep a newline inside a single cell — it would split the row. Rather
            than silently corrupt your table, we refuse and point at the cell, or escape it to a
            literal <code>\n</code> if you choose that option.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Do ragged rows work?</summary>
          <p class="body-md faq-answer">
            No — CSV → TSV needs a rectangular grid. Rows with a different number of fields fail
            with the exact line number instead of being silently padded or dropped, which would
            change your data.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>
<script>
  import { csvToTsvStore } from "../../lib/tools/csv-to-tsv/store";
  import {
    handleInput,
    convert,
    loadSample,
    clearAll,
    setNewlineStrategy,
  } from "../../lib/tools/csv-to-tsv/actions";
  import type { ConvertOptions } from "../../lib/tools/csv-to-tsv/types";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const csvTextarea = document.getElementById("csv-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById("tsv-output-textarea") as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("csv-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("csv-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("tsv-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("tsv-output-count") as HTMLElement | null;
  const newlineSelect = document.getElementById("newline-select") as HTMLSelectElement | null;
  const convertBtn = document.getElementById("convert-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("convert-error") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;

  initAnnounce("convert-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(csvToTsvStore, value);
  }, 150);

  let lastOut = "";

  csvToTsvStore.subscribe((state) => {
    const inputFocused = csvTextarea && document.activeElement === csvTextarea;
    if (csvTextarea && csvTextarea.value !== state.csvInput && !inputFocused) {
      csvTextarea.value = state.csvInput;
      csvTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Output only changes on an authoritative Convert.
    if (state.result && state.result.authoritative) {
      const out = state.result.ok ? state.result.output : "";
      if (out !== lastOut) {
        lastOut = out;
        if (outTextarea && outTextarea.value !== out) {
          outTextarea.value = out;
          outTextarea.dispatchEvent(new Event("editor-refresh"));
        }
      }
    }

    if (inputStatus) {
      if (state.inputStatus === "empty") {
        inputStatus.textContent = "CSV Status: Empty";
        inputStatus.style.color = "";
      } else if (state.result && !state.result.ok) {
        inputStatus.textContent = "CSV Status: Invalid";
        inputStatus.style.color = "var(--color-error)";
      } else if (state.result && state.result.ok) {
        inputStatus.textContent = "CSV Status: Valid";
        inputStatus.style.color = "var(--color-success)";
      } else {
        inputStatus.textContent = "CSV Status: Ready";
        inputStatus.style.color = "";
      }
    }
    if (inputCharCount)
      inputCharCount.textContent = state.csvInput.length.toLocaleString() + " chars";

    if (outputStatus) {
      outputStatus.textContent =
        state.outputStatus === "converted"
          ? "Output: TSV"
          : state.outputStatus === "invalid"
            ? "Output: Error"
            : "Output: Empty";
      outputStatus.style.color =
        state.outputStatus === "converted"
          ? "var(--color-success)"
          : state.outputStatus === "invalid"
            ? "var(--color-error)"
            : "";
    }
    if (outputCharCount) {
      const ok = state.result && state.result.authoritative && state.result.ok;
      outputCharCount.textContent =
        lastOut.length.toLocaleString() +
        " chars" +
        (ok ? ` · ${state.result!.rowCount} rows × ${state.result!.colCount} cols` : "");
    }

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(
        state.isConverting ? "active" : state.outputStatus === "invalid" ? "error" : "idle",
      );
    }
    if (convertBtn) {
      convertBtn.textContent = state.isConverting ? "Converting…" : "Convert to TSV";
      convertBtn.disabled = state.isConverting;
    }
    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
    if (state.result && state.result.authoritative && state.result.ok) announce("Converted to TSV");
    if (state.result && state.result.authoritative && !state.result.ok)
      announce("CSV is invalid for TSV conversion");
  });

  if (csvTextarea) {
    csvTextarea.addEventListener("input", () => debouncedInput(csvTextarea.value));
  }
  if (convertBtn) convertBtn.addEventListener("click", () => convert(csvToTsvStore));
  if (newlineSelect)
    newlineSelect.addEventListener("change", () =>
      setNewlineStrategy(csvToTsvStore, newlineSelect.value as ConvertOptions["newlineStrategy"]),
    );

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(csvToTsvStore);
        announce("Sample CSV loaded");
      }
      if (action === "clear") {
        clearAll(csvToTsvStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "copy") {
        const ok = lastOut ? await copyToClipboard(lastOut) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("TSV copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        if (lastOut) {
          downloadFile(lastOut, "converted.tsv", "text/tab-separated-values;charset=utf-8;");
          announce("Download started");
        } else {
          announce("Nothing to download yet");
        }
      }
    });
  }

  const dropZone = document.getElementById("csv-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(csvToTsvStore, detail.text);
        convert(csvToTsvStore);
        announce("File loaded: " + (detail.name || "file"));
      }
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      convert(csvToTsvStore);
    }
  });
</script>
<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }
  .settings-card {
    padding: var(--spacing-lg);
  }
  .settings-title {
    margin: 0;
  }
  .settings-divider {
    height: 1px;
    background-color: var(--color-hairline);
    margin: var(--spacing-xs) 0;
  }
  .settings-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }
  .settings-label {
    color: var(--color-mute);
    font-size: 11px;
    font-weight: 600;
  }
  .select-wrapper {
    position: relative;
    width: 100%;
  }
  .settings-select {
    width: 100%;
    height: 38px;
    padding: 0 var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    appearance: none;
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .settings-select:focus {
    border-color: var(--color-hairline-strong);
  }
  .select-wrapper::after {
    content: "▼";
    font-size: 9px;
    color: var(--color-body);
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .settings-help {
    color: var(--color-mute);
    line-height: 1.4;
  }
  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }
  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .tool-content-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
  }
  .content-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }
  .step-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-lg);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    text-align: center;
    align-items: center;
  }
  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--rounded-full);
    background-color: var(--color-accent);
    color: var(--color-on-primary);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }
  .step-title {
    color: var(--color-ink);
    margin: 0;
  }
  .step-desc {
    color: var(--color-body);
    margin: 0;
    line-height: 1.5;
  }
  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }
  .faq-answer code {
    font-family: var(--font-mono);
    font-size: 12px;
    background-color: var(--color-canvas-soft-2);
    padding: 1px 4px;
    border-radius: var(--rounded-xs);
  }
  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
    .steps-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
