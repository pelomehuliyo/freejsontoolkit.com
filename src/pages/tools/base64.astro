---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { MIME_PRESETS } from "../../lib/tools/base64/constants";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
---

<ToolShell
  title="Base64 Encode / Decode — Online, Local, Free"
  description="Free online Base64 encoder and decoder with standard and URL-safe alphabets, optional padding, data-URI wrapping, and a magic-byte sniffer — 100% local, no upload, no server."
  activePath="/tools/base64"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Base64" }]}
    title="Base64 Encode / Decode"
    subtitle="Encode text to Base64 or decode it back — with URL-safe, padding, and data-URI options. Offline."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone
          id="b64-input"
          accept=".txt,.json,.csv,.xml,.svg"
          label="Upload a text file"
        />
        <CodeEditor
          id="b64-input"
          label="Base64 input"
          placeholder="Paste text to encode, or Base64 to decode…"
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="b64-input-status">Status: Empty</span>
            <span class="info-meta" id="b64-input-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <span class="settings-label caption-mono">Direction</span>
          <div class="seg" role="group" aria-label="Direction">
            <button
              type="button"
              class="seg-btn is-active"
              data-b64-mode="encode"
              aria-pressed="true">Encode</button
            >
            <button type="button" class="seg-btn" data-b64-mode="decode" aria-pressed="false"
              >Decode</button
            >
          </div>
        </div>

        <div class="settings-group">
          <span class="settings-label caption-mono">Alphabet</span>
          <div class="seg" role="group" aria-label="Alphabet">
            <button
              type="button"
              class="seg-btn is-active"
              data-b64-variant="std"
              aria-pressed="true">Standard</button
            >
            <button type="button" class="seg-btn" data-b64-variant="url" aria-pressed="false"
              >URL-safe</button
            >
          </div>
        </div>

        <div class="settings-group checkbox-group">
          <label class="checkbox-container body-sm">
            <input type="checkbox" id="b64-padding" checked />
            <span class="checkbox-checkmark"></span>
            Include padding <span class="caption-mono">=</span>
          </label>
        </div>

        <div class="settings-group b64-wrap-group" id="b64-wrap-group">
          <label class="checkbox-container body-sm">
            <input type="checkbox" id="b64-datauri" />
            <span class="checkbox-checkmark"></span>
            Wrap as <span class="caption-mono">data:</span> URI
          </label>
          <div class="select-wrapper">
            <select id="b64-mime" class="settings-select" disabled>
              {MIME_PRESETS.map((m) => <option value={m}>{m}</option>)}
            </select>
          </div>
        </div>

        <div class="settings-divider"></div>

        <Button id="run-btn" variant="primary" size="lg" shape="square" class="action-btn"
          >Encode</Button
        >

        {
          /* Live readout — in the controls card so the input/output editors keep
            the exact structure the global equal-height rule aligns. */
        }
        <div class="b64-readout" id="b64-readout" hidden>
          <div class="b64-valid" id="b64-valid" hidden>
            <span class="b64-dot" id="b64-dot"></span>
            <span class="caption-mono" id="b64-valid-text"></span>
          </div>
          <div class="b64-row">
            <span class="b64-label caption-mono">input</span>
            <span class="b64-val" id="b64-in">0</span>
          </div>
          <div class="b64-row">
            <span class="b64-label caption-mono">output</span>
            <span class="b64-val b64-accent" id="b64-out">0</span>
          </div>
          <div class="b64-meter" aria-hidden="true">
            <span class="b64-meter-fill" id="b64-meter" style="width: 0%"></span>
          </div>
          <p class="b64-ratio caption-mono" id="b64-ratio">×100%</p>
          <div class="b64-chip" id="b64-chip" hidden>
            <span class="b64-chip-dot" aria-hidden="true"></span>
            <span class="caption-mono" id="b64-chip-text"></span>
          </div>
        </div>

        <ErrorBanner id="b64-error" />

        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="b64-status-dot"></span></span>
          <span class="sr-only" id="b64-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="b64-output"
          label="Base64 output"
          placeholder="Result appears here…"
          readonly
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="b64-output-status">Output: Empty</span>
            <span class="info-meta" id="b64-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <section class="tool-content-section" aria-labelledby="how-title">
    <Container size="narrow">
      <div class="content-section-header">
        <span class="caption-mono section-eyebrow">HOW IT WORKS</span>
        <h2 id="how-title" class="display-md section-title">Encode or decode in three steps</h2>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number" aria-hidden="true">1</span>
          <h3 class="body-sm-strong step-title">Paste or upload</h3>
          <p class="caption step-desc">
            Text to encode, or Base64 to decode. It recomputes live as you type.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">2</span>
          <h3 class="body-sm-strong step-title">Pick the variant</h3>
          <p class="caption step-desc">
            Standard or URL-safe alphabet, with or without padding, optionally wrapped as a data
            URI.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">3</span>
          <h3 class="body-sm-strong step-title">Read &amp; copy</h3>
          <p class="caption step-desc">
            Watch the expansion meter, see what a decoded blob actually is, then copy or download.
          </p>
        </div>
      </div>
    </Container>
  </section>
  <ToolNudge />
  <CompareLinks />

  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my input uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Encoding and decoding run entirely in your browser, in a background worker for large
            inputs. Nothing you paste leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What's the difference between Standard and URL-safe?</summary
          >
          <p class="body-md faq-answer">
            Standard Base64 uses <code>+</code> and <code>/</code>, which are awkward inside URLs
            and filenames. URL-safe swaps them for <code>-</code> and <code>_</code> and usually drops
            the <code>=</code> padding — it's what JWTs and most tokens use.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Why does the output get bigger when I encode?</summary>
          <p class="body-md faq-answer">
            Base64 represents every 3 bytes of input as 4 printable characters, so encoded text is
            always at least ~33% larger than its byte length — more for non-ASCII, since characters
            like emoji expand to several bytes first. The meter shows that ratio live.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What does the tag on decode mean?</summary>
          <p class="body-md faq-answer">
            When you decode, the tool reads the first bytes of the result and names common formats —
            PNG, JPEG, PDF, GIF, WebP, ZIP, gzip — or marks it as JSON or plain text. If the payload
            is binary, you get a clean byte count instead of unreadable characters.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { base64Store } from "../../lib/tools/base64/store";
  import {
    handleInput,
    transform,
    loadSample,
    clearAll,
    setMode,
    setVariant,
    setPadding,
    setDataUri,
    setMime,
  } from "../../lib/tools/base64/actions";
  import type { Base64Mode, Base64Variant } from "../../lib/tools/base64/types";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const inTextarea = document.getElementById("b64-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById("b64-output-textarea") as HTMLTextAreaElement | null;
  const inStatus = document.getElementById("b64-input-status") as HTMLElement | null;
  const inCount = document.getElementById("b64-input-count") as HTMLElement | null;
  const outStatus = document.getElementById("b64-output-status") as HTMLElement | null;
  const outCount = document.getElementById("b64-output-count") as HTMLElement | null;
  const runBtn = document.getElementById("run-btn") as HTMLButtonElement | null;
  const paddingCb = document.getElementById("b64-padding") as HTMLInputElement | null;
  const dataUriCb = document.getElementById("b64-datauri") as HTMLInputElement | null;
  const mimeSel = document.getElementById("b64-mime") as HTMLSelectElement | null;
  const wrapGroup = document.getElementById("b64-wrap-group") as HTMLElement | null;
  const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-b64-mode]"));
  const varBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-b64-variant]"));
  const errorBanner = document.getElementById("b64-error") as HTMLElement | null;
  const statusDot = document.getElementById("b64-status-dot") as HTMLElement | null;

  const readout = document.getElementById("b64-readout") as HTMLElement | null;
  const validBox = document.getElementById("b64-valid") as HTMLElement | null;
  const validDot = document.getElementById("b64-dot") as HTMLElement | null;
  const validText = document.getElementById("b64-valid-text") as HTMLElement | null;
  const inVal = document.getElementById("b64-in") as HTMLElement | null;
  const outVal = document.getElementById("b64-out") as HTMLElement | null;
  const meter = document.getElementById("b64-meter") as HTMLElement | null;
  const ratio = document.getElementById("b64-ratio") as HTMLElement | null;
  const chip = document.getElementById("b64-chip") as HTMLElement | null;
  const chipText = document.getElementById("b64-chip-text") as HTMLElement | null;

  initAnnounce("b64-announce");

  const fmt = (n: number): string => n.toLocaleString();

  const recompute = debounce(() => {
    if (inTextarea) handleInput(base64Store, inTextarea.value);
    transform(base64Store, false);
  }, 200);

  base64Store.subscribe((state) => {
    const focused = inTextarea && document.activeElement === inTextarea;
    if (inTextarea && inTextarea.value !== state.input && !focused) {
      inTextarea.value = state.input;
      inTextarea.dispatchEvent(new Event("editor-refresh"));
    }
    const outText = state.result ? state.result.output : "";
    if (outTextarea && outTextarea.value !== outText) {
      outTextarea.value = outText;
      outTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // segmented controls
    modeBtns.forEach((b) => {
      const on = b.getAttribute("data-b64-mode") === state.mode;
      b.classList.toggle("is-active", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });
    varBtns.forEach((b) => {
      const on = b.getAttribute("data-b64-variant") === state.variant;
      b.classList.toggle("is-active", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });

    // run button label + state
    if (runBtn) {
      if (state.isRunning) {
        runBtn.textContent = state.mode === "encode" ? "Encoding…" : "Decoding…";
        runBtn.disabled = true;
      } else if (state.needsManual) {
        runBtn.textContent =
          state.mode === "encode" ? "Encode (large input)" : "Decode (large input)";
        runBtn.disabled = false;
      } else {
        runBtn.textContent = state.mode === "encode" ? "Encode" : "Decode";
        runBtn.disabled = false;
      }
    }

    // data-URI group only meaningful while encoding
    if (wrapGroup) wrapGroup.classList.toggle("is-disabled", state.mode !== "encode");
    if (mimeSel) mimeSel.disabled = state.mode !== "encode" || !state.dataUri;

    // input status bar
    if (inStatus) {
      if (state.inputStatus === "empty") {
        inStatus.textContent = "Status: Empty";
        inStatus.style.color = "";
      } else if (state.inputStatus === "invalid") {
        inStatus.textContent =
          state.mode === "decode" ? "Status: Invalid Base64" : "Status: Too large";
        inStatus.style.color = "var(--color-error)";
      } else {
        inStatus.textContent = state.mode === "decode" ? "Status: Valid Base64" : "Status: Ready";
        inStatus.style.color = "var(--color-success)";
      }
    }
    if (inCount) inCount.textContent = state.input.length.toLocaleString() + " chars";

    // output status bar
    if (outStatus) {
      if (!state.result) {
        outStatus.textContent = "Output: Empty";
        outStatus.style.color = "";
      } else if (state.mode === "encode") {
        outStatus.textContent = "Output: Encoded";
        outStatus.style.color = "var(--color-success)";
      } else if (state.result.binary) {
        outStatus.textContent = "Output: Binary";
        outStatus.style.color = "var(--color-warning)";
      } else {
        outStatus.textContent = "Output: Decoded";
        outStatus.style.color = "var(--color-success)";
      }
    }
    if (outCount)
      outCount.textContent =
        (state.result ? state.result.output.length : 0).toLocaleString() + " chars";

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(
        state.isRunning ? "active" : state.inputStatus === "invalid" ? "error" : "idle",
      );
    }

    // readout
    if (readout) {
      if (state.result) {
        readout.hidden = false;
        const r = state.result;
        if (inVal)
          inVal.textContent =
            state.mode === "encode"
              ? `${fmt(r.inputChars)} chars · ${fmt(r.inputBytes)} B`
              : `${fmt(r.inputChars)} chars`;
        if (outVal)
          outVal.textContent =
            state.mode === "encode"
              ? `${fmt(r.outputChars)} chars`
              : r.binary
                ? `${fmt(r.outputBytes)} B`
                : `${fmt(r.outputChars)} chars`;
        if (ratio) ratio.textContent = `×${r.ratio}%`;
        if (meter) meter.style.width = Math.min(r.ratio, 400) / 4 + "%"; // 400% → full bar
        // validity line (decode)
        if (validBox) {
          if (state.mode === "decode") {
            validBox.hidden = false;
            if (validDot) validDot.className = "b64-dot " + (r.binary ? "warn" : "ok");
            if (validText)
              validText.textContent = r.binary ? "decoded binary payload" : "decoded to text";
          } else {
            validBox.hidden = true;
          }
        }
        // signature chip (decode)
        if (chip) {
          if (state.mode === "decode" && r.looksLike) {
            chip.hidden = false;
            if (chipText) chipText.textContent = r.looksLike;
            chip.classList.toggle("is-binary", r.binary);
          } else {
            chip.hidden = true;
          }
        }
      } else {
        readout.hidden = true;
      }
    }

    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
  });

  if (inTextarea) inTextarea.addEventListener("input", recompute);

  if (runBtn) runBtn.addEventListener("click", () => transform(base64Store, true));
  if (paddingCb)
    paddingCb.addEventListener("change", () => setPadding(base64Store, paddingCb.checked));
  if (dataUriCb)
    dataUriCb.addEventListener("change", () => {
      setDataUri(base64Store, dataUriCb.checked);
      if (mimeSel) mimeSel.disabled = !dataUriCb.checked;
    });
  if (mimeSel) mimeSel.addEventListener("change", () => setMime(base64Store, mimeSel.value));
  modeBtns.forEach((b) =>
    b.addEventListener("click", () =>
      setMode(base64Store, b.getAttribute("data-b64-mode") as Base64Mode),
    ),
  );
  varBtns.forEach((b) =>
    b.addEventListener("click", () =>
      setVariant(base64Store, b.getAttribute("data-b64-variant") as Base64Variant),
    ),
  );

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(base64Store);
        announce("Sample loaded");
      }
      if (action === "clear") {
        clearAll(base64Store);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      const out = base64Store.get().result?.output ?? "";
      if (action === "copy") {
        const ok = out ? await copyToClipboard(out) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("Output copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        if (out) {
          const ext = base64Store.get().mode === "encode" ? "b64.txt" : "decoded.txt";
          downloadFile(out, ext, "text/plain;charset=utf-8;");
          announce("Download started");
        }
      }
    });
  }

  const dropZone = document.getElementById("b64-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(base64Store, detail.text);
        transform(base64Store, true);
        announce("File loaded: " + (detail.name || "file"));
      }
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      transform(base64Store, true);
    }
  });
</script>

<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }

  .settings-card {
    padding: var(--spacing-lg);
  }
  .settings-title {
    margin: 0;
  }
  .settings-divider {
    height: 1px;
    background-color: var(--color-hairline);
    margin: var(--spacing-xs) 0;
  }
  .settings-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }
  .settings-label {
    color: var(--color-mute);
    font-size: 11px;
    font-weight: 600;
  }
  .select-wrapper {
    position: relative;
    width: 100%;
  }
  .settings-select {
    width: 100%;
    height: 38px;
    padding: 0 var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    appearance: none;
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .settings-select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .select-wrapper::after {
    content: "▼";
    font-size: 9px;
    color: var(--color-body);
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* segmented control — the direction / alphabet switch */
  .seg {
    display: inline-flex;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    overflow: hidden;
  }
  .seg-btn {
    flex: 1;
    border: none;
    background: var(--color-canvas);
    color: var(--color-body);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    padding: 8px 12px;
    cursor: pointer;
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }
  .seg-btn + .seg-btn {
    border-left: 1px solid var(--color-hairline);
  }
  .seg-btn.is-active {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .seg-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .checkbox-group {
    margin-bottom: var(--spacing-sm);
  }
  .checkbox-container {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    padding-left: 24px;
    cursor: pointer;
    user-select: none;
    color: var(--color-ink);
  }
  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
