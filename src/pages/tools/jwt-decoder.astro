---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { INDENT_OPTIONS } from "../../lib/tools/jwt-decoder/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
---

<ToolShell
  title="JWT Decoder — Decode JSON Web Tokens Online (Free, Local)"
  description="Free online JWT decoder. Inspect the header, payload, and signature of a JSON Web Token, with exp/iat/nbf as human dates — 100% local, decode only, never verifies."
  activePath="/tools/jwt-decoder"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "JWT Decoder" }]}
    title="JWT Decoder"
    subtitle="Open up a token's header and payload — without sending it anywhere."
  />
  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT TOKEN</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <CodeEditor
          id="jwt-input"
          label="JWT input"
          placeholder={`Paste a JWT to decode it
header.payload.signature`}
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="jwt-status">Token: Empty</span>
            <span class="info-meta" id="jwt-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Decode</h2>
        <div class="settings-divider"></div>
        <div class="jwt-warning" role="note">
          <span class="jwt-warning-icon" aria-hidden="true">⚠</span>
          <div class="jwt-warning-text">
            <strong class="jwt-warning-title">Decoded, not verified.</strong>
            <span class="jwt-warning-body">
              We have no key — this token's signature is not checked here. Never treat a decoded
              payload as trustworthy.
            </span>
          </div>
        </div>
        <div class="settings-group">
          <label class="settings-label caption-mono" for="indent-select">JSON indent</label>
          <div class="select-wrapper">
            <select id="indent-select" class="settings-select">
              {INDENT_OPTIONS.map((opt) => <option value={opt.value}>{opt.label}</option>)}
            </select>
          </div>
        </div>
        <div class="settings-divider"></div>
        <Button id="decode-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Decode token
        </Button>
        <ErrorBanner id="decode-error" />
        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="status-dot"></span></span>
          <span class="sr-only" id="decode-status-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>
    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">DECODED</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="jwt-output"
          label="Decoded JWT output"
          placeholder="Decoded header, payload, and signature will appear here..."
          readonly
        >
          <div class="editor-info-bar" slot>
            <span class="info-status" id="jwt-output-status">Output: Empty</span>
            <span class="info-meta" id="jwt-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>
  <section class="tool-content-section" aria-labelledby="how-title">
    <Container size="narrow">
      <div class="content-section-header">
        <span class="caption-mono section-eyebrow">HOW IT WORKS</span>
        <h2 id="how-title" class="display-md section-title">Decode a JWT in three steps</h2>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number" aria-hidden="true">1</span>
          <h3 class="body-sm-strong step-title">Paste the token</h3>
          <p class="caption step-desc">
            A full header.payload.signature string — a leading "Bearer " is stripped for you.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">2</span>
          <h3 class="body-sm-strong step-title">Decode</h3>
          <p class="caption step-desc">
            Header and payload are base64url-decoded and pretty-printed, right on your machine.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">3</span>
          <h3 class="body-sm-strong step-title">Read the claims</h3>
          <p class="caption step-desc">
            exp / iat / nbf become human dates with an expired / valid-so-far indicator.
          </p>
        </div>
      </div>
    </Container>
  </section>
  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />
  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Does this verify my token's signature?</summary>
          <p class="body-md faq-answer">
            No — and it can't. Verification needs the signing key (a secret or a public key), which
            only the issuer holds. This tool decodes the visible parts and tells you plainly that
            the signature was not checked. Anyone who warns you otherwise is guessing.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Is my token uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Decoding is base64url + JSON.parse, done entirely in your browser. Tokens are
            credentials — pasting one into a site that uploads it is how they get stolen. This one
            has no network path for it to travel.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What does "expired" mean here?</summary>
          <p class="body-md faq-answer">
            It's a <em>time</em> fact, not a signature fact. If the <code>exp</code> claim is in the past,
            the token is expired by its own terms — but that says nothing about whether it was ever legitimately
            signed.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What about <code>alg: "none"</code>?</summary>
          <p class="body-md faq-answer">
            A token with <code>alg: "none"</code> and no signature is unsigned — anyone could have created
            it. The decoder calls this out loudly. Servers that accept such tokens have a serious vulnerability.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>
<script>
  import { jwtDecoderStore } from "../../lib/tools/jwt-decoder/store";
  import {
    handleInput,
    decode,
    loadSample,
    clearAll,
    setIndent,
  } from "../../lib/tools/jwt-decoder/actions";
  import { buildOutput } from "../../lib/tools/jwt-decoder/engine";
  import type { IndentOption } from "../../lib/tools/jwt-decoder/types";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const tokenTextarea = document.getElementById("jwt-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById("jwt-output-textarea") as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("jwt-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("jwt-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("jwt-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("jwt-output-count") as HTMLElement | null;
  const indentSelect = document.getElementById("indent-select") as HTMLSelectElement | null;
  const decodeBtn = document.getElementById("decode-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("decode-error") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;

  initAnnounce("decode-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(jwtDecoderStore, value);
  }, 150);

  let lastOut = "";

  jwtDecoderStore.subscribe((state) => {
    const inputFocused = tokenTextarea && document.activeElement === tokenTextarea;
    if (tokenTextarea && tokenTextarea.value !== state.tokenInput && !inputFocused) {
      tokenTextarea.value = state.tokenInput;
      tokenTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Output only changes on an authoritative Decode — live results update the
    // status bar alone, so Load Sample stays load-only and typing never churns.
    if (state.result && state.result.authoritative) {
      const out = buildOutput(state.result);
      if (out !== lastOut) {
        lastOut = out;
        if (outTextarea && outTextarea.value !== out) {
          outTextarea.value = out;
          outTextarea.dispatchEvent(new Event("editor-refresh"));
        }
      }
    }

    if (inputStatus) {
      if (state.inputStatus === "empty") {
        inputStatus.textContent = "Token: Empty";
        inputStatus.style.color = "";
      } else if (state.result && !state.result.ok && state.result.error) {
        const seg = state.result.error.segment ? ` · ${state.result.error.segment}` : "";
        inputStatus.textContent = `Token: Invalid${seg}`;
        inputStatus.style.color = "var(--color-error)";
      } else if (state.result && state.result.ok) {
        inputStatus.textContent = state.result.expired
          ? "Token: Decodable · expired"
          : "Token: Decodable";
        inputStatus.style.color = state.result.expired
          ? "var(--color-warning)"
          : "var(--color-success)";
      } else {
        inputStatus.textContent = "Token: Ready";
        inputStatus.style.color = "";
      }
    }
    if (inputCharCount)
      inputCharCount.textContent = state.tokenInput.length.toLocaleString() + " chars";

    if (outputStatus) {
      outputStatus.textContent =
        state.outputStatus === "valid"
          ? "Output: Decoded (not verified)"
          : state.outputStatus === "invalid"
            ? "Output: Error"
            : "Output: Empty";
      outputStatus.style.color =
        state.outputStatus === "valid"
          ? "var(--color-warning)"
          : state.outputStatus === "invalid"
            ? "var(--color-error)"
            : "";
    }
    if (outputCharCount) outputCharCount.textContent = lastOut.length.toLocaleString() + " chars";

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(state.outputStatus === "invalid" ? "error" : "idle");
    }

    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
    if (state.result && state.result.authoritative && state.result.ok)
      announce("Token decoded — signature not verified");
    if (state.result && state.result.authoritative && !state.result.ok)
      announce("Token could not be decoded");
  });

  if (tokenTextarea) {
    tokenTextarea.addEventListener("input", () => debouncedInput(tokenTextarea.value));
  }
  if (decodeBtn) decodeBtn.addEventListener("click", () => decode(jwtDecoderStore));
  if (indentSelect)
    indentSelect.addEventListener("change", () =>
      setIndent(jwtDecoderStore, indentSelect.value as IndentOption),
    );

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(jwtDecoderStore);
        announce("Sample token loaded");
      }
      if (action === "clear") {
        clearAll(jwtDecoderStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "copy") {
        const ok = lastOut ? await copyToClipboard(lastOut) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("Decoded output copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        if (lastOut) {
          downloadFile(lastOut, "jwt-decoded.txt", "text/plain;charset=utf-8;");
          announce("Download started");
        } else {
          announce("Nothing to download yet");
        }
      }
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      decode(jwtDecoderStore);
    }
  });
</script>
<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }
  .settings-card {
    padding: var(--spacing-lg);
  }
  .settings-title {
    margin: 0;
  }
  .settings-divider {
    height: 1px;
    background-color: var(--color-hairline);
    margin: var(--spacing-xs) 0;
  }
  .settings-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }
  .settings-label {
    color: var(--color-mute);
    font-size: 11px;
    font-weight: 600;
  }
  .select-wrapper {
    position: relative;
    width: 100%;
  }
  .settings-select {
    width: 100%;
    height: 38px;
    padding: 0 var(--spacing-md);
    font-family: var(--font-sans);
    font-size: 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    appearance: none;
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .settings-select:focus {
    border-color: var(--color-hairline-strong);
  }
  .select-wrapper::after {
    content: "▼";
    font-size: 9px;
    color: var(--color-body);
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .jwt-warning {
    display: flex;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    margin-bottom: var(--spacing-md);
    border: 1px solid rgba(245, 166, 35, 0.4);
    border-left: 3px solid var(--color-warning);
    border-radius: var(--rounded-sm);
    background-color: rgba(245, 166, 35, 0.08);
  }
  .jwt-warning-icon {
    color: var(--color-warning);
    font-size: 15px;
    line-height: 1.4;
    flex: none;
  }
  .jwt-warning-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .jwt-warning-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .jwt-warning-body {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-body);
  }
  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }
  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .tool-content-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
  }
  .content-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }
  .step-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-lg);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    text-align: center;
    align-items: center;
  }
  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--rounded-full);
    background-color: var(--color-accent);
    color: var(--color-on-primary);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }
  .step-title {
    color: var(--color-ink);
    margin: 0;
  }
  .step-desc {
    color: var(--color-body);
    margin: 0;
    line-height: 1.5;
  }
  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }
  .faq-answer code {
    font-family: var(--font-mono);
    font-size: 12px;
    background-color: var(--color-canvas-soft-2);
    padding: 1px 4px;
    border-radius: var(--rounded-xs);
  }
  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
    .steps-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
