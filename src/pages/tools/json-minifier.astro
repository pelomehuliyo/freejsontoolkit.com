---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
---

<ToolShell
  title="JSON Minifier — Compress JSON Online (Free, Local)"
  description="Free online JSON minifier. Strip whitespace to shrink JSON to a single line while preserving every value — 100% local, no upload, no server."
  activePath="/tools/json-minifier"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "JSON Minifier" }]}
    title="JSON Minifier"
    subtitle="Strip whitespace and shrink JSON to a single line — offline."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT JSON</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone id="json-input" accept=".json" label="Upload JSON file" />
        <CodeEditor
          id="json-input"
          label="JSON input"
          placeholder='Paste JSON to minify it
Example:
{ "id": 1, "name": "Ada" }'
        >
          <div class="editor-info-bar">
            <span class="info-status" id="json-validation-status">JSON Status: Empty</span>
            <span class="info-meta" id="json-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group checkbox-group">
          <label class="checkbox-container body-sm">
            <input type="checkbox" id="sort-keys-checkbox" />
            <span class="checkbox-checkmark"></span>
            Sort object keys (A→Z)
          </label>
          <p class="caption settings-help">
            Deterministic output for diffing. Values are never changed.
          </p>
        </div>

        <div class="settings-divider"></div>

        <Button id="minify-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Minify JSON
        </Button>

        {
          /* Compression readout — lives here (not in the output card) so the
            input/output editors keep the exact structure the global
            equal-height rule aligns. Revealed after a successful minify; the
            fill bar animates its width for living feedback. */
        }
        <div class="mf-stats" id="mf-stats" hidden>
          <div class="mf-row">
            <span class="mf-label caption-mono">before</span>
            <span class="mf-val" id="mf-before">0</span>
          </div>
          <div class="mf-row">
            <span class="mf-label caption-mono">after</span>
            <span class="mf-val mf-accent" id="mf-after">0</span>
          </div>
          <div class="mf-row">
            <span class="mf-label caption-mono">saved</span>
            <span class="mf-val" id="mf-saved">0</span>
          </div>
          <div class="mf-bar" aria-hidden="true">
            <span class="mf-bar-fill" id="mf-bar" style="width: 0%"></span>
          </div>
          <p class="mf-pct caption-mono" id="mf-pct">0% smaller</p>
        </div>

        <ErrorBanner id="minify-error" />

        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="status-dot"></span></span>
          <span class="sr-only" id="minify-status-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">MINIFIED OUTPUT</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="minified-output"
          label="Minified JSON output"
          placeholder="Minified JSON will appear here..."
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="minified-output-status">Output: Empty</span>
            <span class="info-meta" id="minified-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <section class="tool-content-section" aria-labelledby="how-title">
    <Container size="narrow">
      <div class="content-section-header">
        <span class="caption-mono section-eyebrow">HOW IT WORKS</span>
        <h2 id="how-title" class="display-md section-title">Minify JSON in three steps</h2>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number" aria-hidden="true">1</span>
          <h3 class="body-sm-strong step-title">Paste or upload</h3>
          <p class="caption step-desc">
            Drop in formatted or pretty-printed JSON — validity is checked as you type.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">2</span>
          <h3 class="body-sm-strong step-title">Minify</h3>
          <p class="caption step-desc">
            Whitespace is stripped to a single line. Optionally sort keys for a deterministic
            result.
          </p>
        </div>
        <div class="step-card">
          <span class="step-number" aria-hidden="true">3</span>
          <h3 class="body-sm-strong step-title">Copy &amp; ship</h3>
          <p class="caption step-desc">
            Grab the smaller payload — copy to clipboard or download — and watch the saved-bytes
            readout.
          </p>
        </div>
      </div>
    </Container>
  </section>
  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />

  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my JSON uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Minification runs entirely in your browser, in a background worker for large files.
            Your data never leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Does minifying change my data?</summary>
          <p class="body-md faq-answer">
            Only the whitespace. Every key, value, number, and array order is preserved exactly. The
            optional "sort keys" reorders object properties alphabetically but never alters values.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">When should I minify?</summary>
          <p class="body-md faq-answer">
            When size matters more than readability — embedding JSON in a bundle, sending it over a
            slow link, or storing many records. For editing or debugging, the Formatter (beautifier)
            is the better tool; minified JSON is intentionally hard for humans to read.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { jsonMinifierStore } from "../../lib/tools/json-minifier/store";
  import {
    handleInput,
    minify,
    loadSample,
    clearAll,
    setSortKeys,
  } from "../../lib/tools/json-minifier/actions";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const jsonTextarea = document.getElementById("json-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById(
    "minified-output-textarea",
  ) as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("json-validation-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("json-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("minified-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("minified-output-count") as HTMLElement | null;
  const sortCheckbox = document.getElementById("sort-keys-checkbox") as HTMLInputElement | null;
  const minifyBtn = document.getElementById("minify-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("minify-error") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;

  const statsEl = document.getElementById("mf-stats") as HTMLElement | null;
  const mfBefore = document.getElementById("mf-before") as HTMLElement | null;
  const mfAfter = document.getElementById("mf-after") as HTMLElement | null;
  const mfSaved = document.getElementById("mf-saved") as HTMLElement | null;
  const mfBar = document.getElementById("mf-bar") as HTMLElement | null;
  const mfPct = document.getElementById("mf-pct") as HTMLElement | null;

  initAnnounce("minify-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(jsonMinifierStore, value);
  }, 150);

  const fmt = (n: number): string => n.toLocaleString();

  jsonMinifierStore.subscribe((state) => {
    const inputFocused = jsonTextarea && document.activeElement === jsonTextarea;
    if (jsonTextarea && jsonTextarea.value !== state.jsonInput && !inputFocused) {
      jsonTextarea.value = state.jsonInput;
      jsonTextarea.dispatchEvent(new Event("editor-refresh"));
    }
    if (outTextarea && outTextarea.value !== (state.result ? state.result.output : "")) {
      outTextarea.value = state.result ? state.result.output : "";
      outTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    if (inputStatus) {
      if (state.inputStatus === "empty") {
        inputStatus.textContent = "JSON Status: Empty";
        inputStatus.style.color = "";
      } else if (state.inputStatus === "invalid") {
        inputStatus.textContent = "JSON Status: Invalid";
        inputStatus.style.color = "var(--color-error)";
      } else {
        inputStatus.textContent = "JSON Status: Valid";
        inputStatus.style.color = "var(--color-success)";
      }
    }
    if (inputCharCount)
      inputCharCount.textContent = state.jsonInput.length.toLocaleString() + " chars";

    if (outputStatus) {
      outputStatus.textContent =
        state.outputStatus === "minified" ? "Output: Minified" : "Output: Empty";
      outputStatus.style.color = state.outputStatus === "minified" ? "var(--color-success)" : "";
    }
    if (outputCharCount)
      outputCharCount.textContent =
        (state.result ? state.result.minifiedChars : 0).toLocaleString() + " chars";

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(
        state.isMinifying ? "active" : state.inputStatus === "invalid" ? "error" : "idle",
      );
    }

    if (minifyBtn) {
      minifyBtn.textContent = state.isMinifying ? "Minifying…" : "Minify JSON";
      minifyBtn.disabled = state.isMinifying;
    }

    // compression readout
    if (statsEl) {
      if (state.result) {
        statsEl.hidden = false;
        const r = state.result;
        if (mfBefore) mfBefore.textContent = fmt(r.originalChars);
        if (mfAfter) mfAfter.textContent = fmt(r.minifiedChars);
        if (mfSaved) mfSaved.textContent = fmt(r.saved);
        if (mfPct) mfPct.textContent = r.reduction + "% smaller";
        if (mfBar) mfBar.style.width = r.reduction + "%"; // CSS transition animates it
      } else {
        statsEl.hidden = true;
      }
    }

    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
    if (state.result && !state.isMinifying)
      announce("Minified: " + state.result.reduction + "% smaller");
  });

  if (jsonTextarea) {
    jsonTextarea.addEventListener("input", () => debouncedInput(jsonTextarea.value));
  }
  if (minifyBtn) minifyBtn.addEventListener("click", () => minify(jsonMinifierStore));
  if (sortCheckbox)
    sortCheckbox.addEventListener("change", () =>
      setSortKeys(jsonMinifierStore, sortCheckbox.checked),
    );

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(jsonMinifierStore);
        announce("Sample JSON loaded");
      }
      if (action === "clear") {
        clearAll(jsonMinifierStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      const out = jsonMinifierStore.get().result?.output ?? "";
      if (action === "copy") {
        const ok = out ? await copyToClipboard(out) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("Minified JSON copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        if (out) {
          downloadFile(out, "minified.json", "application/json;charset=utf-8;");
          announce("Download started");
        }
      }
    });
  }

  const dropZone = document.getElementById("json-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(jsonMinifierStore, detail.text);
        minify(jsonMinifierStore);
        announce("File loaded: " + (detail.name || "file"));
      }
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      minify(jsonMinifierStore);
    }
  });
</script>

<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }

  .settings-card {
    padding: var(--spacing-lg);
  }
  .settings-title {
    margin: 0;
  }
  .settings-divider {
    height: 1px;
    background-color: var(--color-hairline);
    margin: var(--spacing-xs) 0;
  }
  .settings-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }
  .checkbox-group {
    margin-bottom: var(--spacing-sm);
  }
  .checkbox-container {
    display: flex;
    align-items: center;
    position: relative;
    padding-left: 24px;
    cursor: pointer;
    user-select: none;
    color: var(--color-ink);
  }
  .checkbox-container input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }
  .checkbox-checkmark {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 0;
    height: 16px;
    width: 16px;
    border: 1px solid var(--color-hairline-strong);
    border-radius: 4px;
    background-color: var(--color-canvas);
    transition:
      background-color 0.1s ease,
      border-color 0.1s ease;
  }
  .checkbox-container:hover input ~ .checkbox-checkmark {
    border-color: var(--color-ink);
  }
  .checkbox-container input:checked ~ .checkbox-checkmark {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .checkbox-checkmark::after {
    content: "";
    position: absolute;
    display: none;
  }
  .checkbox-container input:checked ~ .checkbox-checkmark::after {
    display: block;
  }
  .checkbox-container .checkbox-checkmark::after {
    left: 5px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .settings-help {
    color: var(--color-mute);
    margin: 4px 0 0 24px;
    line-height: 1.4;
  }
  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }

  /* compression readout */
  .mf-stats {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mf-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .mf-label {
    color: var(--color-mute);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mf-val {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .mf-val.mf-accent {
    color: var(--color-accent-active);
  }
  .mf-bar {
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline);
    overflow: hidden;
    margin-top: 2px;
  }
  .mf-bar-fill {
    display: block;
    height: 100%;
    background-color: var(--color-accent);
    transition: width 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .mf-pct {
    margin: 0;
    color: var(--color-accent-active);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .tool-content-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
  }
  .content-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }
  .step-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-lg);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    text-align: center;
    align-items: center;
  }
  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--rounded-full);
    background-color: var(--color-accent);
    color: var(--color-on-primary);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }
  .step-title {
    color: var(--color-ink);
    margin: 0;
  }
  .step-desc {
    color: var(--color-body);
    margin: 0;
    line-height: 1.5;
  }
  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }

  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
    .steps-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
</style>
