---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import HowItWorks from "../../components/tools/HowItWorks.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { INDENT_OPTIONS } from "../../lib/tools/xml-to-json/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
import "../../styles/tool-options.css";
---

<ToolShell
  title="XML to JSON Converter — Free Online, Local"
  description="Free online XML to JSON converter. Parse XML documents into clean JSON objects with attribute handling and array preservation — 100% local, no upload, no server."
  activePath="/tools/xml-to-json"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "XML to JSON" }]}
    title="XML → JSON Converter"
    subtitle="Turn XML documents into structured JSON."
  />

  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT XML</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone id="xml-input" accept=".xml,.svg,.rss" label="Upload XML file" />
        <CodeEditor
          id="xml-input"
          label="XML input"
          placeholder='<root><item id="1">Hello</item></root>'
        >
          <div class="editor-info-bar">
            <span class="info-status" id="xml-validation-status">Status: Empty</span>
            <span class="info-meta" id="xml-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>

    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <h2 class="display-sm settings-title">Options</h2>
        <div class="settings-divider"></div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="include-attrs" checked />
            <span class="box"></span>
            Include attributes <span class="caption-mono">(@id)</span>
          </label>
        </div>

        <div class="settings-group">
          <label class="opt-check">
            <input type="checkbox" id="preserve-arrays" checked />
            <span class="box"></span>
            Preserve arrays
          </label>
          <p class="settings-help">
            Keeps repeated elements as arrays. Turn off to collapse to the last value.
          </p>
        </div>

        <div class="settings-group">
          <span class="settings-label">Output indentation</span>
          <div class="seg" id="indent-select" role="group" aria-label="Output indentation">
            {INDENT_OPTIONS.map((opt) => (
              <button type="button" class="seg-btn" data-value={opt.value}>
                {opt.label}
              </button>
            ))}
          </div>
        </div>

        <div class="settings-divider"></div>

        <Button id="convert-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Convert
        </Button>

        <ErrorBanner id="convert-error" />

        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="status-dot"></span></span>
          <span class="sr-only" id="convert-status-announce" aria-live="polite"></span>
          Local sandbox active
        </div>
      </Card>
    </div>

    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT JSON</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="json-output"
          label="JSON output"
          placeholder="JSON will appear here..."
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="json-output-status">Output: Empty</span>
            <span class="info-meta" id="json-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>

  <HowItWorks
    heading="Convert XML to JSON in three steps"
    steps={[
      { title: "Paste or upload", desc: "Drop in any XML: RSS, SVG, configs, or API responses." },
      {
        title: "Configure output",
        desc: "Choose whether to include attributes, preserve arrays, and set indentation.",
      },
      {
        title: "Convert & export",
        desc: "Click Convert, then copy or download the resulting JSON. All offline.",
      },
    ]}
  />

  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />
  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">Is my XML uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Conversion runs entirely in your browser (in a background worker). Your data never
            leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">How are XML attributes handled?</summary>
          <p class="body-md faq-answer">
            Attributes are prefixed with <code>@</code> in the JSON output (e.g., <code
              >"@id": "1"</code
            >). You can toggle them on/off.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What about CDATA and comments?</summary>
          <p class="body-md faq-answer">
            CDATA is treated as text. Comments, processing instructions, and DOCTYPE declarations
            are skipped for clean output.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Why are arrays sometimes single objects?</summary>
          <p class="body-md faq-answer">
            If "Preserve arrays" is off, a single child becomes an object. Turn it on to always get
            arrays for repeated tags.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>

<script>
  import { xmlToJsonStore } from "../../lib/tools/xml-to-json/store";
  import {
    handleInput,
    convert,
    loadSample,
    clearAll,
    setIncludeAttributes,
    setPreserveArrays,
    setIndent,
  } from "../../lib/tools/xml-to-json/actions";
  import type { IndentOption } from "../../lib/tools/xml-to-json/types";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const xmlTextarea = document.getElementById("xml-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById("json-output-textarea") as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("xml-validation-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("xml-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("json-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("json-output-count") as HTMLElement | null;
  const includeAttrsCb = document.getElementById("include-attrs") as HTMLInputElement | null;
  const preserveArraysCb = document.getElementById("preserve-arrays") as HTMLInputElement | null;
  const indentSeg = document.getElementById("indent-select") as HTMLElement | null;
  const indentBtns = indentSeg
    ? (Array.from(indentSeg.querySelectorAll("[data-value]")) as HTMLButtonElement[])
    : [];
  const convertBtn = document.getElementById("convert-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("convert-error") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;

  initAnnounce("convert-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(xmlToJsonStore, value);
  }, 200);

  xmlToJsonStore.subscribe((state) => {
    const inputFocused = xmlTextarea && document.activeElement === xmlTextarea;
    if (xmlTextarea && xmlTextarea.value !== state.xmlInput && !inputFocused) {
      xmlTextarea.value = state.xmlInput;
      xmlTextarea.dispatchEvent(new Event("editor-refresh"));
    }
    if (outTextarea && outTextarea.value !== state.jsonOutput) {
      outTextarea.value = state.jsonOutput;
      outTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    if (inputStatus) {
      switch (state.inputStatus) {
        case "empty":
          inputStatus.textContent = "Status: Empty";
          inputStatus.style.color = "";
          break;
        case "ready":
          inputStatus.textContent = "Status: Ready";
          inputStatus.style.color = "var(--color-success)";
          break;
        case "invalid":
          // Show the actual error from the store
          inputStatus.textContent = state.error
            ? `Status: Invalid — ${state.error}`
            : "Status: Invalid";
          inputStatus.style.color = "var(--color-error)";
          break;
      }
    }
    if (inputCharCount)
      inputCharCount.textContent = state.xmlInput.length.toLocaleString() + " chars";

    if (outputStatus) {
      outputStatus.textContent =
        state.outputStatus === "converted" ? "Output: JSON" : "Output: Empty";
      outputStatus.style.color = state.outputStatus === "converted" ? "var(--color-success)" : "";
    }
    if (outputCharCount)
      outputCharCount.textContent = state.jsonOutput.length.toLocaleString() + " chars";

    if (indentBtns.length) {
      indentBtns.forEach((b) => {
        b.classList.toggle("is-active", b.dataset.value === state.indent);
      });
    }

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(
        state.isConverting ? "active" : state.inputStatus === "invalid" ? "error" : "idle",
      );
    }

    if (convertBtn) {
      convertBtn.textContent = state.isConverting ? "Converting…" : "Convert";
      convertBtn.disabled = state.isConverting;
    }

    if (errorBanner) {
      if (state.error) (errorBanner as any).show?.(state.error);
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
  });

  if (xmlTextarea) {
    xmlTextarea.addEventListener("input", () => debouncedInput(xmlTextarea.value));
  }
  if (convertBtn) convertBtn.addEventListener("click", () => convert(xmlToJsonStore));
  if (includeAttrsCb)
    includeAttrsCb.addEventListener("change", () =>
      setIncludeAttributes(xmlToJsonStore, includeAttrsCb.checked),
    );
  if (preserveArraysCb)
    preserveArraysCb.addEventListener("change", () =>
      setPreserveArrays(xmlToJsonStore, preserveArraysCb.checked),
    );
  if (indentBtns.length) {
    indentBtns.forEach((b) =>
      b.addEventListener("click", () => setIndent(xmlToJsonStore, b.dataset.value as IndentOption)),
    );
  }

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(xmlToJsonStore);
        announce("Sample XML loaded");
      }
      if (action === "clear") {
        clearAll(xmlToJsonStore);
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      const out = xmlToJsonStore.get().jsonOutput;
      if (action === "copy") {
        const ok = out ? await copyToClipboard(out) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("JSON copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        if (out) {
          downloadFile(out, "xml-to-json-converted.json", "application/json;charset=utf-8;");
          announce("Download started");
        }
      }
    });
  }

  const dropZone = document.getElementById("xml-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        handleInput(xmlToJsonStore, detail.text);
        // Remove auto‑convert – user must click the button
        announce("File loaded: " + (detail.name || "file"));
      }
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      convert(xmlToJsonStore);
    }
  });
</script>

<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }

  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }

  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }

  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }
  .faq-answer code {
    font-family: var(--font-mono);
    font-size: 12px;
    background-color: var(--color-canvas-soft-2);
    padding: 1px 4px;
    border-radius: var(--rounded-xs);
  }

  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
</style>
