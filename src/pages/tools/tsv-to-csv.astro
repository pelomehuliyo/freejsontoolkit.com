---
import ToolShell from "../../components/tools/ToolShell.astro";
import ToolHeader from "../../components/tools/ToolHeader.astro";
import ToolWorkspace from "../../components/tools/ToolWorkspace.astro";
import CodeEditor from "../../components/tools/CodeEditor.astro";
import DragDropZone from "../../components/tools/DragDropZone.astro";
import ToolActions from "../../components/tools/ToolActions.astro";
import ErrorBanner from "../../components/tools/ErrorBanner.astro";
import HowItWorks from "../../components/tools/HowItWorks.astro";
import LearnLinks from "../../components/tools/LearnLinks.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import { LARGE_FILE_THRESHOLD_BYTES } from "../../lib/tools/tsv-to-csv/constants";
import RelatedTools from "../../components/tools/RelatedTools.astro";
import ToolDocs from "../../components/tools/ToolDocs.astro";
import CompareLinks from "../../components/tools/CompareLinks.astro";
import ToolNudge from "../../components/tools/ToolNudge.astro";
---

<ToolShell
  title="TSV to CSV Converter — Convert Tab-Separated Values to CSV Online (Free, Local)"
  description="Free online TSV to CSV converter. Paste or drop a tab-separated table and get clean, correctly quoted CSV — lossless, 100% local, no upload."
  activePath="/tools/tsv-to-csv"
>
  <ToolHeader
    slot="header"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "TSV → CSV" }]}
    title="TSV → CSV"
    subtitle="Turn tab-separated tables into clean, quoted CSV."
  />
  <ToolWorkspace slot="workspace" layout="3-col">
    <div slot="input" class="ws-fill">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">INPUT TSV</span>
          <ToolActions id="input-actions" variant="inset" actions={["sample", "clear"]} />
        </div>
        <DragDropZone
          id="tsv-input"
          accept=".tsv,.txt"
          label="Upload TSV file"
          largeThresholdBytes={LARGE_FILE_THRESHOLD_BYTES}
        />
        <CodeEditor
          id="tsv-input"
          label="TSV input"
          placeholder={`Paste TSV to convert it
name	role	city
Ada	Engineer	London`}
        >
          <div class="editor-info-bar">
            <span class="info-status" id="tsv-status">Status: Empty</span>
            <span class="info-meta" id="tsv-char-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
    <div slot="controls">
      <Card variant="flat" class="workspace-card settings-card">
        <Button id="convert-btn" variant="primary" size="lg" shape="square" class="action-btn">
          Convert
        </Button>
        <ErrorBanner id="convert-error" />
        <div class="status-banner caption">
          <span class="status-indicator"><span class="dot idle" id="status-dot"></span></span>
          <span class="status-phase" id="convert-phase" aria-hidden="true"></span>
          <span class="sr-only" id="convert-status-announce" aria-live="polite"></span>
          <span id="convert-status-text">Local sandbox active</span>
        </div>
      </Card>
    </div>
    <div slot="output" class="ws-fill ws-output">
      <Card variant="flat" class="workspace-card">
        <div class="card-header">
          <span class="caption-mono column-title">OUTPUT CSV</span>
          <ToolActions id="output-actions" variant="inset" actions={["copy", "download"]} />
        </div>
        <CodeEditor
          id="csv-output"
          label="CSV output"
          placeholder="Comma-separated output will appear here..."
          readonly
        >
          <div class="editor-info-bar">
            <span class="info-status" id="csv-output-status">Output: Empty</span>
            <span class="info-meta" id="csv-output-count">0 chars</span>
          </div>
        </CodeEditor>
      </Card>
    </div>
  </ToolWorkspace>
  <HowItWorks
    heading="Convert TSV in three steps"
    steps={[
      {
        title: "Paste or drop",
        desc: "Any tab-separated table. The shared RFC 4180 parser reads it with the delimiter pinned to tab.",
      },
      {
        title: "Convert",
        desc: "Press Convert (or Ctrl/⌘ + Enter). Big tables run in a background worker.",
      },
      {
        title: "Take the CSV",
        desc: "Copy or download the comma-separated result. Fields with commas come out quoted, correctly.",
      },
    ]}
  />
  <ToolDocs />
  <CompareLinks />
  <RelatedTools />
  <ToolNudge />
  <LearnLinks toolId="tsv-to-csv" />
  <section class="faq-section" aria-labelledby="faq-title">
    <Container size="narrow">
      <div class="faq-header">
        <span class="caption-mono section-eyebrow">FAQ</span>
        <h2 id="faq-title" class="display-md section-title">Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-summary">How does the large-file mode work?</summary>
          <p class="body-md faq-answer">
            If you drop a file larger than 15 MB, the tool switches to a background worker. It reads
            the file off the main thread, converts it in one pass, and gives you a capped preview in
            the editor. The full result is always available as a download. Nothing is uploaded.
            <a href="/large-files" style="color: var(--color-accent); font-weight: 500;"
              >Read the honest limits in our large-file guide →</a
            >
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Is my TSV uploaded anywhere?</summary>
          <p class="body-md faq-answer">
            No. Parsing and conversion run entirely in your browser (in a background worker for
            large tables). Your data never leaves your machine.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Can it handle large TSV files?</summary>
          <p class="body-md faq-answer">
            Yes. Files above about 15 MB switch to a dedicated large-file mode: the file is read and
            converted in a background worker, you see a capped preview in the editor, and the full
            CSV is a one-click download. Nothing is uploaded. The only ceiling is your device's
            memory. <a href="/large-files">See how large-file mode works →</a>
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">What happens to a field that contains a comma?</summary>
          <p class="body-md faq-answer">
            It's preserved and quoted. In TSV a comma is ordinary data; in CSV it's the delimiter,
            so the converter wraps that field in double quotes to keep it one cell.
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Is this conversion lossless?</summary>
          <p class="body-md faq-answer">
            Yes. CSV quoting can represent commas, double quotes, and even embedded newlines, so
            nothing from a valid TSV is dropped or refused. (The reverse, CSV → TSV, is the lossy
            direction, and that tool says so.)
          </p>
        </details>
        <details class="faq-item">
          <summary class="faq-summary">Do ragged rows work?</summary>
          <p class="body-md faq-answer">
            No. TSV → CSV needs a rectangular grid. Rows with a different number of fields fail
            with the exact line number instead of being silently padded or dropped, which would
            change your data.
          </p>
        </details>
      </div>
    </Container>
  </section>
</ToolShell>
<script>
  import { tsvToCsvStore } from "../../lib/tools/tsv-to-csv/store";
  import {
    handleInput,
    convert,
    convertLargeFile,
    clearAll,
    clearLargeFile,
    loadSample,
  } from "../../lib/tools/tsv-to-csv/actions";
  import { LARGE_FILE_PHASES } from "../../lib/tools/tsv-to-csv/constants";
  import { debounce } from "../../shared/debounce";
  import { announce, initAnnounce } from "../../shared/announce";
  import { copyToClipboard } from "../../shared/clipboard";
  import { downloadFile } from "../../shared/download";

  const tsvTextarea = document.getElementById("tsv-input-textarea") as HTMLTextAreaElement | null;
  const outTextarea = document.getElementById("csv-output-textarea") as HTMLTextAreaElement | null;
  const inputStatus = document.getElementById("tsv-status") as HTMLElement | null;
  const inputCharCount = document.getElementById("tsv-char-count") as HTMLElement | null;
  const outputStatus = document.getElementById("csv-output-status") as HTMLElement | null;
  const outputCharCount = document.getElementById("csv-output-count") as HTMLElement | null;
  const convertBtn = document.getElementById("convert-btn") as HTMLButtonElement | null;
  const errorBanner = document.getElementById("convert-error") as HTMLElement | null;
  const statusDot = document.getElementById("status-dot") as HTMLElement | null;
  const phaseEl = document.getElementById("convert-phase") as HTMLElement | null;
  const statusText = document.getElementById("convert-status-text") as HTMLElement | null;

  initAnnounce("convert-status-announce");

  const debouncedInput = debounce((value: string) => {
    handleInput(tsvToCsvStore, value);
  }, 150);

  let lastOut = "";

  // Phase labels for the large-file readout (banner text is the honest minimum).
  const phaseByKey: Record<string, string> = {};
  LARGE_FILE_PHASES.forEach((p) => {
    phaseByKey[p.key] = p.label;
  });

  tsvToCsvStore.subscribe((state) => {
    const inputFocused = tsvTextarea && document.activeElement === tsvTextarea;
    if (tsvTextarea && tsvTextarea.value !== state.tsvInput && !inputFocused) {
      tsvTextarea.value = state.tsvInput;
      tsvTextarea.dispatchEvent(new Event("editor-refresh"));
    }

    // Large-file mode output: show the capped preview in the editor.
    const large = state.largeFile;
    if (large) {
      const out = large.preview || "";
      if (out !== lastOut) {
        lastOut = out;
        if (outTextarea && outTextarea.value !== out) {
          outTextarea.value = out;
          outTextarea.dispatchEvent(new Event("editor-refresh"));
        }
      }
    }

    // Output only changes on an authoritative Convert.
    if (state.result && state.result.authoritative) {
      const out = state.result.ok ? state.result.output : "";
      if (out !== lastOut) {
        lastOut = out;
        if (outTextarea && outTextarea.value !== out) {
          outTextarea.value = out;
          outTextarea.dispatchEvent(new Event("editor-refresh"));
        }
      }
    }

    if (inputStatus) {
      if (state.inputStatus === "empty") {
        inputStatus.textContent = "Status: Empty";
        inputStatus.style.color = "";
      } else if (state.result && !state.result.ok) {
        inputStatus.textContent = "Status: Invalid";
        inputStatus.style.color = "var(--color-error)";
      } else if (state.result && state.result.ok) {
        inputStatus.textContent = "Status: Ready";
        inputStatus.style.color = "var(--color-success)";
      } else {
        inputStatus.textContent = "Status: Ready";
        inputStatus.style.color = "";
      }
    }
    if (inputCharCount)
      inputCharCount.textContent = state.tsvInput.length.toLocaleString() + " chars";

    if (outputStatus) {
      outputStatus.textContent = large
        ? "Output: Preview — " +
          large.rows +
          " rows × " +
          large.cols +
          " cols · Download for the full file"
        : state.outputStatus === "converted"
          ? "Output: CSV"
          : state.outputStatus === "invalid"
            ? "Output: Error"
            : "Output: Empty";
      outputStatus.style.color =
        large || state.outputStatus === "converted"
          ? "var(--color-success)"
          : state.outputStatus === "invalid"
            ? "var(--color-error)"
            : "";
    }
    if (outputCharCount) {
      const ok = state.result && state.result.authoritative && state.result.ok;
      outputCharCount.textContent = large
        ? large.preview.length.toLocaleString() + " chars preview"
        : lastOut.length.toLocaleString() +
          " chars" +
          (ok ? ` · ${state.result!.rowCount} rows × ${state.result!.colCount} cols` : "");
    }

    if (statusDot) {
      statusDot.classList.remove("idle", "active", "error");
      statusDot.classList.add(
        state.isConverting ? "active" : state.outputStatus === "invalid" ? "error" : "idle",
      );
    }
    if (phaseEl && statusText) {
      if (large && large.phase !== "done") {
        phaseEl.textContent = phaseByKey[large.phase] ?? large.phase + "…";
        phaseEl.style.color = "var(--color-accent)";
        statusText.textContent = "";
      } else if (large && large.phase === "done") {
        phaseEl.textContent = "";
        phaseEl.style.color = "var(--color-success)";
        statusText.textContent = "";
      } else {
        phaseEl.textContent = "";
        statusText.textContent = "Local sandbox active";
      }
    }
    if (convertBtn) {
      convertBtn.textContent = state.isConverting ? "Converting…" : "Convert";
      convertBtn.disabled = state.isConverting;
    }
    if (errorBanner) {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (state.error) (errorBanner as any).show?.(state.error);
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      else (errorBanner as any).hide?.();
    }
    if (state.error) announce("Error: " + state.error);
    if (state.result && state.result.authoritative && state.result.ok) announce("Converted to CSV");
    if (state.result && state.result.authoritative && !state.result.ok)
      announce("TSV is invalid for CSV conversion");
  });

  if (tsvTextarea) {
    tsvTextarea.addEventListener("input", () => debouncedInput(tsvTextarea.value));
  }
  if (convertBtn) convertBtn.addEventListener("click", () => convert(tsvToCsvStore));

  const inputActions = document.getElementById("input-actions");
  if (inputActions) {
    inputActions.addEventListener("tool-action", (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "sample") {
        loadSample(tsvToCsvStore);
        announce("Sample TSV loaded");
      }
      if (action === "clear") {
        clearAll(tsvToCsvStore);
        clearLargeFile(tsvToCsvStore);
        document.getElementById("tsv-input-dropzone")?.dispatchEvent(new CustomEvent("dropzone:clear", { bubbles: true }));
        (document.getElementById("tsv-input-file-input") as HTMLInputElement | null)!.value = "";
        announce("Input cleared");
      }
    });
  }

  const outputActions = document.getElementById("output-actions");
  if (outputActions) {
    outputActions.addEventListener("tool-action", async (e: Event) => {
      const action = (e as CustomEvent).detail?.action;
      if (action === "copy") {
        const large = tsvToCsvStore.get().largeFile;
        if (large) {
          announce("Copy copies only the preview — use Download for the full file");
          return;
        }
        const ok = lastOut ? await copyToClipboard(lastOut) : false;
        const btn = outputActions.querySelector("[data-action='copy']");
        if (ok && btn) {
          const orig = btn.textContent || "Copy";
          btn.textContent = "Copied!";
          announce("CSV copied");
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      }
      if (action === "download") {
        // Large-file mode: download the full Blob, not just the preview.
        const large = tsvToCsvStore.get().largeFile;
        if (large && large.blob) {
          const blobUrl = URL.createObjectURL(large.blob);
          const a = document.createElement("a");
          a.href = blobUrl;
          a.download = "converted.csv";
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
          announce("Download started (full file)");
          return;
        }
        if (lastOut) {
          downloadFile(lastOut, "tsv-to-csv-converted.csv", "text/csv;charset=utf-8;");
          announce("Download started");
        } else {
          announce("Nothing to download yet");
        }
      }
    });
  }

  const dropZone = document.getElementById("tsv-input-dropzone");
  if (dropZone) {
    dropZone.addEventListener("file-dropped", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.text) {
        clearLargeFile(tsvToCsvStore);
        handleInput(tsvToCsvStore, detail.text);
        convert(tsvToCsvStore);
        announce("File loaded: " + (detail.name || "file"));
      }
    });

    // Large-file mode: the worker owns the read + one-pass convert, and the
    // result is a Blob download with a capped in-editor preview.
    dropZone.addEventListener("file-large", (e: Event) => {
      const detail = (e as CustomEvent).detail;
      const file: File | undefined = detail?.file;
      if (!file) return;
      convertLargeFile(tsvToCsvStore, file, file.name, file.size);
    });
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === "SELECT") return;
      e.preventDefault();
      convert(tsvToCsvStore);
    }
  });
</script>
<style>
  .workspace-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: var(--spacing-md);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--spacing-sm);
  }
  .column-title {
    color: var(--color-mute);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .editor-info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-hairline);
    border-top: none;
    border-bottom-left-radius: var(--rounded-sm);
    border-bottom-right-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: 6px var(--spacing-sm);
    font-size: 11px;
    color: var(--color-mute);
    font-family: var(--font-sans);
  }
  .info-status {
    font-weight: 500;
  }
  .settings-card {
    padding: var(--spacing-lg);
  }
  .action-btn {
    width: 100%;
    margin-top: var(--spacing-sm);
  }
  .status-banner {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-mute);
    margin-top: auto;
    padding-top: var(--spacing-md);
  }
  .status-indicator .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background-color: var(--color-hairline-strong);
  }
  .status-indicator .dot.active {
    background-color: var(--color-accent);
  }
  .status-indicator .dot.error {
    background-color: var(--color-error);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }
  .section-title {
    color: var(--color-ink);
    margin: 0;
  }
  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft);
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .faq-summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    padding: var(--spacing-xs) 0;
    user-select: none;
  }
  .faq-summary:hover {
    color: var(--color-accent);
  }
  .faq-answer {
    margin-top: var(--spacing-sm);
    font-size: 13px;
    color: var(--color-body);
    line-height: 1.6;
  }
  .faq-answer code {
    font-family: var(--font-mono);
    font-size: 12px;
    background-color: var(--color-canvas-soft-2);
    padding: 1px 4px;
    border-radius: var(--rounded-xs);
  }
  @media (min-width: 960px) {
    .workspace-card :global(.editor-outer) {
      flex: none;
      height: 650px;
      min-height: 650px;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
  @media (max-width: 959px) {
    .workspace-card :global(.editor-outer) {
      height: 350px;
      flex: 0 0 350px;
      min-height: 0;
    }
    .workspace-card :global(.editor-wrapper) {
      height: 100%;
    }
  }
</style>
