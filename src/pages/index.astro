    }
    .hp-pop-go {
      color: var(--color-accent-active);
      transition: transform 0.15s ease;
    }
    .hp-pop-chip:hover .hp-pop-go {
      transform: translateX(3px);
    }

    /* ── COLLECTIONS ── */
