      margin: 0;
      line-height: 1.6;
    }
    .hp-pipe-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-xs);
    }
    .hp-pipe-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px var(--spacing-md);
      border: 1px dashed var(--color-hairline-strong);
      border-radius: var(--rounded-sm);
      background-color: var(--color-canvas);
      transition:
        border-color 0.15s ease,
