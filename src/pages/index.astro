    /* make the global star sit inline as a row sibling, not absolute over a card */
    .hp-tool :global(.fav-star) {
      position: static;
      width: 28px;
      height: 28px;
      flex: none;
    }

    /* ── COMPARISONS ── */
    .hp-compare {
      padding: var(--spacing-4xl) 0;
      background-color: var(--color-canvas-soft);
      border-top: 1px solid var(--color-hairline);
      border-bottom: 1px solid var(--color-hairline);
    }
    .hp-cmp-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--spacing-md);
