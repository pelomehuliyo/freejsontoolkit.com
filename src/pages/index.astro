    .hp-yourtools :global(.your-tools-head),
    .hp-col-rec :global(.jump-head) {
      display: none;
    }
    .hp-yourtools :global(.your-tools) {
      margin-bottom: 0;
    }
    /* recents chips: tidy the global markup into our column */
    .hp-col-rec :global(.jump-row) {
      gap: var(--spacing-xs);
    }

    /* ── POPULAR ── */
