      line-height: 1.65;
    }

    /* ── scroll reveal ── */
    .hp-reveal {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    .hp-reveal.is-in {
      opacity: 1;
      transform: none;
    }

    /* ── responsive ── */
    @media (max-width: 959px) {
      .hp-hero-grid {
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
      }
      .hp-cat-grid {
        grid-template-columns: 1fr;
      }
      .hp-trust-grid {
        grid-template-columns: 1fr;
        gap: var(--spacing-xl);
      }
      .hp-pipe-grid {
        grid-template-columns: 1fr;
      }
      .hp-personal-grid {
        flex-direction: column;
        gap: var(--spacing-xl);
      }
    }
