---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
---

<BaseLayout title="JSON Toolkit - Free Offline JSON Utilities" activePath="/">
  <!-- Hero Section -->
  <section class="hero-section">
    <Container size="default" class="hero-container">
      <div class="hero-content">
        <span class="caption-mono hero-eyebrow">FREE DEVELOPER UTILITIES</span>
        <h1 class="display-xl hero-title">JSON utilities. Processed locally.</h1>
        <p class="body-lg hero-description">
          A minimalist suite of offline-first utility tools to format, validate, and convert JSON data. No telemetry, no logs, processed entirely in your browser sandbox.
        </p>
        <div class="hero-actions">
          <Button variant="primary" size="lg" shape="square" href="#tools">
            Explore Utilities
          </Button>
          <Button variant="ghost" size="lg" href="/sandbox">
            View Design System
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- Tools Catalog Section -->
  <section id="tools" class="catalog-section">
    <Container size="default">
      <div class="section-header">
        <span class="caption-mono section-eyebrow">UTILITIES</span>
        <h2 class="display-lg section-title">Available Tools</h2>
        <p class="body-md section-description">
          Open any utility workspace below to begin processing payloads.
        </p>
      </div>

      <div class="catalog-grid">
        <!-- JSON to CSV (Active) -->
        <Card variant="default" hoverable={true} class="tool-card">
          <div class="tool-card-content">
            <div class="tool-icon">⇄</div>
            <h3 class="display-sm tool-title">JSON to CSV Converter</h3>
            <p class="body-sm tool-description">
              Flatten nested JSON arrays and download clean, tidy CSV spreadsheets offline. Custom delimiter options.
            </p>
          </div>
          <div class="tool-footer">
            <Button variant="primary" size="sm" shape="square" href="/tools/json-to-csv" class="launch-btn">
              Launch Converter →
            </Button>
          </div>
        </Card>

        <!-- CSV to JSON (Coming Soon) -->
        <Card variant="soft" class="tool-card tool-card-disabled">
          <div class="tool-card-content">
            <div class="tool-icon icon-disabled">↹</div>
            <div class="tool-header-row">
              <h3 class="display-sm tool-title">CSV to JSON</h3>
              <span class="coming-soon-badge">Coming Soon</span>
            </div>
            <p class="body-sm tool-description">
              Parse structured CSV tables and rows back into hierarchical nested JSON string formats.
            </p>
          </div>
        </Card>

        <!-- JSON Formatter & Validator (Coming Soon) -->
        <Card variant="soft" class="tool-card tool-card-disabled">
          <div class="tool-card-content">
            <div class="tool-icon icon-disabled">🛠️</div>
            <div class="tool-header-row">
              <h3 class="display-sm tool-title">JSON Formatter & Lint</h3>
              <span class="coming-soon-badge">Coming Soon</span>
            </div>
            <p class="body-sm tool-description">
              Lint, prettify, or minify JSON payloads with live structure checks, parsing error highlights, and line numbers.
            </p>
          </div>
        </Card>
      </div>
    </Container>
  </section>

  <!-- About / Privacy Section -->
  <section id="about" class="about-section">
    <Container size="narrow">
      <div class="about-content">
        <h2 class="display-sm about-title">Processed entirely on your device.</h2>
        <p class="body-md about-text">
          Many online tools send your JSON payloads to third-party servers to convert or validate them. If you work with customer information, API keys, or proprietary data records, this presents serious compliance risks.
        </p>
        <p class="body-md about-text">
          <strong>JSON Toolkit is different.</strong> Our utility converter scripts run 100% inside your local browser context. Your JSON data is never transmitted over the internet, keeping your credentials and developer workflows completely private and compliant.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding-top: var(--spacing-5xl);
    padding-bottom: var(--spacing-4xl);
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
  }

  .hero-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }

  .hero-title {
    margin-top: var(--spacing-xs);
    font-size: 56px;
    line-height: 56px;
    letter-spacing: -2.8px;
    color: var(--color-ink);
  }

  .hero-description {
    color: var(--color-body);
    max-width: 620px;
    margin: 0;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 600px) {
    .hero-section {
      padding-top: var(--spacing-3xl);
      padding-bottom: var(--spacing-3xl);
    }
    
    .hero-title {
      font-size: 38px;
      line-height: 42px;
      letter-spacing: -1.6px;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
      gap: var(--spacing-sm);
    }
    
    .hero-actions > :global(a),
    .hero-actions > :global(button) {
      width: 100%;
    }
  }

  /* Catalog Section */
  .catalog-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-hairline);
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }

  .section-title {
    color: var(--color-ink);
  }

  .section-description {
    color: var(--color-body);
    margin: 0;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    background-color: var(--color-canvas);
  }

  .tool-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .tool-icon {
    font-size: 32px;
    line-height: 1;
    margin-bottom: var(--spacing-xxs);
    color: var(--color-primary);
  }

  .icon-disabled {
    color: var(--color-mute);
    opacity: 0.5;
  }

  .tool-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .tool-title {
    color: var(--color-ink);
    margin: 0;
  }

  .coming-soon-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    background-color: var(--color-canvas-soft-2);
    color: var(--color-mute);
    padding: 2px var(--spacing-xs);
    border-radius: var(--rounded-sm);
    border: 1px solid var(--color-hairline);
  }

  .tool-description {
    color: var(--color-body);
    margin: 0;
    line-height: 1.5;
  }

  .tool-footer {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-hairline);
  }

  .launch-btn {
    width: 100%;
  }

  .tool-card-disabled {
    opacity: 0.75;
    background-color: var(--color-canvas-soft);
  }

  @media (max-width: 959px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }

  /* About / Privacy Section */
  .about-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas);
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .about-title {
    color: var(--color-ink);
    margin-bottom: var(--spacing-xs);
  }

  .about-text {
    color: var(--color-body);
    margin: 0;
    line-height: 1.6;
  }
</style>
