---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
---

<BaseLayout
  title="Free JSON Toolkit - Offline JSON Utilities"
  description="Fast, free JSON utilities that run entirely in your browser."
  activePath="/"
>
  <main>
    {/* Hero */}
    <section class="hero-section" aria-labelledby="hero-title">
      <Container size="default" class="hero-container">
        <div class="hero-content">
          <h1 id="hero-title" class="display-xl hero-title">
            Free JSON Toolkit
          </h1>

          <p class="body-lg hero-subtitle">
            Fast, free JSON utilities that run entirely in your browser.
          </p>

          <p class="body-lg hero-description">
            Convert, format, validate, and transform JSON without uploading your
            data. Everything is processed locally for speed, privacy, and
            reliability.
          </p>

          <div class="hero-actions" role="group" aria-label="Primary actions">
            <Button
              variant="primary"
              size="lg"
              shape="square"
              href="/tools/json-to-csv"
            >
              JSON → CSV Converter
            </Button>

            <Button
              variant="secondary"
              size="lg"
              shape="square"
              href="#featured-tools"
            >
              Browse Tools
            </Button>
          </div>
        </div>
      </Container>
    </section>

    {/* Trust */}
    <section id="trust" class="trust-section" aria-labelledby="trust-title">
      <Container size="default">
        <div class="section-header trust-header">
          <span class="caption-mono section-eyebrow">TRUST</span>
          <h2 id="trust-title" class="display-lg section-title">
            Developer-first privacy and reliability
          </h2>
        </div>

        <div class="trust-grid" role="list" aria-label="Trust information">
          <Card variant="default" class="trust-card" hoverable={false}>
            <div class="trust-card-content" role="listitem">
              <h3 class="display-sm tool-title">100% Local Processing</h3>
              <p class="body-sm tool-description">
                Your data never leaves your browser.
              </p>
            </div>
          </Card>

          <Card variant="default" class="trust-card" hoverable={false}>
            <div class="trust-card-content" role="listitem">
              <h3 class="display-sm tool-title">Fast</h3>
              <p class="body-sm tool-description">
                No uploads. Instant browser-based processing.
              </p>
            </div>
          </Card>

          <Card variant="default" class="trust-card" hoverable={false}>
            <div class="trust-card-content" role="listitem">
              <h3 class="display-sm tool-title">Free Forever</h3>
              <p class="body-sm tool-description">
                No accounts, subscriptions, or hidden limits.
              </p>
            </div>
          </Card>
        </div>
      </Container>
    </section>

    {/* Featured Tools */}
    <section
      id="featured-tools"
      class="catalog-section"
      aria-labelledby="featured-tools-title"
    >
      <Container size="default">
        <div class="section-header">
          <span class="caption-mono section-eyebrow">FEATURED TOOLS</span>
          <h2 id="featured-tools-title" class="display-lg section-title">
            Convert JSON with confidence
          </h2>
        </div>

        <div class="catalog-grid" aria-label="Available and upcoming tools">
          <Card
            variant="default"
            hoverable={true}
            class="tool-card tool-card-available"
          >
            <div class="tool-card-content">
              <h3 class="display-sm tool-title">JSON → CSV Converter</h3>
              <div class="tool-status" aria-label="Status: Available">
                <span class="status-label status-available">Available</span>
              </div>
              <p class="body-sm tool-description">
                Flatten nested JSON objects and export clean CSV spreadsheets.
              </p>
            </div>

            <div class="tool-footer">
              <Button
                variant="primary"
                size="sm"
                shape="square"
                href="/tools/json-to-csv"
                class="launch-btn"
              >
                Open Tool
              </Button>
            </div>
          </Card>

          <Card
            variant="soft"
            class="tool-card tool-card-disabled"
            aria-disabled="true"
          >
            <div class="tool-card-content">
              <h3 class="display-sm tool-title">CSV → JSON</h3>
              <div class="tool-status" aria-label="Status: Coming Soon">
                <span class="status-label status-coming">Coming Soon</span>
              </div>
              <p class="body-sm tool-description">
                Convert CSV files into structured JSON.
              </p>
            </div>
          </Card>

          <Card
            variant="soft"
            class="tool-card tool-card-disabled"
            aria-disabled="true"
          >
            <div class="tool-card-content">
              <h3 class="display-sm tool-title">JSON Formatter</h3>
              <div class="tool-status" aria-label="Status: Coming Soon">
                <span class="status-label status-coming">Coming Soon</span>
              </div>
              <p class="body-sm tool-description">
                Beautify and minify JSON with customizable formatting.
              </p>
            </div>
          </Card>

          <Card
            variant="soft"
            class="tool-card tool-card-disabled"
            aria-disabled="true"
          >
            <div class="tool-card-content">
              <h3 class="display-sm tool-title">JSON Validator</h3>
              <div class="tool-status" aria-label="Status: Coming Soon">
                <span class="status-label status-coming">Coming Soon</span>
              </div>
              <p class="body-sm tool-description">
                Validate JSON syntax and identify errors instantly.
              </p>
            </div>
          </Card>
        </div>

        {/* Small internal anchor target for hero CTA scroll */}
        <span id="tools" class="sr-only" aria-hidden="true"></span>
      </Container>
    </section>

    {/* FAQ */}
    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <Container size="narrow">
        <div class="faq-header">
          <span class="caption-mono section-eyebrow">FAQ</span>
          <h2 id="faq-title" class="display-lg section-title">Quick answers</h2>
        </div>

        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-summary">Is my data uploaded?</summary>
            <p class="body-md faq-answer">
              No. Everything is processed locally in your browser.
            </p>
          </details>

          <details class="faq-item">
            <summary class="faq-summary">Is it free?</summary>
            <p class="body-md faq-answer">Yes. All tools are free to use.</p>
          </details>

          <details class="faq-item">
            <summary class="faq-summary">Does it work offline?</summary>
            <p class="body-md faq-answer">
              Most tools continue to work after the page has loaded because
              processing happens locally.
            </p>
          </details>

          <details class="faq-item">
            <summary class="faq-summary">Which browsers are supported?</summary>
            <p class="body-md faq-answer">
              Latest versions of Chrome, Edge, Firefox, and Safari.
            </p>
          </details>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Hero */
  .hero-container {
    padding-top: 0;
  }

  .hero-section {
    padding-top: var(--spacing-5xl);
    padding-bottom: var(--spacing-4xl);
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
  }

  .hero-title {
    margin-top: 0;
  }

  .hero-subtitle,
  .hero-description {
    color: var(--color-body);
    max-width: 720px;
    margin: 0;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
    justify-content: center;
  }

  @media (max-width: 600px) {
    .hero-section {
      padding-top: var(--spacing-3xl);
      padding-bottom: var(--spacing-3xl);
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      gap: var(--spacing-sm);
    }

    .hero-actions > :global(a),
    .hero-actions > :global(button) {
      width: 100%;
    }
  }

  /* Section headers */
  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }

  .section-title {
    color: var(--color-ink);
  }

  /* Featured Tools */
  .catalog-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-hairline);
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl);
  }

  @media (min-width: 1020px) {
    .catalog-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 959px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    background-color: var(--color-canvas);
  }

  .tool-card-available {
    border-color: var(--color-hairline-strong);
  }

  .tool-card-disabled {
    opacity: 0.85;
    background-color: var(--color-canvas-soft);
  }

  .tool-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .tool-title {
    color: var(--color-ink);
    margin: 0;
  }

  .tool-description {
    color: var(--color-body);
    margin: 0;
    line-height: 1.5;
  }

  .tool-status {
    display: flex;
    align-items: center;
  }

  .status-label {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px var(--spacing-xs);
    border-radius: var(--rounded-sm);
    border: 1px solid var(--color-hairline);
  }

  .status-available {
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
  }

  .status-coming {
    color: var(--color-mute);
    background-color: var(--color-canvas-soft);
  }

  .tool-footer {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-hairline);
  }

  .launch-btn {
    width: 100%;
  }

  /* Trust */
  .trust-section {
    padding: var(--spacing-5xl) 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }

  @media (max-width: 959px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }

  /* FAQ */
  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
  }

  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--spacing-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-sm);
  }

  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas);
    padding: var(--spacing-sm) var(--spacing-md);
  }

  .faq-summary {
    cursor: pointer;
    font-weight: 500;
  }

  .faq-answer {
    margin-top: var(--spacing-xs);
    color: var(--color-body);
  }
</style>
