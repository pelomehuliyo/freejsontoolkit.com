    /* ── scroll reveal ── */
    .lf-reveal {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    .lf-reveal.is-in {
      opacity: 1;
      transform: none;
    }

    /* ── responsive ── */
    @media (max-width: 959px) {
      .lf-hero-grid {
