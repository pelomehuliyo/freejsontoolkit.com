---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Card from "../components/Card.astro";
---

<BaseLayout
  title="Disclaimer - Free JSON Toolkit"
  description="Read our disclaimer. Free JSON Toolkit provides browser-based utilities as-is. We recommend verifying output data before production use."
  activePath="/disclaimer"
>
  <main>
    {/* Page Header */}
    <section class="page-header" aria-labelledby="disclaimer-title">
      <Container size="narrow" class="header-container">
        <span class="caption-mono section-eyebrow">LEGAL POLICY</span>
        <h1 id="disclaimer-title" class="display-xl page-title">Disclaimer</h1>
        <p class="caption-mono last-updated">Last updated: July 2026</p>
      </Container>
    </section>

    {/* Content Sections */}
    <section class="content-section" aria-label="Disclaimer Details">
      <Container size="narrow">
        <div class="policy-wrapper">
          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">1. Provided "As-Is"</h2>
            <p class="body-md policy-text">
              All tools, converters, formatters, and validators hosted on Free JSON Toolkit are
              provided on an "as-is" and "as-available" basis. We do not make any guarantees about
              the accuracy, reliability, or correctness of the outputs generated by these tools.
            </p>
          </Card>

          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">2. Verify Before Production</h2>
            <p class="body-md policy-text">
              We strongly recommend manually inspecting and verifying any converted data before
              deploying it to production databases, configurations, or live applications. Parsing
              complex or nested data structures can lead to unexpected mappings (e.g., flattened
              object hierarchies or array indexing changes) depending on the specific formatting
              chosen.
            </p>
          </Card>

          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">3. Malformed and Custom Input</h2>
            <p class="body-md policy-text">
              Our tools expect well-formed inputs complying with standard JSON specifications. If
              you submit malformed JSON, truncated structures, or extremely custom data formats, the
              tools may crash, skip entries, or return partial data. We do not guarantee error-free
              processing of invalid files.
            </p>
          </Card>

          <Card variant="flat" class="policy-card">
            <h2 class="display-md policy-heading">4. Feedback and Bugs</h2>
            <p class="body-md policy-text">
              If you encounter bugs, parser errors, or strange conversion behavior, please report
              them to our public GitHub issue tracker. We are constantly working to improve the
              parsers and add support for complex structures, and your real-world feedback is highly
              appreciated.
            </p>
          </Card>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--spacing-5xl);
    padding-bottom: var(--spacing-3xl);
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    text-align: center;
  }

  .header-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .section-eyebrow {
    color: var(--color-mute);
    letter-spacing: 0.1em;
  }

  .page-title {
    margin-top: 0;
    margin-bottom: var(--spacing-xxs);
    color: var(--color-ink);
  }

  .last-updated {
    color: var(--color-mute);
    margin: 0;
  }

  .content-section {
    padding: var(--spacing-4xl) 0;
    background-color: var(--color-canvas-soft);
  }

  .policy-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .policy-card {
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-xl) !important;
  }

  .policy-heading {
    color: var(--color-ink);
    margin: 0;
  }

  .policy-text {
    color: var(--color-body);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 600px) {
    .page-header {
      padding-top: var(--spacing-3xl);
      padding-bottom: var(--spacing-2xl);
    }

    .content-section {
      padding: var(--spacing-2xl) 0;
    }

    .policy-card {
      padding: var(--spacing-lg) !important;
    }
  }
</style>
