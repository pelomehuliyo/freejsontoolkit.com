---
import DocLayout from "../layouts/DocLayout.astro";

const toc = [
  { id: "as-is", label: "Provided as-is" },
  { id: "accuracy", label: "Accuracy of output" },
  { id: "no-advice", label: "Not professional advice" },
  { id: "external", label: "External links" },
  { id: "note", label: "Plain-language note" },
];
---

<DocLayout
  title="Disclaimer"
  description="Free JSON Toolkit is provided as-is, without warranty. Output should be verified before use, and the tools do not constitute professional advice."
  eyebrow="Legal"
  lede="A short, honest disclaimer for a free local tool: we built it carefully, but you should still check its work."
  toc={toc}
  updated="2026-07-30"
  tag="Plain-language"
  notice="Plain-language summary — not a substitute for formal legal advice."
>
  <section class="doc-section" id="as-is">
    <h2>Provided as-is</h2>
    <p>
      All information and tools on this site are provided in good faith and on an "as is" basis. We
      make no representations or warranties of any kind, express or implied, about the completeness,
      accuracy, reliability, suitability, or availability of the site or its tools.
    </p>
  </section>

  <section class="doc-section" id="accuracy">
    <h2>Accuracy of output</h2>
    <p>
      The tools aim to be correct, and the parsers follow established specifications where they
      exist. Even so, you should <strong>verify any output</strong> before relying on it for something
      that matters. We are not responsible for decisions made on the basis of unverified results.
    </p>
  </section>

  <section class="doc-section" id="no-advice">
    <h2>Not professional advice</h2>
    <p>
      Nothing on this site constitutes legal, financial, security, or other professional advice. For
      matters that carry real consequences, consult a qualified professional in the relevant field.
    </p>
  </section>

  <section class="doc-section" id="external">
    <h2>External links</h2>
    <p>
      This site may link to external resources, including the project's source repository. We have
      no control over the content or availability of those sites and are not responsible for them.
    </p>
  </section>

  <section class="doc-section" id="note">
    <h2>Plain-language note</h2>
    <p>
      This disclaimer is written to be understood, not to intimidate. It reflects the reasonable
      limits of liability for a free, local-first tool. For a binding disclaimer in a specific
      jurisdiction, seek qualified legal counsel.
    </p>
  </section>
</DocLayout>
