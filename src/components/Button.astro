---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button">, HTMLAttributes<"a"> {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  shape?: "pill" | "square";
  href?: string;
}

const {
  variant = "primary",
  size = "md",
  shape = "pill",
  href,
  class: className = "",
  ...rest
} = Astro.props;

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class:list={["btn", `btn-${variant}`, `btn-${size}`, `btn-${shape}`, className]}
  {...rest as any}
>
  <slot />
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease;
    border: 1px solid transparent;
    user-select: none;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Shape: Pill */
  .btn-pill {
    border-radius: var(--rounded-pill);
  }

  /* Shape: Square */
  .btn-square {
    border-radius: var(--rounded-sm);
  }

  /* Variant: Primary
     Accessible fill ramp — white text passes WCAG AA (>=4.5:1) in every state:
       base   --color-accent-strong #198069  -> 4.9:1
       hover  #16725e                        -> 5.8:1
       active #12594b                        -> 8.2:1
     (The old base, --color-accent #21a78a, was only 3.0:1 with white text.) */
  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-ink);
    border-color: var(--color-accent);
  }
  .btn-primary:hover:not(:disabled) {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
  .btn-primary:active:not(:disabled) {
    background-color: var(--color-accent-active);
    border-color: var(--color-accent-active);
  }
  .btn-primary:disabled {
    background-color: var(--color-hairline-strong);
    border-color: var(--color-hairline-strong);
    cursor: not-allowed;
    opacity: 0.6;
  }

  /* Variant: Secondary */
  .btn-secondary {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-color: var(--color-hairline);
    box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.05);
  }
  .btn-secondary:hover:not(:disabled) {
    background-color: var(--color-canvas-soft);
    border-color: var(--color-hairline-strong);
  }
  .btn-secondary:active:not(:disabled) {
    background-color: var(--color-canvas-soft-2);
  }
  .btn-secondary:disabled {
    background-color: var(--color-canvas-soft);
    color: var(--color-mute);
    border-color: var(--color-hairline);
    cursor: not-allowed;
    box-shadow: none;
  }

  /* Variant: Ghost */
  .btn-ghost {
    background-color: transparent;
    color: var(--color-body);
  }
  .btn-ghost:hover:not(:disabled) {
    background-color: var(--color-canvas-soft-2);
    color: var(--color-ink);
  }
  .btn-ghost:active:not(:disabled) {
    background-color: var(--color-hairline);
  }
  .btn-ghost:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }

  /* Size: sm (Nav/Tight form size) */
  .btn-sm {
    height: 32px;
    padding: 0 var(--spacing-sm);
    font-size: 14px;
    line-height: 20px;
  }

  /* Size: md (Standard size) */
  .btn-md {
    height: 40px;
    padding: 0 var(--spacing-md);
    font-size: 14px;
    line-height: 20px;
  }

  /* Size: lg (Marketing CTA size) */
  .btn-lg {
    height: 48px;
    padding: 0 var(--spacing-lg);
    font-size: 16px;
    line-height: 24px;
  }
</style>
