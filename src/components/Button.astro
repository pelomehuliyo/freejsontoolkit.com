---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button">, HTMLAttributes<"a"> {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  shape?: "pill" | "square";
  href?: string;
}

const {
  variant = "primary",
  size = "md",
  shape = "pill",
  href,
  class: className = "",
  ...rest
} = Astro.props;

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class:list={["btn", `btn-${variant}`, `btn-${size}`, `btn-${shape}`, className]}
  {...rest as any}
>
  <slot />
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    /* transform + box-shadow added so the hover-lift / glow animate smoothly */
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
    border: 1px solid transparent;
    user-select: none;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Shape: Pill */
  .btn-pill {
    border-radius: var(--rounded-pill);
  }

  /* Shape: Square */
  .btn-square {
    border-radius: var(--rounded-sm);
  }

  /* Variant: Primary — brand teal fill + WHITE text (matches the logo's
     white-on-teal monogram). This is a deliberate brand-over-badge choice:
     white on #21a78a is ~3.0:1, below WCAG AA's 4.5:1 for text, so the
     contrast audit will keep listing this one button — that is the accepted
     trade for keeping the colour that ties the site to the logo.
     NOTE: `color` carries !important on purpose. It is a shield, not a hack:
     a page-level rule (e.g. a hero wrapper or a global link colour) was
     previously out-ranking this component and silently turning the label
     black. !important guarantees the component owns its own text colour,
     in every state, no matter what the page throws at it. */
  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-on-primary) !important;
    border-color: var(--color-accent);
    box-shadow: 0 1px 2px rgba(17, 17, 17, 0.06);
  }
  .btn-primary:hover:not(:disabled) {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-on-primary) !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(33, 167, 138, 0.32);
  }
  .btn-primary:active:not(:disabled) {
    background-color: var(--color-accent-active);
    border-color: var(--color-accent-active);
    color: var(--color-on-primary) !important;
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(33, 167, 138, 0.28);
  }
  .btn-primary:disabled {
    background-color: var(--color-hairline-strong);
    border-color: var(--color-hairline-strong);
    cursor: not-allowed;
    opacity: 0.6;
    transform: none;
    box-shadow: none;
  }

  /* Variant: Secondary */
  .btn-secondary {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-color: var(--color-hairline);
    box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.05);
  }
  .btn-secondary:hover:not(:disabled) {
    background-color: var(--color-canvas-soft);
    border-color: var(--color-hairline-strong);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(17, 17, 17, 0.08);
  }
  .btn-secondary:active:not(:disabled) {
    background-color: var(--color-canvas-soft-2);
    transform: translateY(0);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .btn-secondary:disabled {
    background-color: var(--color-canvas-soft);
    color: var(--color-mute);
    border-color: var(--color-hairline);
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  /* Variant: Ghost — intentionally quiet, no lift */
  .btn-ghost {
    background-color: transparent;
    color: var(--color-body);
  }
  .btn-ghost:hover:not(:disabled) {
    background-color: var(--color-canvas-soft-2);
    color: var(--color-ink);
  }
  .btn-ghost:active:not(:disabled) {
    background-color: var(--color-hairline);
  }
  .btn-ghost:disabled {
    color: var(--color-mute);
    cursor: not-allowed;
  }

  /* Size: sm (Nav/Tight form size) */
  .btn-sm {
    height: 32px;
    padding: 0 var(--spacing-sm);
    font-size: 14px;
    line-height: 20px;
  }

  /* Size: md (Standard size) */
  .btn-md {
    height: 40px;
    padding: 0 var(--spacing-md);
    font-size: 14px;
    line-height: 20px;
  }

  /* Size: lg (Marketing CTA size) */
  .btn-lg {
    height: 48px;
    padding: 0 var(--spacing-lg);
    font-size: 16px;
    line-height: 24px;
  }
</style>
