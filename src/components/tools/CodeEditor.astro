---
/**
 * CodeEditor — Lightweight textarea with line-number gutter.
 *
 * Design goals:
 *   - Pure textarea (no Monaco, no CodeMirror, no syntax highlighting)
 *   - Synchronised scrolling between gutter and textarea
 *   - Readonly / editable mode
 *   - Simple line rendering for all file sizes (single text node — fast)
 *   - Mobile-friendly
 *
 * Props:
 *   id          — Unique element ID
 *   value       — Initial text content
 *   placeholder — Placeholder text
 *   readonly    — Whether the textarea is readonly (default: false)
 *   label       — Accessible label for screen readers
 *
 * Events (on textarea element):
 *   'editor-refresh' — Dispatch to force gutter re-render after
 *                      programmatic value changes.
 *
 * Slots:
 *   (default) — Content rendered below the editor (e.g. status bar)
 *
 * NOTE on the gutter:
 *   The numbers are rendered as ONE text node (with real line breaks)
 *   inside a single static element (.gutter-content). We do this on
 *   purpose: Astro's scoped <style> only reaches elements that exist in
 *   the template at build time, NOT elements a script creates later.
 *   The old approach (one <span> per line, created via innerHTML) meant
 *   the "stack each number vertically" rule never applied to those spans,
 *   so the numbers collapsed onto one horizontal row ("123456…") and the
 *   scroll sync drifted on large files. A single static element + real
 *   line breaks (white-space: pre) avoids that entirely and is also much
 *   faster for big files.
 */

interface Props {
  id: string;
  value?: string;
  placeholder?: string;
  readonly?: boolean;
  label: string;
}

const { id, value = "", placeholder = "", readonly = false, label } = Astro.props;
const gutterId = `${id}-gutter`;
const gutterContentId = `${id}-gutter-content`;
const textareaId = `${id}-textarea`;
---

<div class="editor-outer" data-editor-id={id}>
  <div class="editor-wrapper">
    <div class="editor-gutter" id={gutterId} aria-hidden="true" role="presentation">
      <div class="gutter-content" id={gutterContentId}>1</div>
    </div>
    <textarea
      id={textareaId}
      class="editor-textarea"
      value={value}
      placeholder={placeholder}
      readonly={readonly}
      spellcheck="false"
      aria-label={label}
      aria-multiline="true"></textarea>
  </div>
  <slot />
</div>

<script>
  (function () {
    var roots = document.querySelectorAll("[data-editor-id]");
    for (var ri = 0; ri < roots.length; ri++) {
      (function () {
        var container = roots[ri];
        var editorId = container.getAttribute("data-editor-id");
        if (!editorId) return;

        var textarea = document.getElementById(editorId + "-textarea");
        var gutter = document.getElementById(editorId + "-gutter");
        var gutterContent = document.getElementById(editorId + "-gutter-content");
        if (!textarea || !gutter || !gutterContent) return;

        // Guard: already initialized
        if (textarea.__ceInitialized) return;
        textarea.__ceInitialized = true;

        // Track current line count to avoid unnecessary work
        var currentLineCount = 1;

        /**
         * Re-render the gutter when the line count changes.
         * We build a single string "1\n2\n3\n…\nN" and drop it in as one
         * text node. The CSS `white-space: pre` on .gutter-content turns
         * each "\n" into a real line break, so the numbers stack vertically
         * and stay perfectly aligned with the textarea's lines.
         */
        function renderGutterLines() {
          var lineCount = textarea.value.split("\n").length;
          if (lineCount < 1) lineCount = 1;

          // Skip work if nothing changed
          if (lineCount === currentLineCount) return;
          currentLineCount = lineCount;

          var parts = new Array(lineCount);
          for (var i = 0; i < lineCount; i++) {
            parts[i] = String(i + 1);
          }
          // textContent (not innerHTML) — safe, fast, no per-line elements
          gutterContent.textContent = parts.join("\n");
        }

        /**
         * Sync gutter scroll position with textarea scroll.
         * (overflow-y is hidden on the gutter, but programmatic scrollTop
         *  still works — so the numbers follow the code as you scroll.)
         */
        function syncGutterScroll() {
          gutter.scrollTop = textarea.scrollTop;
        }

        // Scroll: keep the numbers lined up with the visible code
        textarea.addEventListener("scroll", syncGutterScroll);

        // Typing: re-render numbers, then re-sync scroll
        textarea.addEventListener("input", function () {
          renderGutterLines();
          syncGutterScroll();
        });

        // Paste: re-render after the browser has inserted the text
        textarea.addEventListener("paste", function () {
          requestAnimationFrame(function () {
            renderGutterLines();
            syncGutterScroll();
          });
        });

        // Custom event: re-render after the page sets the value in code
        textarea.addEventListener("editor-refresh", function () {
          currentLineCount = -1; // force a fresh render
          renderGutterLines();
          syncGutterScroll();
        });

        // First paint
        renderGutterLines();
        syncGutterScroll();
      })();
    }
  })();
</script>

<style>
  .editor-outer {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .editor-wrapper {
    position: relative;
    display: flex;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft-2);
    min-height: 0;
    flex: 1;
    overflow: hidden;
  }

  .editor-gutter {
    /* top + bottom padding now MATCH the textarea's vertical padding so the
       numbers line up with the code from the first line to the very last,
       and the scroll ranges are identical (no drift at the bottom). */
    padding: var(--spacing-md) var(--spacing-sm) var(--spacing-md) 0;
    text-align: right;
    color: var(--color-mute);
    background-color: var(--color-canvas-soft);
    border-right: 1px solid var(--color-hairline);
    user-select: none;
    width: 48px;
    min-width: 48px;
    overflow-y: hidden;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* The numbers live here as plain text with real line breaks.
     `white-space: pre` is what makes them stack vertically — one number
     per line — instead of running sideways. font-size / line-height /
     text-align are inherited from the wrappers above, so they always
     match the textarea exactly. */
  .gutter-content {
    white-space: pre;
    font-variant-numeric: tabular-nums;
  }

  .editor-textarea {
    width: 100%;
    height: 100%;
    flex: 1;
    border: none;
    background: transparent;
    color: var(--color-ink);
    padding: var(--spacing-md);
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    resize: none;
    outline: none;
    white-space: pre;
    overflow-x: auto;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .editor-textarea:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
    border-radius: var(--rounded-xs);
  }
</style>
