---
/**
 * CodeEditor — Lightweight textarea with line-number gutter.
 *
 * Design goals:
 *   - Pure textarea (no Monaco, no CodeMirror, no syntax highlighting)
 *   - Synchronised scrolling between gutter and textarea
 *   - Readonly / editable mode
 *   - Simple line rendering for all file sizes (single text node — fast)
 *   - Mobile-friendly
 *   - bite 5: a living empty state (overlay) that needs NO per-page config —
 *     it derives its voice from `readonly` and reuses `placeholder` as a faint
 *     example watermark, so every tool inherits it for free.
 *
 * Props:
 *   id          — Unique element ID
 *   value       — Initial text content
 *   placeholder — Placeholder text (also feeds the empty-state watermark)
 *   readonly    — Whether the textarea is readonly (default: false)
 *   label       — Accessible label for screen readers
 *
 * Events (on textarea element):
 *   'editor-refresh' — Dispatch to force gutter + empty-state re-sync after
 *                      programmatic value changes.
 *
 * Slots:
 *   (default) — Content rendered below the editor (e.g. status bar)
 */

interface Props {
  id: string;
  value?: string;
  placeholder?: string;
  readonly?: boolean;
  label: string;
}

const { id, value = "", placeholder = "", readonly = false, label } = Astro.props;
const gutterId = `${id}-gutter`;
const gutterContentId = `${id}-gutter-content`;
const textareaId = `${id}-textarea`;

// bite 5 — the rich empty state reuses the existing `placeholder` prop as a
// faint "watermark" example, so each tool's example flows in for free with no
// per-page changes. For input editors we drop the leading instruction line
// (the overlay's own sentence supersedes it) and keep just the example code.
const phLines = placeholder.split("\n");
const ghostText = !readonly && phLines.length > 1 ? phLines.slice(1).join("\n") : placeholder;
const emptyValue = readonly
  ? "Run the tool — your result appears right here, processed fully offline."
  : "Paste your data, drop a file above, or load the sample — it never leaves this tab.";
---

<div class="editor-outer" data-editor-id={id}>
  <div class="editor-wrapper">
    <div class="editor-gutter" id={gutterId} aria-hidden="true" role="presentation">
      <div class="gutter-content" id={gutterContentId}>1</div>
    </div>
    <textarea
      id={textareaId}
      class="editor-textarea"
      value={value}
      placeholder={placeholder}
      readonly={readonly}
      spellcheck="false"
      aria-label={label}
      aria-multiline="true"></textarea>

    <!-- bite 5 — living empty state. Decorative + non-interactive + aria-hidden:
         the textarea's label/placeholder own accessibility and no-JS, this owns
         the "feel". pointer-events:none means it never blocks typing or clicks;
         visibility is driven by the .is-empty class the script toggles. -->
    <div class="editor-empty" aria-hidden="true">
      {
        readonly ? (
          <p class="ee-prompt">
            <span class="ee-dot idle" aria-hidden="true" />
            <span>no output yet</span>
          </p>
        ) : (
          <p class="ee-prompt">
            <span class="ee-dollar" aria-hidden="true">
              $
            </span>
            <span>awaiting input</span>
            <span class="ee-caret" aria-hidden="true">
              ▍
            </span>
          </p>
        )
      }
      <p class="ee-value">{emptyValue}</p>
      <p class="ee-trust">
        <span class="ee-dot" aria-hidden="true"></span>
        local sandbox · 0 bytes uploaded
      </p>
      {ghostText ? <pre class="ee-ghost">{ghostText}</pre> : null}
    </div>
  </div>
  <slot />
</div>

<script>
  (function () {
    const roots = document.querySelectorAll("[data-editor-id]");
    for (let ri = 0; ri < roots.length; ri++) {
      (function () {
        const container = roots[ri];
        const editorId = container.getAttribute("data-editor-id");
        if (!editorId) return;

        const textarea = document.getElementById(editorId + "-textarea");
        const gutter = document.getElementById(editorId + "-gutter");
        const gutterContent = document.getElementById(editorId + "-gutter-content");
        const wrapper = container.querySelector(".editor-wrapper");
        if (!textarea || !gutter || !gutterContent) return;

        // Guard: already initialized
        if (textarea.__ceInitialized) return;
        textarea.__ceInitialized = true;

        // Under JS the rich overlay owns the empty visual, so retire the native
        // placeholder to avoid two texts stacking. (No-JS still gets it from the
        // server-rendered attribute, since this line never runs there.)
        textarea.setAttribute("placeholder", "");

        // Track current line count to avoid unnecessary DOM rebuilds
        let currentLineCount = 1;

        /**
         * Re-render gutter spans when line count changes.
         * Simple rendering — no virtualization for v1.0 stability.
         */
        function renderGutterLines() {
          function countLines(str) {
            let n = 1;
            for (let i = 0; i < str.length; i++) {
              if (str.charCodeAt(i) === 10) n++;
            }
            return n;
          }
          let lineCount = countLines(textarea.value);
          if (lineCount < 1) lineCount = 1;

          // Skip DOM rebuild if line count hasn't changed
          if (lineCount === currentLineCount) return;
          currentLineCount = lineCount;

          const parts = new Array(lineCount);
          for (let i = 0; i < lineCount; i++) {
            parts[i] = String(i + 1);
          }
          gutter.style.width = gutter.style.minWidth = String(lineCount).length + 2 + "ch";
          // textContent (not innerHTML) — safe, fast, no per-line elements
          gutterContent.textContent = parts.join("\n");
        }

        /**
         * Sync gutter scroll position with textarea scroll.
         */
        function syncGutterScroll() {
          gutter.scrollTop = textarea.scrollTop;
        }

        /**
         * bite 5 — show the living empty state only while the box is empty.
         * Runs on every path that can change the value (typing, paste, and the
         * programmatic editor-refresh the pages dispatch after setting value),
         * so the overlay can never linger over real content or stay hidden over
         * an emptied box.
         */
        function syncEmpty() {
          if (!wrapper) return;
          wrapper.classList.toggle("is-empty", textarea.value.length === 0);
        }

        // Scroll: sync gutter position to match textarea
        textarea.addEventListener("scroll", syncGutterScroll);

        // Input (typing): re-render line numbers, sync scroll, refresh empty state
        textarea.addEventListener("input", function () {
          renderGutterLines();
          syncGutterScroll();
          syncEmpty();
        });

        // Paste: ensure gutter + empty state update after paste (RAF for DOM settle)
        textarea.addEventListener("paste", function () {
          requestAnimationFrame(function () {
            renderGutterLines();
            syncGutterScroll();
            syncEmpty();
          });
        });

        // Custom event: re-render after the page sets the value in code
        textarea.addEventListener("editor-refresh", function () {
          currentLineCount = -1; // force re-render
          renderGutterLines();
          syncGutterScroll();
          syncEmpty();
        });

        // Initial render
        renderGutterLines();
        syncGutterScroll();
        syncEmpty();
      })();
    }
  })();
</script>

<style>
  .editor-outer {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .editor-wrapper {
    position: relative;
    display: flex;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    background-color: var(--color-canvas-soft-2);
    min-height: 0;
    flex: 1;
    overflow: hidden;
  }

  .editor-gutter {
    /* top + bottom padding match the textarea's vertical padding so the numbers
       line up with the code from the first line to the very last, and the scroll
       ranges are identical (no drift at the bottom). */
    padding: var(--spacing-md) var(--spacing-sm) var(--spacing-md) 0;
    text-align: right;
    color: var(--color-mute);
    background-color: var(--color-canvas-soft);
    border-right: 1px solid var(--color-hairline);
    user-select: none;
    width: 48px;
    min-width: 48px;
    overflow-y: hidden;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* The numbers live here as plain text with real line breaks.
     `white-space: pre` is what makes them stack vertically — one number per
     line — instead of running sideways. font-size / line-height / text-align
     are inherited from the wrappers above, so they always match the textarea. */
  .gutter-content {
    white-space: pre;
    font-variant-numeric: tabular-nums;
  }

  .editor-textarea {
    width: 100%;
    height: 100%;
    flex: 1;
    border: none;
    background: transparent;
    color: var(--color-ink);
    padding: var(--spacing-md);
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    resize: none;
    outline: none;
    white-space: pre;
    overflow-x: auto;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .editor-textarea:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
    border-radius: var(--rounded-xs);
  }

  /* ── bite 5: the living empty state ──────────────────────────────────────
     Sits over the textarea's text column (left = gutter width, padding = the
     textarea's padding) so its first line aligns with gutter line "1". It is
     purely decorative: pointer-events:none (never blocks typing/clicks),
     aria-hidden (the textarea label owns a11y), and visibility-gated by the
     .is-empty class so it fades in only while the box is empty. */
  .editor-empty {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 48px; /* must match .editor-gutter width */
    right: 0;
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: 6px;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.18s ease,
      visibility 0.18s ease;
  }
  .editor-wrapper.is-empty .editor-empty {
    opacity: 1;
    visibility: visible;
  }

  .ee-prompt {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5; /* 19.5px → aligns with gutter line 1 */
    color: var(--color-mute);
  }
  .ee-dollar {
    color: var(--color-accent);
    font-weight: 600;
  }
  .ee-caret {
    color: var(--color-accent);
    animation: ee-blink 1.1s step-end infinite;
  }
  @keyframes ee-blink {
    50% {
      opacity: 0;
    }
  }

  .ee-value {
    margin: 2px 0 0;
    max-width: 46ch;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-body);
  }

  .ee-trust {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-mute);
  }
  .ee-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
    animation: ee-pulse 1.8s ease-in-out infinite;
  }
  .ee-dot.idle {
    background-color: var(--color-hairline-strong);
    animation: none;
  }
  @keyframes ee-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(33, 167, 138, 0.4);
    }
    50% {
      box-shadow: 0 0 0 4px rgba(33, 167, 138, 0);
    }
  }

  /* the per-tool example, rendered as a faint watermark; lifts a hair on hover
     for a quiet "come closer" cue (hover reaches the wrapper through the
     pointer-events:none overlay) */
  .ee-ghost {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-hairline-strong);
    white-space: pre;
    opacity: 0.7;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .editor-wrapper.is-empty:hover .ee-ghost {
    opacity: 1;
    transform: translateY(-1px);
  }
</style>
