---
/**
 * DragDropZone — Accessible file drop target.
 *
 * Supports:
 *   - Drag-and-drop file upload
 *   - Click-to-browse keyboard/mouse file selection
 *   - Accept attribute to filter file types
 *   - Custom event "file-dropped" with { file, text } payload
 *   - Visual feedback on drag over
 *
 * Accessibility:
 *   - Hidden file input with proper label
 *   - Keyboard accessible (tab to focus, Enter/Space to browse)
 *   - Screen reader announcements via aria-live
 *   - Role="button" on the drop zone for assistive tech
 */

interface Props {
  /** Unique element ID */
  id: string;
  /** Accepted file extensions (e.g. ".json,.csv") */
  accept?: string;
  /** Accessible label for the drop zone */
  label?: string;
}

const { id, accept = ".json, .csv", label = "Upload file" } = Astro.props;

const dropZoneId = id + "-dropzone";
const fileInputId = id + "-file-input";
const statusId = id + "-status";
---

<div
  class="drag-zone"
  id={dropZoneId}
  role="button"
  tabindex="0"
  aria-label={label}
  aria-describedby={statusId}
  data-drop-id={id}
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="drag-icon"
    aria-hidden="true"
  >
    <path
      d="M12 16V8M12 8l-3 3M12 8l3 3M4 17v1a2 2 0 002 2h12a2 2 0 002-2v-1"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <p class="caption drag-text">
    Drag &amp; drop file here or <span class="browse-link">browse</span>
  </p>
  <input
    type="file"
    id={fileInputId}
    accept={accept}
    class="file-input-hidden"
    aria-hidden="true"
    tabindex="-1"
  />
  <div id={statusId} class="sr-only" aria-live="polite" role="status"></div>
</div>

<script>
  (function () {
    var roots = document.querySelectorAll("[data-drop-id]");
    for (var ri = 0; ri < roots.length; ri++) {
      (function () {
        var container = roots[ri];
        var dropId = container.getAttribute("data-drop-id");
        if (!dropId) return;

        var dropZone = document.getElementById(dropId + "-dropzone");
        var fileInput = document.getElementById(dropId + "-file-input");
        var statusEl = document.getElementById(dropId + "-status");
        if (!dropZone || !fileInput || !statusEl) return;

        // Guard: already initialized
        if (dropZone.__ddzInitialized) return;
        dropZone.__ddzInitialized = true;

        function announce(msg) {
          statusEl.textContent = msg;
        }

        function readFileAsText(file) {
          return new Promise(function (resolve, reject) {
            var reader = new FileReader();
            reader.onload = function (e) {
              resolve(e.target ? e.target.result || "" : "");
            };
            reader.onerror = function () {
              reject(new Error("Failed to read file"));
            };
            reader.readAsText(file);
          });
        }

        async function handleFile(file) {
          if (!file) return;
          announce("Reading file: " + file.name);

          try {
            var text = await readFileAsText(file);
            announce(
              "File loaded: " + file.name + " (" + text.length.toLocaleString() + " characters)",
            );

            dropZone.dispatchEvent(
              new CustomEvent("file-dropped", {
                bubbles: true,
                detail: { file: file, text: text, name: file.name, size: file.size },
              }),
            );
          } catch (err) {
            announce("Failed to read file. Please try again.");
          }
        }

        dropZone.addEventListener("click", function () {
          fileInput.click();
        });

        dropZone.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            fileInput.click();
          }
        });

        fileInput.addEventListener("change", function () {
          var file = fileInput.files ? fileInput.files[0] : null;
          handleFile(file);
          fileInput.value = "";
        });

        dropZone.addEventListener("dragover", function (e) {
          e.preventDefault();
          dropZone.classList.add("drag-over");
        });

        dropZone.addEventListener("dragleave", function () {
          dropZone.classList.remove("drag-over");
        });

        dropZone.addEventListener("drop", function (e) {
          e.preventDefault();
          dropZone.classList.remove("drag-over");
          var file = e.dataTransfer ? e.dataTransfer.files[0] : null;
          handleFile(file);
        });
      })();
    }
  })();
</script>

<style>
  .drag-zone {
    border: 1px dashed var(--color-hairline-strong);
    border-radius: var(--rounded-sm);
    padding: var(--spacing-md);
    text-align: center;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xxs);
    background-color: var(--color-canvas-soft);
  }

  .drag-zone:hover,
  .drag-zone.drag-over {
    border-color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
  }

  .drag-zone:hover .browse-link {
    text-decoration: underline;
  }

  .drag-zone:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .drag-icon {
    color: var(--color-mute);
  }

  .drag-text {
    color: var(--color-body);
    margin: 0;
  }

  .browse-link {
    color: var(--color-accent);
    font-weight: 500;
  }

  .file-input-hidden {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
