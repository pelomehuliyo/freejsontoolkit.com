---
/**
 * ToolHeader — Breadcrumb navigation, H1 title, subtitle, and privacy notice.
 *
 * Placed inside ToolShell's "header" slot.
 *
 * Usage:
 *   <ToolHeader slot="header"
 *     breadcrumbs={[{ label: "Home", href: "/" }, { label: "JSON to CSV" }]}
 *     title="JSON to CSV Converter"
 *     subtitle="Flatten and convert nested JSON arrays into clean CSV tables offline."
 *   />
 */

import Container from "../Container.astro";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  /** Ordered breadcrumb trail (last item is current page, no href) */
  breadcrumbs: Breadcrumb[];
  /** Page H1 */
  title: string;
  /** Page subtitle / description paragraph */
  subtitle: string;
  /** Slot override for custom privacy text (default provided) */
  privacyNotice?: string;
}

const { breadcrumbs, title, subtitle } = Astro.props;
---

<Container size="wide">
  <div class="tool-header">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        {
          breadcrumbs.map((crumb, i) => {
            const isLast = i === breadcrumbs.length - 1;
            return (
              <li class="breadcrumb-item">
                {crumb.href ? (
                  <a href={crumb.href} class="breadcrumb-link">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="breadcrumb-current" aria-current="page">
                    {crumb.label}
                  </span>
                )}
                {!isLast && (
                  <span class="breadcrumb-separator" aria-hidden="true">
                    /
                  </span>
                )}
              </li>
            );
          })
        }
      </ol>
    </nav>

    <!-- Title -->
    <h1 class="display-lg tool-title">{title}</h1>

    <!-- Subtitle -->
    <p class="body-md tool-subtitle">{subtitle}</p>

    <!-- Privacy Notice -->
    <div class="privacy-notice">
      <span class="privacy-icon" aria-hidden="true">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </span>
      <p class="caption">
        <slot name="privacy-notice">
          Your data is processed entirely in your browser and is never uploaded.
        </slot>
      </p>
    </div>
  </div>
</Container>

<style>
  .tool-header {
    margin-bottom: var(--spacing-xl);
    background-color: var(--color-canvas);
  }

  .breadcrumb {
    margin-bottom: var(--spacing-xs);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
  }

  .breadcrumb-link {
    font-size: 12px;
    color: var(--color-mute);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--color-ink);
  }

  .breadcrumb-separator {
    font-size: 11px;
    color: var(--color-hairline-strong);
  }

  .breadcrumb-current {
    font-size: 12px;
    color: var(--color-ink);
    font-weight: 500;
  }

  .tool-title {
    margin-bottom: var(--spacing-xxs);
  }

  .tool-subtitle {
    color: var(--color-body);
    margin: 0 0 var(--spacing-lg) 0;
  }

  .privacy-notice {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .privacy-notice p {
    color: var(--color-body);
    margin: 0;
  }

  .privacy-icon {
    display: inline-flex;
    color: var(--color-mute);
  }

  @media (max-width: 959px) {
    .privacy-notice {
      display: flex;
    }
  }
</style>
