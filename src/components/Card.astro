---
interface Props {
  variant?: 'default' | 'large' | 'soft' | 'featured' | 'flat';
  hoverable?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  variant = 'default',
  hoverable = false,
  class: className = '',
  ...rest
} = Astro.props;
---

<div
  class:list={[
    'card',
    `card-${variant}`,
    { 'card-hoverable': hoverable },
    className
  ]}
  {...rest}
>
  <slot />
</div>

<style>
  .card {
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    border: 1px solid transparent;
    box-sizing: border-box;
  }

  /* Default (card-marketing) */
  .card-default {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-radius: var(--rounded-md);
    padding: var(--spacing-lg);
    border-color: var(--color-hairline);
    box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.04), 
                0px 8px 8px -8px rgba(0, 0, 0, 0.04);
  }

  /* Large (card-marketing-large) */
  .card-large {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-xl);
    border-color: var(--color-hairline);
    box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.04), 
                0px 8px 16px -4px rgba(0, 0, 0, 0.04);
  }

  /* Soft (card-soft) */
  .card-soft {
    background-color: var(--color-canvas-soft);
    color: var(--color-ink);
    border-radius: var(--rounded-md);
    padding: var(--spacing-lg);
    border-color: var(--color-hairline);
  }

  /* Featured (pricing-card-featured) */
  .card-featured {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--rounded-lg);
    padding: var(--spacing-xl);
    border-color: var(--color-primary);
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15);
  }

  /* Flat */
  .card-flat {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border-radius: var(--rounded-md);
    padding: var(--spacing-lg);
    border-color: var(--color-hairline);
  }

  /* Hoverable States */
  .card-hoverable.card-default:hover,
  .card-hoverable.card-large:hover,
  .card-hoverable.card-flat:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.04), 
                0px 12px 24px -4px rgba(0, 0, 0, 0.06);
  }

  .card-hoverable.card-soft:hover {
    background-color: var(--color-canvas-soft-2);
    border-color: var(--color-hairline-strong);
  }

  .card-hoverable.card-featured:hover {
    transform: translateY(-2px);
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.25);
  }
</style>
