---
import Container from "./Container.astro";
import { availableTools } from "../lib/tools/registry";

// Tools column is generated from the registry: live tools as links, plus a
// "browse all" entry. The "coming soon" pipeline lives on /tools, not as dead
// footer links. As tools ship, this column fills itself — zero hand-editing.
const toolLinks = [
  ...availableTools.map((t) => ({ label: t.name, href: t.href as string })),
  { label: "Browse all tools →", href: "/tools" },
];

const footerSections = [
  { title: "Tools", links: toolLinks },
  {
    title: "Legal",
    links: [
      { label: "About", href: "/about" },
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms & Conditions", href: "/terms" },
      { label: "Disclaimer", href: "/disclaimer" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "GitHub Repository", href: "https://github.com/pelomehuliyo/freejsontoolkit.com" },
      { label: "Design Sandbox", href: "/sandbox" },
    ],
  },
];
---

<footer class="footer">
  <Container size="wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <img
            src="/favicon-96x96.png"
            alt="Free JSON Toolkit Logo"
            class="logo-icon"
            width="30"
            height="30"
          />
          <span>JSON Toolkit</span>
        </div>
        <p class="footer-tagline body-sm">
          A minimalist suite of offline-first developer utilities.
        </p>
        <p class="footer-disclaimer caption">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="footer-lock-icon"
            style="display: inline-block; vertical-align: text-bottom; margin-right: 4px;"
            ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path
              d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
          >Your privacy is priority. All processing is executed 100% locally inside your browser
          sandbox. No telemetry, no logs, no servers.
        </p>
      </div>

      <div class="footer-nav-groups">
        {
          footerSections.map((section) => (
            <div class="footer-col">
              <h3 class="footer-title">{section.title}</h3>
              <ul class="footer-links">
                {section.links.map((link) => (
                  <li>
                    <a href={link.href} class="footer-link">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} freejsontoolkit.com. All rights reserved.
      </p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background-color: var(--color-canvas);
    color: var(--color-body);
    border-top: 1px solid var(--color-hairline);
    padding: var(--spacing-4xl) 0 var(--spacing-2xl);
    box-sizing: border-box;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  .footer-brand {
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .footer-logo .logo-icon {
    height: 30px;
    width: auto;
    display: block;
  }

  @media (max-width: 959px) {
    .footer-logo .logo-icon {
      height: 26px;
    }
  }

  .footer-tagline {
    margin: 0;
    color: var(--color-body);
  }

  .footer-disclaimer {
    margin: 0;
    color: var(--color-mute);
    line-height: 1.5;
  }

  .footer-nav-groups {
    display: flex;
    gap: var(--spacing-3xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    min-width: 140px;
  }

  .footer-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-ink);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-hairline);
  }

  .footer-copyright {
    font-size: 12px;
    color: var(--color-mute);
    margin: 0;
  }

  @media (max-width: 959px) {
    .footer-grid {
      flex-direction: column;
      gap: var(--spacing-xl);
    }
  }

  @media (max-width: 600px) {
    .footer-nav-groups {
      flex-direction: column;
      gap: var(--spacing-xl);
    }
  }
</style>
